@page "/two-way"
@rendermode InteractiveServer

<h3>Exemplo TwoWay DataBinding</h3>

<p><b>O nome será alterado quando o input perder o foco</b></p>

<input type="text" @bind="nome" />
<p style="font-size: 40px;"><b>Nome digitado: @nome</b></p>

@code {
	private string nome = "Maria";
	private void TrocarNome()
	{
		nome = "João";
	}
}

