@page "/formulario3-comvalidacao"
@rendermode InteractiveServer

<h3>Registo de Alunos(Validação)</h3>

<EditForm Model="@aluno" OnValidSubmit="EnviarFormularioValido">

	<DataAnnotationsValidator />

	<div class="form-group">
		<label for="nome">Nome:</label>
		<InputText id="nome" @bind-Value="aluno.Nome" class="form-control" />
		<ValidationMessage For="@(() => aluno.Nome)" />
	</div>
	<div class="form-group">
		<label for="email">Email:</label>
		<InputText id="email" @bind-Value="aluno.Email" class="form-control" />
		<ValidationMessage For="@(() => aluno.Email)" />
	</div>
	<div class="form-group">
		<label for="idade">Idade:</label>
		<InputNumber id="idade" @bind-Value="aluno.Idade" class="form-control" />
		<ValidationMessage For="@(() => aluno.Idade)" />
	</div>

	@*<div class="from-group">
		<label for="sexo">Sexo:</label>
		<InputSelect id="sexo" @bind-Value="aluno.Sexo" class="form-select">
			<option value="">Selecione...</option>
			<option value="M">Masculino</option>
			<option value="F">Feminino</option>
		</InputSelect>
		<ValidationMessage For="@(() => aluno.Sexo)" />
	</div>*@

	<div class="from-group mt-3">
		<label>Sexo:</label>

		<InputRadioGroup @bind-Value="aluno.Sexo" class="d-flex flex-column">
			<label class="form-check">
				<InputRadio class="form-check-input" Value="@("M")" /> <span class="form-check-label">Masculino</span>
			</label>
			<label class="form-check">
				<InputRadio class="form-check-input" Value="@("F")" /> <span class="form-check-label">Feminino</span>
			</label>
		</InputRadioGroup>
	</div>

	<div class="form-group">
		<label for="matricula">Matricula:</label>
		<InputDate id="matricula" @bind-Value="aluno.Matricula" class="form-control"/>
		<ValidationMessage For="@(() => aluno.Matricula)" />
	</div>

	<div class="form-group">
		<label for="mensalidade">Mensalidade:</label>
		<InputNumber id="mensalidade" @bind-Value="aluno.Mensalidade" class="form-control" />
		<ValidationMessage For="@(() => aluno.Mensalidade)" />
	</div>

	<div class="form-group">
		<label>
			<InputCheckbox id="ativo" @bind-Value="aluno.Ativo"/> Ativo
		</label>
		
	</div>

	<div class="mt-2">
		<input type="submit" value="Enviar" class="btn btn-primary" />
		<button type="button" class="btn btn-secondary" @onclick="LimparFormulario">Limpar</button>
	</div>

</EditForm>

@code {
	Aluno aluno = new();

	private void Enviar(EditContext context)
	{
		if (context.Validate())
		{
			Console.WriteLine($"Nome: {aluno.Nome} - Email: {aluno.Email} - Idade: {aluno.Idade}");
		}
		else
		{
			Console.WriteLine("Formulário inválido!");
		}
	}
	private void EnviarFormularioValido()
	{
		Console.WriteLine("Formulário válido!");
	}
	private void LimparFormulario()
	{
		aluno = new();
	}
}
