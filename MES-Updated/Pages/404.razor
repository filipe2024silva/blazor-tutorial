@page "/404"
@layout NoLayout
@inject NavigationManager NavigationManager
@inject Utils utils
<!-- Main -->
<div id="main">
    <div class="inner">

        <div class="login" style="@btheme">
            <div class="login-box" style="@ftheme">
                <div class="row">
                    <div class="6u 6u(medium) 12u$(small)" style="margin-bottom:1em">
                        <img src="images/mesicon.jpg" alt="" style="width:60%;height:auto">
                        <div class="row justify-content-center">
                            <div>
                                <h3 style="margin-bottom:10px">F10</h3>
                                <h5>GESTÃO DA FÁBRICA</h5>
                            </div>
                        </div>
                    </div>
                    <div class="6u 6u(medium) 12u$(small)">
                        <h3 class="font-weight-bold" style="margin-bottom:10px;width:20em">Funcionalidade em desenvolvimento</h3>
                        <p style="width:18em;margin-top:1em;">Logo que esta funcionalidade esteja disponível serão informados com todos os detalhes da sua utilização.</p>
                        <button @onclick="@(()=> { NavigationManager.NavigateTo("/"); })">Voltar</button>
                    </div>
                </div>
            </div>
            <p style="margin-left:auto;margin-right:auto;margin-top:10px;font-size: 12px;">Powered by <a href="http://www.fdecimal.com" target="_blank"> Formula Decimal</a></p>
        </div>

    </div>
</div>


@code {
    string btheme = "";
    string ftheme = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (utils.DarkTheme == true)
        {
            btheme = "background-color: #1a1a1a; color: white;";
            ftheme = "background-color: #272727; color: white;";
        }
        else
        {
            btheme = "";
            ftheme = "";
        }
        StateHasChanged();
        base.OnAfterRender(firstRender);
    }

}
