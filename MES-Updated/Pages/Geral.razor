    private async Task Fala(string msg)
    {
        _dbContextMES.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        try
        {
            var qq = _dbContextMES.Settings.FirstOrDefault(x => x.userid == who.id && x.setting == "sound");
            if (qq != null)
            {
                if (Convert.ToBoolean(qq.result) == true)
                {
                    await JSRuntime.InvokeVoidAsync("txtSpeech", msg);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("txtSpeech", msg);
            }
        }
        catch (Exception)
        {
        }
    }


