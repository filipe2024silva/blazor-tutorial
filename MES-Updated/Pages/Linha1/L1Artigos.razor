@page "/linha1/artigos"
@using System.Diagnostics
@using System.Globalization
@using Microsoft.Data.SqlClient

@inject NavigationManager NavigationManager
@inject Utils utils

<div id="main">
	<div class="inner">

		@if (dbchecked == false)
		{
			<div class="row uniform" style="margin-top:20px">
				<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
					<div class="card text-dark bg-light">
						<div class="card-body">
							@if (dbcheckedoff == false)
							{
								<div>
									<div class="bounceball"></div>
									<div class="bounceballtext">A verificar ligação à base de dados</div>
								</div>
							}
							else
							{
								<h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
								<p style="margin:0;">Operações recomendadas:</p>
								<ul>
									<li>Verifique se a linha se encontra em funcionamento</li>
									<li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
									<li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
								</ul>
								<div class="row" style="margin-top:1em">
									<div class="12u$" style="display: flex;justify-content:flex-start;">
										<button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
										<a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			@if (utils.CanAccess("ATL1") == true)
			{

				<div class="row">
					<div class="8u 12u$(medium)">
						<h1>LINHA 1 - Artigos</h1>
					</div>
					<div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
						<button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
						<button class="noprint" @onclick="PrintContent" title="Imprimir"><i class="icon style1 fa-print"></i></button>
						<button @onclick="@(() =>{ SearchData(); })" title="Atualizar"><i class="icon style1 fa-refresh"></i></button>
						<button @onclick="@(()=> { PopupNewArtigo = true; })" title="Inserir Artigo"><i class="icon style1 fa-plus"></i></button>
					</div>
				</div>

				<div class="row uniform">

					<SfTab @bind-SelectedItem="@selectedTab">
						<TabEvents Selected="@OnTabSelected"></TabEvents>
						<TabItems>
							<TabItem>
								<ChildContent>
									<TabHeader Text="Ativos"></TabHeader>
								</ChildContent>
							</TabItem>
							<TabItem>
								<ChildContent>
									<TabHeader Text="Inativos"></TabHeader>
								</ChildContent>
							</TabItem>
						</TabItems>
					</SfTab>
					@*TABELA*@
					<SfGrid @ref="@Grid" DataSource="@ArtigosToShow" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowPaging="true">
						<GridPageSettings PageSize="20" />
						<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
						<GridColumns>
							<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
								<Template>
									@{
										var whois = (context as pulsar.sv.data.Material);
										<div style="display: flex; justify-content: space-around;">
											<a href="@($"/linha1/artigos/detalhes/{whois.Id}")" style="align-self: center;" class="icon style1 fa-edit"><span class="label">Editar</span></a>
											<p @onclick="@(()=> { seleArtigo.Id = whois.Id; OpenPopupCopy = true; seleArtigo.Referencia = ""; seleArtigo.Designacao = ""; })" class="icon style1 fa-copy" style="margin:0.3em;cursor:pointer"><span class="label">Copiar</span></p>
										</div>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="Id" HeaderText="ID"></GridColumn>
							<GridColumn Field="Referencia" HeaderText="Referencia"></GridColumn>
							<GridColumn Field="Designacao" HeaderText="Nome do Artigo"></GridColumn>
							<GridColumn Field="Opcao5" HeaderText="Cliente"></GridColumn>
							<GridColumn Field="Obs" HeaderText="Observações"></GridColumn>
							<GridColumn Field="PecasCarga" HeaderText="Carga"></GridColumn>
						</GridColumns>
					</SfGrid>

					@if (ArtigosToShow == null || ArtigosToShow.Count == 0)
					{
						<div class="row uniform" style="margin-top:20px">
							<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
								<div class="card text-dark bg-light">
									<div class="card-body">
										<p style="margin:0;">Sem artigos @(selectedTab == 0 ? "ativos" : "inativos") registados.</p>
									</div>
								</div>
							</div>
						</div>
					}
				</div>

				@*Adicionar*@
				<SfDialog Width="auto" Height="auto" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="PopupNewArtigo">
					<DialogTemplates>
						<Header>Adicionar Artigo</Header>
						<Content>
							<SfTab>
								<TabItems>

									<TabItem>
										<ChildContent>
											<TabHeader Text="IDENTIFICAÇÃO DO ARTIGO"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:400px;overflow:auto">
												<div class="6u 12u$(medium)">
													<div class="centercontent">
														<img src="@picture(seleArtigo.Imagem)" style="width:100%; height:180px;object-fit:contain;" />
														<i @onclick="@(() => { seleArtigo.Imagem = null; })" class="icon style1 fa-remove smallbot" style="flex-direction: unset;"></i>
													</div>
													<div class="centercontent" style="margin-top:1em;margin-bottom:1em">
														<SfUploader @ref="img" AllowMultiple="false" AllowedExtensions=".png, .gif, .jpeg, .jpg">
															<UploaderEvents ValueChange="OnChange" OnRemove="onRemove"></UploaderEvents>
														</SfUploader>
													</div>
												</div>
												<div class="6u 12u$(medium)">

													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Código</p>
														<SfTextBox Multiline="false" @bind-Value="@seleArtigo.Referencia" style="margin-left:10px;padding:0"></SfTextBox>
													</div>

													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Nome do Artigo</p>
														<SfTextBox Multiline="false" @bind-Value="@seleArtigo.Designacao" style="margin-left:10px;padding:0"></SfTextBox>
													</div>

													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Cliente</p>
														<SfComboBox TValue="string" @bind-Value="@seleArtigo.Opcao5" Placeholder="Selecionar Cliente" TItem="TItem" DataSource="@DataSource" AllowCustom="true" AllowFiltering="true">
															<ComboBoxFieldSettings Text="Name" Value="Name"></ComboBoxFieldSettings>
															<ComboBoxEvents TValue="string" TItem="TItem"></ComboBoxEvents>
															<ComboBoxTemplates TItem="TItem">
																<NoRecordsTemplate>
																	<div>
																		<div id="nodata">Cliente não encontrado na lista.</div>
																	</div>
																</NoRecordsTemplate>
															</ComboBoxTemplates>
														</SfComboBox>

													</div>

													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Bloquear</p>
														<SfSwitch @bind-Checked="@seleArtigo.Opcao8"></SfSwitch>
													</div>

												</div>
											</div>
										</ContentTemplate>
									</TabItem>

									<TabItem>
										<ChildContent>
											<TabHeader Text="CARACTERÍSTICAS"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<SfGrid @ref="@GridCaracteristicas" DataSource="@listaTemporaria" Width="1000px" AllowFiltering="false" AllowSorting="true" AllowGrouping="false">
												<GridColumns>
													<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
														<Template>
															@{
																var whois = (context as pulsar.sv.data.MaterialCaracteristica);
																<div style="display: flex; justify-content: space-between;">
																	<a @onclick="@(()=> { Remove_Caracteristica(whois.IdCaracteristica, 0); })" class="icon style1 fa-close" style="margin-right:1em;cursor:pointer"><span class="label">Eliminar</span></a>
																</div>
															}
														</Template>
													</GridColumn>

													<GridColumn Field=@nameof(pulsar.sv.data.MaterialCaracteristica.Caracteristica) HeaderText="Caracteristica" Width="200"></GridColumn>
													<GridColumn Field=@nameof(pulsar.sv.data.MaterialCaracteristica.Valor) HeaderText="Valor" Width="200"></GridColumn>
													<GridColumn Field=@nameof(pulsar.sv.data.MaterialCaracteristica.Unidade) HeaderText="Unidade" Width="200"></GridColumn>
													<GridColumn Field=@nameof(pulsar.sv.data.MaterialCaracteristica.Obs) HeaderText="Observações" Width="200"></GridColumn>
												</GridColumns>
											</SfGrid>
											<SfButton class="button special pull-left" @onclick="@(()=> { PopupNewCaracteristica = true; })">Adicionar</SfButton>
										</ContentTemplate>
									</TabItem>

									<TabItem>
										<ChildContent>
											<TabHeader Text="OPERAÇÃO / GAMA OPERATÓRIA"></TabHeader>
										</ChildContent>
										<ContentTemplate>

											<div class="12u 12u$(medium)" style="height:auto; width:100%; display: flex;justify-content:space-between;flex-direction:column">

												<div class="table-wrapper" style="margin:1em;">
													<table>
														<tbody>
															<tr style="border:0px;background-color:#fff">
																<td>Tratamento</td>
																<td>
																	<SfDropDownList Value="@seleArtigo.IdTratamento" TValue="int" TItem="pulsar.sv.data.Receita" DataSource="@Tratamentos" Width="100%">
																		<DropDownListTemplates TItem="pulsar.sv.data.Receita">
																			<ItemTemplate>
																				<div class="name" title="@((context as pulsar.sv.data.Receita).Nome)"> @((context as pulsar.sv.data.Receita).Nome) </div>
																			</ItemTemplate>
																		</DropDownListTemplates>
																		<DropDownListEvents OnValueSelect="@SeleTratamentos_SelectionChanged" TValue="int" TItem="pulsar.sv.data.Receita"></DropDownListEvents>
																		<DropDownListFieldSettings Value="Id" Text="Nome"></DropDownListFieldSettings>
																	</SfDropDownList>
																</td>
															</tr>

															<tr style="border:0px;background-color:#fff;">

																<td>Observações</td>
																<td><SfTextBox Multiline="false" @bind-Value="@seleArtigo.Obs"></SfTextBox> </td>
															</tr>
														</tbody>
													</table>
												</div>

												<div class="table-wrapper" style="margin:1em;">
													<table>
														<thead>
															<tr>
															</tr>
														</thead>
														<tbody>

															<tr style="border:0px;background-color:#fff">
																<td>Peças por Barramento</td>
																<td>
																	<SfNumericTextBox TValue="int" @bind-Value="@seleArtigo.PecasCarga" Width="42%" Min="0" Max="130"></SfNumericTextBox>
																</td>
															</tr>

														</tbody>
													</table>
												</div>

												@if (utils.CanAccess("ATLA1") == false)
												{
													@if (RenderComponent)
													{
														<div class="table-wrapper" style="margin:1em;">
															<table>
																<thead>
																	<tr>
																		<th>ZINCO</th>
																		<SfCheckBox Label="Nenhum" Checked="true" LabelPosition="Syncfusion.Blazor.Buttons.LabelPosition.After"></SfCheckBox>
																	</tr>
																</thead>
															</table>
														</div>
													}
												}

											</div>


										</ContentTemplate>
									</TabItem>

									@if (utils.CanAccess("ATLA1") == true)
									{
										<TabItem>
											<ChildContent>
												<TabHeader Text="TRATAMENTO"></TabHeader>
											</ChildContent>
											<ContentTemplate>

												<SfTab>
													<TabItems>
														<TabItem>
															<ChildContent>
																<TabHeader Text="Tempos"></TabHeader>
															</ChildContent>
															<ContentTemplate>

																@foreach (ReceitaStepsDTO t in listaTempos.Where(o => !TinasNotShowList.Contains(o.Num.Value)))
																{

																	<section style="margin-top:2em">
																		<div class="row uniform">
																			<div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
																				<div class="kpi2">
																					<div class="kpi2__inside">
																						<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																						<div class="kpi2__text">
																							<div class="kpi2__title">@t.Designacao</div>
																							<div class="kpi2__subtitle">Designação</div>
																						</div>
																					</div>
																				</div>
																			</div>

																			<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
																				<div class="kpi2">
																					<div class="kpi2__inside">
																						<i style="background-color: white;" class="kpi2__icon fa text-light">TP</i>
																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1" Width="42%" Enabled="false" style="Height: 30px;"></SfMaskedTextBox></div>
																							<div class="kpi2__subtitle">Tempo Permanência</div>
																						</div>
																					</div>
																				</div>
																			</div>

																			<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
																				<div class="kpi2">
																					<div class="kpi2__inside">
																						<i style="background-color: white;" class="kpi2__icon fa text-light">TE</i>
																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T2" Width="42%" Enabled="false" style="Height: 30px;"></SfMaskedTextBox></div>
																							<div class="kpi2__subtitle">Tempo Escorrimento</div>
																						</div>
																					</div>
																				</div>
																			</div>

																		</div>
																	</section>
																}

															</ContentTemplate>
														</TabItem>

														<TabItem>
															<ChildContent>
																<TabHeader Text="Retificadores"></TabHeader>
															</ChildContent>
															<ContentTemplate>

																@foreach (ReceitaStepsDTO t in listaTempos.Where(o => TinasRectificadorList.Contains(o.Num.Value)))
																{

																	<section style="margin-top:2em">
																		<div class="row uniform">
																			<div class="12u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
																				<div class="kpi2">
																					<div class="kpi2__inside">

																						<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																						<div class="kpi2__text">
																							<div class="kpi2__title">@t.Designacao</div>
																							<div class="kpi2__subtitle">Designação</div>
																						</div>

																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1min" Width="65%" Enabled="false" style="Height: 30px;"></SfMaskedTextBox></div>
																							<div class="kpi2__subtitle">Tempo Aceleração</div>
																						</div>

																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1max" Width="65%" style="Height: 30px;" Enabled="false"></SfMaskedTextBox></div>
																							<div class="kpi2__subtitle">Tempo Desaceleração</div>
																						</div>


																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao5" Width="65%" Min="0" ShowSpinButton=false Enabled="false" style="Height: 30px;"></SfNumericTextBox></div>
																							<div class="kpi2__subtitle">Corrente Total (Amp)</div>
																						</div>

																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao3" Width="65%" Min="0" ShowSpinButton=false Enabled="false" style="Height: 30px;"></SfNumericTextBox></div>
																							<div class="kpi2__subtitle">% Final</div>
																						</div>

																						<div class="kpi2__text">
																							<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2min" Width="65%" Enabled="false" style="Height: 30px;"></SfMaskedTextBox></div>
																							<div class="kpi2__subtitle">Tempo Pausa</div>
																						</div>

																						@if (t.Num == 36 || t.Num == 41)
																						{
																							<div class="kpi2__text">
																								<div class="kpi2__title"><SfNumericTextBox Mask='000:00' @bind-Value="@t.D1" Width="65%" ShowSpinButton=false Enabled="false" Min="0" Max="25" style="Height: 30px;"></SfNumericTextBox></div>
																								<div class="kpi2__subtitle">Tensão Máxima</div>
																							</div>
																						}
																					</div>
																				</div>
																			</div>
																		</div>
																	</section>
																}
															</ContentTemplate>
														</TabItem>
													</TabItems>
												</SfTab>
											</ContentTemplate>
										</TabItem>
									}

								</TabItems>
							</SfTab>
							<SfButton class="button special pull-right" Disabled="@Disabled" @onclick="@(()=> { Add_Artigo(0);  })" style="margin:10px">Guardar</SfButton>
							<SfButton class="button pull-right" Disabled="@Disabled" @onclick="@(()=> { PopupNewArtigo = false; idArtigo = 0; seleArtigo = new pulsar.sv.data.Material() { }; listaTemporaria.Clear(); contador = 0; this.RenderComponent = false; })" style="margin:10px">Cancelar</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>

				@*ADICIONAR CARACTERISTICA*@
				<SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="PopupNewCaracteristica">
					<DialogTemplates>
						<Header>Adicionar Característica</Header>
						<Content>
							<div class="table-wrapper" style="margin:1em;">
								<table>
									<tbody>
										<tr style="border:0px;background-color:#fff">
											<td>Caracteristica</td>
											<td>
												<SfDropDownList Value="@seleCaracteristica.Caracteristica" TValue="string" TItem="Recc" DataSource="categoriasCaracteristicas.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
													<DropDownListEvents OnValueSelect="@SelCaracteristicas_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
													<DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
												</SfDropDownList>
											</td>
										</tr>
										<tr style="border:0px;background-color:#fff">
											<td>Valor</td>
											<td><SfTextBox @bind-Value="@seleCaracteristica.Valor"></SfTextBox></td>
										</tr>
										<tr style="border:0px;background-color:#fff">
											<td>Unidade</td>
											<td><SfTextBox @bind-Value="@seleCaracteristica.Unidade" Enabled="false"></SfTextBox></td>
										</tr>
										<tr style="border:0px;background-color:#fff">
											<td>Observações</td>
											<td><SfTextBox @bind-Value="@seleCaracteristica.Obs"></SfTextBox></td>
										</tr>
									</tbody>
								</table>
							</div>
							<SfButton class="button special pull-right" @onclick="@(()=> { Add_Caracteristica(idArtigo);  })" style="margin:10px">Guardar</SfButton>
							<SfButton class="button pull-right" @onclick="@(()=> { PopupNewCaracteristica = false; idCaracteristica = 0; seleCaracteristica = new pulsar.sv.data.MaterialCaracteristica() { }; })" style="margin:10px">Cancelar</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>

				@*COPIAR*@
				<SfDialog Target="#target" Width="450px" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="OpenPopupCopy">
					<DialogTemplates>
						<Header>Copiar Artigo</Header>
						<Content>

							<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:400px;overflow:auto">
								<div style="display: flex; justify-content: left; margin:0.5em">
									<p style="width:8em;margin:0;margin-top:10px;">Código</p>
									<SfTextBox Multiline="false" @bind-Value="@seleArtigo.Referencia" style="margin-left:10px;padding:0"></SfTextBox>
								</div>

								<div style="display: flex; justify-content: left; margin:0.5em">
									<p style="width:8em;margin:0;margin-top:10px;">Nome do Artigo</p>
									<SfTextBox Multiline="false" @bind-Value="@seleArtigo.Designacao" style="margin-left:10px;padding:0"></SfTextBox>
								</div>
							</div>

							<SfButton class="button special pull-right" @onclick="@(()=> { makeCopy(); })" style="margin:10px">Copiar Artigo</SfButton>
							<SfButton class="button pull-right" @onclick="@(()=> { OpenPopupCopy = false; })" style="margin:10px">Cancelar</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>

			}
			else
			{
				<div class="row uniform" style="margin-top:20px">
					<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
						<div class="card text-dark bg-light">
							<div class="card-body">
								<p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
								<a href="/">Voltar</a>
							</div>
						</div>
					</div>
				</div>
			}
		}

		<div class="col-lg-12 control-section toast-default-section">
			<SfToast ID="toast_default" @ref="ToastObj"></SfToast>
		</div>

