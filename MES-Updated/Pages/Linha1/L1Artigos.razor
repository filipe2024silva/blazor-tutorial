	private async Task SearchData()
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		AllArtigos = dl.db.Materiais.ToList();

		var tinasList = from dt in dl.db.Tinas
						select new pulsar.sv.data.Tina { Id = dt.Id, Num = dt.Num, Designacao = dt.Designacao, Tina1 = dt.Tina1, CorBanho = dt.CorBanho };

		Ttinas = tinasList.ToList();

		try
		{
			var alertaOT = dl.db.Configs.First(ot => EF.Functions.Like(ot.Name, "OTEMCURSO"));
			string[] isolaElementos = alertaOT.Value.Split(';');
			string[] nomeArtigos = isolaElementos.Select(o => o.Split('|')[1].Replace(" ", "")).ToArray();

			var resultado = dl.db.Materiais.Where(o => nomeArtigos.Contains(o.Referencia));

			string idShow = string.Join(" e ", resultado.Select(o => o.Id));
			string referenciasShow = string.Join(" e ", resultado.Select(o => o.Referencia));

			if (!string.IsNullOrEmpty(idShow) || !string.IsNullOrEmpty(referenciasShow))
			{
				await this.ToastObj.ShowAsync(new ToastModel
						{
							Timeout = 15000,
							ShowCloseButton = true,
							CssClass = "e-toast-danger",
							ContentTemplate =
	@<div><h2 style='margin:0'><i class='fa fa-warning'></i>Ordem Tratamento</h2><p style='margin-top:1em;margin-bottom:1em'>Atualmente o artigo com designação @referenciasShow encontra-se numa OT em curso. Todas as alterações que fizer no artigo com ID @idShow serão refletidas no processo do mesmo.</p><a style='margin:0' href='/linha1/geral'>Saiba Mais</a></div>
				});
			}
		}
		catch (Exception)
		{
		}
		await FillDataSet(selectedTab);
		StateHasChanged();
		await SpinnerObj.HideAsync();
		dl.Dispose();
	}

