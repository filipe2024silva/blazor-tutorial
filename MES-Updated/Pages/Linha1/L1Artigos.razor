	private bool PopupNewArtigo = false;
	private string ToastContent = "";
	public pulsar.sv.data.Material seleArtigo = new pulsar.sv.data.Material() { };
	public List<pulsar.sv.data.Tina> Ttinas = new List<pulsar.sv.data.Tina>();
	private int idArtigo = 0;
	public byte[] inuser = new byte[1];

	//INTERVALOS & TEMPOS
