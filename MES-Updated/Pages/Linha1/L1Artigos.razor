	/// <summary>
	/// Preencher lista de artigos consoante o tab selecionado.
	/// </summary>
	/// <param name="tabSelected"></param>
	/// <returns></returns>
	private async Task FillDataSet(int tabSelected = 0)
	{
		bool checkAtivo = tabSelected == 0;
		ArtigosToShow = AllArtigos?.Where(o => o.Opcao7 == checkAtivo).ToList() ?? new List<sv.data.Material>();
