	public bool AlteraOpcaoPassivador()
	{
		//Passavidor
		var tempo9Passivador = Convert.ToInt16(listaOperacoesTempos[8].T1.Value.TotalSeconds + listaOperacoesTempos[8].T2.Value.TotalSeconds);

		//Passavidor
		var tempo12Passivador = Convert.ToInt16(listaOperacoesTempos[11].T1.Value.TotalSeconds + listaOperacoesTempos[11].T2.Value.TotalSeconds);

		//Passavidor
		var tempo15Passivador = Convert.ToInt16(listaOperacoesTempos[14].T1.Value.TotalSeconds + listaOperacoesTempos[14].T2.Value.TotalSeconds);

		//Passivador
		var tempo18Passivador = Convert.ToInt16(listaOperacoesTempos[17].T1.Value.TotalSeconds + listaOperacoesTempos[17].T2.Value.TotalSeconds);

		if (tempo9Passivador > 0)
		{
			//Passivador Preto
			seleArtigo.Opcao4 = "3";
		}
		if (tempo12Passivador > 0)
		{
			//Passivador Transparente
			seleArtigo.Opcao4 = "2";
		}
		if (tempo15Passivador > 0)
		{
			//Passivador Irisado
			seleArtigo.Opcao4 = "1";
		}
		if (tempo18Passivador > 0)
		{
			//Passivador Azul
			seleArtigo.Opcao4 = "4";
		}
		if (tempo9Passivador == 0 && tempo12Passivador == 0 && tempo15Passivador == 0 && tempo18Passivador == 0)
		{
			//Sem Passivador
			seleArtigo.Opcao4 = "0";
		}

		return true;
	}

