	private async void SearchCaracteristicas(int idM)
	{
		await SpinnerObj.ShowAsync();
		DataLink_MES dl = new DataLink_MES();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		categoriasCaracteristicas.Clear();
		var dados = await dl.db.Caracteristicas.Where(x => x.Ativo == true).OrderBy(x => x.Caracteristica).ToListAsync();
		foreach (var item in dados)
		{
			categoriasCaracteristicas.Add(new Recc { Id = item.IdCaracteristica, Rec = item.Caracteristica });
		}
		dl.Dispose();

		DataLink_L1 DL1 = new DataLink_L1();
		Caracteristica = DL1.db.MateriaisCaracteristicas.Where(x => x.IdMaterial == idM).ToList();
		DL1.Dispose();

		StateHasChanged();
		await SpinnerObj.HideAsync();
	}

	private async void Add_Caracteristica(int idM)
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();

		if (String.IsNullOrEmpty(seleCaracteristica.Caracteristica) == false)
		{
			if (idM == 0)
			{
				contador++;
				listaTemporaria.Add(new pulsar.sv.data.MaterialCaracteristica() { IdCaracteristica = contador, Caracteristica = seleCaracteristica.Caracteristica, Valor = seleCaracteristica.Valor, Unidade = seleCaracteristica.Unidade, Obs = seleCaracteristica.Obs });
				GridCaracteristicas.Refresh();
			}

			SearchCaracteristicas(idM);
			PopupNewCaracteristica = false;
			seleCaracteristica = new pulsar.sv.data.MaterialCaracteristica() { };
			idM = 0;
		}
		await SpinnerObj.HideAsync();
		StateHasChanged();
		dl.Dispose();
	}

	private async void Remove_Caracteristica(int idC, int idM)
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		var itemToRemove = listaTemporaria.Single(r => r.IdCaracteristica == idC);
		listaTemporaria.Remove(itemToRemove);
		GridCaracteristicas.Refresh();

		await SpinnerObj.HideAsync();
		StateHasChanged();
		dl.Dispose();
	}

