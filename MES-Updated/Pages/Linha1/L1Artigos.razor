	private async void Add_Artigo(int id)
	{
		Disabled = true;
		await SpinnerObj.ShowAsync();

		if (seleArtigo.IdTratamento == 0)
		{
			ToastContent = "Deve ter um tratamento associado.";
			await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			Disabled = false;
			await SpinnerObj.HideAsync();
			return;
		}

		DataLink_L1 dl = new DataLink_L1();

		await using var transaction = await dl.db.Database.BeginTransactionAsync();

		try
		{
			var repetidoOUnao = dl.db.Materiais.Where(x => x.Referencia == seleArtigo.Referencia);
			if (repetidoOUnao.Count() == 0 && String.IsNullOrEmpty(seleArtigo.Designacao) == false)
			{
				if (id == 0)
				{
					//ARTIGO
					var toAdd = (
						new f10.pulsar.sv.data.Material
							{
								Referencia = seleArtigo.Referencia,
								Designacao = seleArtigo.Designacao,
								Opcao5 = seleArtigo.Opcao5,
								Imagem = inuser.Length == 1 ? null : inuser,
								Opcao7 = true,
								Opcao8 = seleArtigo.Opcao8,
								PecasCarga = seleArtigo.PecasCarga,
								Opcao2 = "0", //zinco
								Opcao3 = seleArtigo.Opcao3,
								Opcao4 = seleArtigo.Opcao4, //passivador
								Obs = seleArtigo.Obs,
								IdTratamento = seleArtigo.IdTratamento,
							});

					dl.db.Materiais.Add(toAdd);
					await dl.db.SaveChangesAsync();
					utils.UserLog($"Adicionou o artigo '{seleArtigo.Referencia}'", "DataLink_L1");

					foreach (pulsar.sv.data.MaterialCaracteristica c in listaTemporaria)
					{
						dl.db.MateriaisCaracteristicas.Add(new f10.pulsar.sv.data.MaterialCaracteristica { IdMaterial = toAdd.Id, Caracteristica = c.Caracteristica, Valor = c.Valor, Unidade = c.Unidade, Obs = c.Obs });
						await dl.db.SaveChangesAsync();
						utils.UserLog($"Adicionou a caracteristica '{c.Caracteristica}' ao artigo '{seleArtigo.Designacao}' ", "DataLink_L1");
					}

					if (seleArtigo.IdTratamento != 0 && seleArtigo.IdTratamento != null)
					{
						//TRATAMENTO
						var Trat = dl.db.Receitas.First(x => x.Id == seleArtigo.IdTratamento);
						var toAddTrat = (new f10.pulsar.sv.data.Receita { Nome = Trat.Nome + " (" + toAdd.Id + "*_" + seleArtigo.IdTratamento + "_*" + ")", Dtcreated = DateTime.Now, Whocreated = Trat.Whocreated, IsDeleted = true, IsActive = false });
						dl.db.Receitas.Add(toAddTrat);
						await dl.db.SaveChangesAsync();
						utils.UserLog($"Adicionou o tratamento '{Trat.Nome}' ao Artigo '{seleArtigo.Referencia}'", "DataLink_L1");

						//TRATAMENTO TEMPOS

						var tT = from t in dl.db.ReceitasSteps
									where t.Receitaid == toAdd.IdTratamento
									select new pulsar.sv.data.ReceitasStep { Receitaid = toAddTrat.Id, Tina = t.Tina, T1 = t.T1, T2 = t.T2, Opcao3 = t.Opcao3, T1min = t.T1min, T1max = t.T1max, T2min = t.T2min, Opcao4 = t.Opcao4, Opcao5 = t.Opcao5, Lm = t.Lm, Sm = t.Sm };
						listaOperacoesTempos = await tT.ToListAsync();

						var listTemp = new List<pulsar.sv.data.ReceitasStep>();

						if (listaOperacoesTempos != null && listaOperacoesTempos.Count > 0)
						{
							foreach (pulsar.sv.data.ReceitasStep t in listaOperacoesTempos)
							{
								var toAddArtCara = (new f10.pulsar.sv.data.ReceitasStep { Receitaid = toAddTrat.Id, Tina = t.Tina, T1 = t.T1, T2 = t.T2, Opcao3 = t.Opcao3, T1min = t.T1min, T1max = t.T1max, T2min = t.T2min, Opcao4 = t.Opcao4, Opcao5 = t.Opcao5, Lm = t.Lm, Sm = t.Sm });
								listTemp.Add(toAddArtCara);
							}
							await dl.db.ReceitasSteps.AddRangeAsync(listTemp.OrderBy(o => o.Tina));
							await dl.db.SaveChangesAsync();
						}

						//Verificar Tempos Passivadores
						var tempos = dl.db.ReceitasSteps.Where(x => x.Receitaid == seleArtigo.IdTratamento);
						listaOperacoesTempos = await tempos.ToListAsync();

						AlteraOpcaoPassivador();

						dl.db.Materiais.First(x => x.Id == toAdd.Id).IdTratamento = toAddTrat.Id;
						dl.db.Materiais.First(x => x.Id == toAdd.Id).Opcao4 = seleArtigo.Opcao4;
						utils.UserLog($"O tratamento '{seleArtigo.IdTratamento}' ficou associado ao Artigo '{seleArtigo.Referencia}'", "DataLink_L1");
						await dl.db.SaveChangesAsync();

					}

				}

				await transaction.CommitAsync();

				ToastContent = "Artigo criado com sucesso.";
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Sucesso", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-success" });

				listaTemporaria.Clear();
				contador = 0;
				//CorrenteTotal = 0;
				PopupNewArtigo = false;
				seleArtigo = new pulsar.sv.data.Material() { };
				idArtigo = 0;
				await SearchData();
			}
			else
			{
				ToastContent = "Verifique se tem os campos preenchidos corretamente!";
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			}
		}
		catch (Exception)
		{
			ToastContent = "Erro na criação do novo artigo, por favor tente novamente.";
			await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			//o rollback está dentro de um try para que a aplicação não "reinicie" se houver erro por falha de conexão
			try
			{
				await transaction.RollbackAsync();
			}
			catch (Exception)
			{
			}
		}
		finally
		{
			Disabled = false;
			this.RenderComponent = false;
			await SpinnerObj.HideAsync();
			StateHasChanged();
			dl.Dispose();
		}

	}

	//COPIAR
	private bool OpenPopupCopy = false;

	private async void makeCopy()
	{
		Disabled = true;
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();

		await using var transaction = await dl.db.Database.BeginTransactionAsync();

		try
		{
			sv.data.Receita receita = new sv.data.Receita();

			var repetidoOUnao = dl.db.Materiais.Where(x => x.Referencia == seleArtigo.Referencia);

			if (repetidoOUnao.Count() == 0 && String.IsNullOrEmpty(seleArtigo.Referencia) == false)
			{
				var artigo = dl.db.Materiais.First(x => x.Id == seleArtigo.Id);
				var antigoID = artigo.Id;

				//ID TRATAMENTO
				if (artigo.IdTratamento != 0)
				{
					receita = dl.db.Receitas.First(x => x.Id == artigo.IdTratamento);
					receita.Id = 0;
					receita.Dtcreated = DateTime.Now;
					receita.Whocreated = Convert.ToInt16(who.id);
					dl.db.Receitas.Add(receita);
					await dl.db.SaveChangesAsync();
					utils.UserLog($"Copiou a Receita '{receita.Nome}' para um novo artigo.'", "L1");

					var rst = dl.db.ReceitasSteps.Where(x => x.Receitaid == artigo.IdTratamento).OrderBy(x => x.Tina);

					List<sv.data.ReceitasStep> listTemp = new List<sv.data.ReceitasStep>();

					foreach (var t in rst)
					{
						t.Receitaid = receita.Id;
						t.Stepid = 0;

						listTemp.Add(t);
					}
					await dl.db.AddRangeAsync(listTemp);
					await dl.db.SaveChangesAsync();
				}

				//ARTIGO
				artigo.Id = 0;
				artigo.Referencia = seleArtigo.Referencia;
				artigo.Designacao = seleArtigo.Designacao;
				artigo.IdTratamento = receita.Id;

				dl.db.Materiais.Add(artigo);
				await dl.db.SaveChangesAsync();
				utils.UserLog($"Adicionou um novo artigo copiado:  '{artigo.Referencia}'.'", "DataLink_L1");

				//ARTIGO CARACTERISTICAS
				var caracteristicas = dl.db.MateriaisCaracteristicas.Where(x => x.IdMaterial == antigoID);

				foreach (var t in caracteristicas)
				{
					t.IdMaterial = artigo.Id;
					t.IdCaracteristica = 0;
					dl.db.MateriaisCaracteristicas.Add(t);
				}
				await dl.db.SaveChangesAsync();

				if (artigo.IdTratamento != 0)
				{
					string output = receita.Nome;

					string[] part1 = output.Split("(");
					string[] part2 = part1[1].Split("*");

					string newRecName = $"{part1[0]}({artigo.Id.ToString()}*{part2[1]}*)";

					dl.db.Receitas.First(x => x.Id == artigo.IdTratamento).Nome = newRecName;
					await dl.db.SaveChangesAsync();
					utils.UserLog($"Alterou a Receita para: '{newRecName}'.'", "DataLink_L1");
				}

				await transaction.CommitAsync();

				ToastContent = "Artigo copiado com sucesso.";
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Sucesso", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-success" });

				OpenPopupCopy = false;
				await SearchData();

			}
			else
			{
				ToastContent = "Verifique se tem os campos preenchidos corretamente!";
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			}
		}
		catch (Exception ex)
		{
			ToastContent = "Erro na cópia do novo artigo, por favor tente novamente.";
			await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			//o rollback está dentro de um try para que a aplicação não "reinicie" se houver erro por falha de conexão
			try
			{
				await transaction.RollbackAsync();
			}
			catch (Exception)
			{
			}

		}
		finally
		{
			Disabled = false;
			await SpinnerObj.HideAsync();
			StateHasChanged();
			dl.Dispose();
		}
	}

