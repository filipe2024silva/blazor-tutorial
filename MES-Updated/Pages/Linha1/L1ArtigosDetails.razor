        {
            TItem s = new TItem()
                    {
                        Name = c,
                        Code = c,
                    };
            CustomDataClients.Add(s);
        }

        try
        {
            var alertaOT = dl.db.Configs.First(ot => EF.Functions.Like(ot.Name, "OTEMCURSO"));
            string[] nomeArtigo = alertaOT.Value.Split('|');
