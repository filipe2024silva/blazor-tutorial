    private async void Remove_Artigo(int id)
    {
        Disabled = true;
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        var data = dl.db.Materiais.First(x => x.Id == id);
        var rt = dl.db.ReferenciaTrabalhos.Count(x => x.Referencia == data.Referencia);
        if (rt > 0)
        {
            ToastContent = "Não é possível remover o artigo pois já foi produzido e é necessário manter os dados para histórico! Por favor desative o artigo para ser removido da lista de artigos ativos.";
            StateHasChanged();
            await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
        }
        else
        {
            dl.db.MateriaisCaracteristicas.RemoveRange(dl.db.MateriaisCaracteristicas.Where(x => x.IdMaterial == id));
            if (data.IdTratamento != 0)
            {
                dl.db.Receitas.Remove(dl.db.Receitas.First(m => m.Id == data.IdTratamento));
                dl.db.ReceitasSteps.RemoveRange(dl.db.ReceitasSteps.Where(m => m.Receitaid == data.IdTratamento));
            }

            dl.db.Materiais.Remove(dl.db.Materiais.First(x => x.Id == id));
            await dl.db.SaveChangesAsync();
            utils.UserLog($"Removeu o Artigo '{data.Referencia}'", "DataLink_L1");
            NavigationManager.NavigateTo("/linha1/artigos");
        }

        Disabled = false;
        StateHasChanged();
        dl.Dispose();
    }

