        {
            seleArtigo.Opcao4 = "2";
        }
        //Passivador Irisado
        if (tempo15Passivador > 0)
        {
            seleArtigo.Opcao4 = "1";
        }
        //Passivador Azul
        if (tempo18Passivador > 0)
        {
            seleArtigo.Opcao4 = "4";
        }
        if (tempo9Passivador == 0 && tempo12Passivador == 0 && tempo15Passivador == 0 && tempo18Passivador == 0)
        {
            //Sem Passivador
            seleArtigo.Opcao4 = "0";
        }
        return true;
    }

    public bool AlteraOpcaoZinco()
    {
