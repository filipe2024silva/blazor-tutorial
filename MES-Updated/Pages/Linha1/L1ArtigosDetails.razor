        }
        else
        {
            if (indoc.Length > 1)
            {
                dl.db.Documentos.First(x => x.Id == id).Nome = seldoc.Nome;
                dl.db.Documentos.First(x => x.Id == id).Tipo = seldoc.Tipo;
                dl.db.Documentos.First(x => x.Id == id).Tamanho = indoc.Length;
                dl.db.Documentos.First(x => x.Id == id).Data = (DateTime)seldoc.Data;
                dl.db.Documentos.First(x => x.Id == id).Utilizador = seldoc.Utilizador;
                dl.db.Documentos.First(x => x.Id == id).Descricao = seldoc.Descricao;
                dl.db.Documentos.First(x => x.Id == id).Ficheiro = indoc;
            }
            else
            {
                dl.db.Documentos.First(x => x.Id == id).Descricao = seldoc.Descricao;
            }
            await dl.db.SaveChangesAsync();
            utils.UserLog($"Alterou o documento '{seldoc.Nome}' no Artigo '{seleArtigo.Referencia}'", "DataLink_L1");
