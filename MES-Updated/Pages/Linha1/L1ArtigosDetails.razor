@page "/linha1/artigos/detalhes/{id}"
@using Microsoft.Data.SqlClient

@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Utils utils

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("ATL1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>Detalhes do Artigo - @seleArtigo.Referencia </h1>
                    </div>
                    <div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
                        <button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button class="noprint" onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                        <button @onclick="@(() =>{ GetDB();  })" title="Atualizar"><i class="icon style1 fa-refresh"></i></button>
                        <button @onclick="@(() =>{ PopDelArtigo = true; })" title="Eliminar"><i class="icon style1 fa-trash"></i></button>
                    </div>
                </div>


                <div class="row uniform">
                    <div class="12u">
                        <SfTab>
                            <TabItems>

                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Identificação do Artigo"></TabHeader>
                                    </ChildContent>
                                    <ContentTemplate>
                                        <div class="row uniform" style="margin-top:20px">
                                            <div class="7u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
                                                <div class="row">
                                                    <div class="table-wrapper" style="width:100%">
                                                        <table>
                                                            <tbody>
                                                                <tr>
                                                                    <td>Código</td>
                                                                    <td>@seleArtigo.Referencia</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Nome do Artigo</td>
                                                                    <td><SfTextBox Multiline="false" @bind-Value="@seleArtigo.Designacao" Width="100%" Style="height:30px"></SfTextBox></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Cliente</td>
                                                                    <td>
                                                                        <SfComboBox TValue="string" @bind-Value="@seleArtigo.Opcao5" Placeholder="Selecionar Cliente" Width="100%" TItem="TItem" DataSource="@CustomDataClients" AllowCustom="true" AllowFiltering="true" style="background-color:#F7F7F7;">
                                                                            <ComboBoxFieldSettings Text="Name" Value="Name"></ComboBoxFieldSettings>
                                                                            <ComboBoxEvents TValue="string" TItem="TItem"></ComboBoxEvents>
                                                                            <ComboBoxTemplates TItem="TItem">
                                                                                <NoRecordsTemplate>
                                                                                    <div>
                                                                                        <div id="nodata">Cliente não encontrado na lista.</div>
                                                                                    </div>
                                                                                </NoRecordsTemplate>
                                                                            </ComboBoxTemplates>
                                                                        </SfComboBox>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Ativo</td>
                                                                    <td><SfSwitch @bind-Checked="@seleArtigo.Opcao7"></SfSwitch></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Bloquear</td>
                                                                    <td><SfSwitch @bind-Checked="@seleArtigo.Opcao8"></SfSwitch></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="5u 12u$(medium) align-self-end" style="text-align: center;">
                                                <img src="@picture(seleArtigo.Imagem)" style="width:100%; height:250px;object-fit:contain;" />
                                                <i @onclick="@(() => { seleArtigo.Imagem = null; })" class="icon style1 fa-remove smallbot" style="flex-direction: unset;"></i>

                                                <SfUploader @ref="img" Multiple="false" AllowedExtensions=".png, .gif, .jpeg, .jpg">
                                                    <UploaderEvents ValueChange="OnChange" OnRemove="onRemove"></UploaderEvents>
                                                </SfUploader>
                                            </div>
                                        </div>

                                    </ContentTemplate>
                                </TabItem>

                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Características"></TabHeader>
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid @ref="@Grid_" DataSource="@Caracteristica" Width="100%" AllowFiltering="false" AllowSorting="true" AllowGrouping="false">
                                            <GridColumns>
                                                <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
                                                    <Template>
                                                        @{
                                                            var whois = (context as pulsar.sv.data.MaterialCaracteristica);
                                                            <a @onclick="@(()=> { loadCaracteristica(whois.IdCaracteristica); })" class="icon style1 fa-edit" style="margin-right:1em;cursor:pointer"><span class="label">Editar</span></a>
                                                            <a @onclick="@(()=> { Remove_Caracteristica(whois.IdCaracteristica, whois.IdMaterial); })" class="icon style1 fa-close" style="margin-right:1em;cursor:pointer"><span class="label">Eliminar</span></a>
                                                        }
                                                    </Template>
                                                </GridColumn>
                                                <GridColumn Field="Caracteristica" HeaderText="Caracteristica" Width="200"></GridColumn>
                                                <GridColumn Field="Valor" HeaderText="Valor" Width="200"></GridColumn>
                                                <GridColumn Field="Unidade" HeaderText="Unidade" Width="200"></GridColumn>
                                                <GridColumn Field="Obs" HeaderText="Observações" Width="200"></GridColumn>
                                            </GridColumns>
                                        </SfGrid>
                                        <button @onclick="@(()=> { PopupNewCaracteristica = true; })" title="Adicionar Característica"><i class="icon style1 fa-plus"></i></button>
                                    </ContentTemplate>
                                </TabItem>

                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Operação / Gama Operatória"></TabHeader>
                                    </ChildContent>
                                    <ContentTemplate>
                                        <div class="row uniform" style="margin-top:20px">

                                            <div class="12u 12u$(medium)" style="height:auto; width:100%; display: flex;justify-content:space-between;flex-direction:column">

                                                <div class="table-wrapper" style="margin:1em;">
                                                    <table>
                                                        <tbody>
                                                            <tr style="border:0px;background-color:#fff">
                                                                <td>Tratamento</td>
                                                                <td>
                                                                    <SfDropDownList Value="@seleArtigo.IdTratamento" TValue="int" TItem="pulsar.sv.data.Receita" DataSource="@Tratamentos" Width="100%">
                                                                        <DropDownListEvents OnValueSelect="@SeleTratamentos_SelectionChanged" TValue="int" TItem="pulsar.sv.data.Receita"></DropDownListEvents>
                                                                        <DropDownListFieldSettings Value="Id" Text="Nome"></DropDownListFieldSettings>
                                                                    </SfDropDownList>
                                                                </td>
                                                            </tr>

                                                            <tr style="border:0px;background-color:#fff;">
                                                                <td>Observações</td>
                                                                <td><SfTextBox Multiline="false" @bind-Value="@seleArtigo.Obs"></SfTextBox> </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="table-wrapper" style="margin:1em;">
                                                    <table>
                                                        <thead>
                                                            <tr>
                                                            </tr>
                                                        </thead>
                                                        <tbody>

                                                            <tr style="border:0px;background-color:#fff">
                                                                <td>Peças por Barramento</td>
                                                                <td>
                                                                    <SfNumericTextBox TValue="int" @bind-Value="@seleArtigo.PecasCarga" Min="0" Max="130"></SfNumericTextBox>
                                                                </td>
                                                            </tr>
                                                            <tr style="border:0px;background-color:#fff">
                                                                <td>Área da Peça (dm<sup>2</sup>)</td>
                                                                <td>
                                                                    <SfTextBox TValue="int" @bind-Value="@seleArtigo.Area"  ></SfTextBox>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                @if (utils.CanAccess("ATLA1") == false)
                                                {
                                                    @if (RenderComponent)
                                                    {
                                                        <div class="table-wrapper" style="margin:1em;">
                                                            <table>
                                                                <thead>
                                                                    <tr>
                                                                        <th>ZINCO</th>
                                                                        <div style="margin-bottom:1em">
                                                                            <SfRadioButton Label="Níquel" Name="custom" Value="op1" @bind-Checked="stringChecked" LabelPosition="Syncfusion.Blazor.Buttons.LabelPosition.After" @onchange="onChangeRadio"></SfRadioButton>
                                                                            <SfRadioButton Label="Alcalino" Name="custom" Value="op2" @bind-Checked="stringChecked" LabelPosition="Syncfusion.Blazor.Buttons.LabelPosition.After" @onchange="onChangeRadio"></SfRadioButton>
                                                                            <SfRadioButton Label="Nenhum" Name="custom" Value="op3" @bind-Checked="stringChecked" LabelPosition="Syncfusion.Blazor.Buttons.LabelPosition.After" @onchange="onChangeRadio"></SfRadioButton>
                                                                        </div>
                                                                    </tr>
                                                                </thead>

                                                                <tbody>
                                                                    @{
                                                                        var x = 34;
                                                                        var t = listaTempos.First(t => t.Num == x);

                                                                        if (stringChecked == "op1")
                                                                        {
                                                                            t = listaTempos.First(t => t.Num == 34);
                                                                        }
                                                                        if (stringChecked == "op2")
                                                                        {
                                                                            t = listaTempos.First(t => t.Num == 36);
                                                                        }
                                                                        if (stringChecked != "op3")
                                                                        {
                                                                            <tr style="border:0px;background-color:#fff;">
                                                                                <td>Tempo de Banho (min)</td>
                                                                                <td><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1" Width="42%"></SfMaskedTextBox></td>
                                                                                <td>Tempo Escorrimento</td>
                                                                                <td><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2" Width="42%"></SfMaskedTextBox></td>
                                                                            </tr>

                                                                            <tr style="border:0px;background-color:#fff;">
                                                                                <td>Tempo Aceleração</td>
                                                                                <td><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1min" Width="42%"></SfMaskedTextBox></td>
                                                                                <td>Tempo Desaceleração</td>
                                                                                <td><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1max" Width="42%"></SfMaskedTextBox></td>
                                                                            </tr>

                                                                            <tr style="border:0px;background-color:#fff;">
                                                                                @*<td>Corrente / Peso (Amp/kg)</td>
                                                        <td><SfTextBox @bind-Value="@t.Opcao2" Width="42%" style="Height: 30px;" Blur="@BlurHandler"></SfTextBox></td>*@
                                                                                <td>Corrente (Amp dm2)</td>
                                                                                <td><SfNumericTextBox @bind-Value="@t.Opcao5" Width="42%" Min="0"></SfNumericTextBox></td>
                                                                                <td>% final</td>
                                                                                <td><SfNumericTextBox @bind-Value="@t.Opcao3" Width="42%" Min="0" Max="100"></SfNumericTextBox></td>
                                                                            </tr>

                                                                            <tr style="border:0px;background-color:#fff;">
                                                                                <td>Tempo Espera</td>
                                                                                <td><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2min" Width="42%"></SfMaskedTextBox></td>
                                                                                <td>Tensão Máxima</td>
                                                                                <td><SfNumericTextBox @bind-Value="@t.D1" Width="42%" Min="0" Max="25"></SfNumericTextBox></td>
                                                                            </tr>

                                                                        }
                                                                    }
                                                                </tbody>

                                                            </table>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                        </div>
                                    </ContentTemplate>
                                </TabItem>

                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Documentos"></TabHeader>
                                    </ChildContent>
                                    <ContentTemplate>
                                        <div>
                                            <SfGrid @ref="@GridDocumentos" DataSource="@Documentos" AllowFiltering="false" AllowSorting="false" AllowGrouping="false">
                                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                                <GridColumns>
                                                    <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
                                                        <Template>
                                                            @{
                                                                var whois = (context as Dcs);
                                                                <div style="display: flex; justify-content: space-between;">
                                                                    <p @onclick="@(() => { Download_Document(whois.Id); })" class="icon style1 fa-download" style="margin:0.3em;cursor:pointer"><span class="label">Download Documento</span></p>
                                                                    <p @onclick="@(() => { Edit_Document(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label">Editar</span></p>
                                                                </div>
                                                            }
                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field="Tipo" HeaderText="Tipo" Width="70" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                    <GridColumn Field="Nome" HeaderText="Nome"></GridColumn>
                                                    <GridColumn Field="Data" HeaderText="Data" Format="G" Type="ColumnType.Date" HideAtMedia="(min-width: 700px)" Width="200"></GridColumn>
                                                    <GridColumn Field="Descricao" HeaderText="Descrição" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                    <GridColumn Field="Tamanho" HeaderText="Mb" Type="ColumnType.Number" HideAtMedia="(min-width: 700px)" Width="100"></GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                            <button @onclick="@(()=> { PopupNewDoc = true; })" title="Inserir Documento"><i class="icon style1 fa-plus"></i></button>
                                        </div>
                                    </ContentTemplate>
                                </TabItem>

                                @if (utils.CanAccess("ATLA1") == true)
                                {
                                    <TabItem>
                                        <ChildContent>
                                            <TabHeader Text="Tratamento"></TabHeader>
                                        </ChildContent>
                                        <ContentTemplate>

                                            <SfTab>
                                                <TabItems>
                                                    <TabItem>
                                                        <ChildContent>
                                                            <TabHeader Text="Tempos"></TabHeader>
                                                        </ChildContent>
                                                        <ContentTemplate>

                                                            @foreach (ReceitaStepsDTO t in listaTempos.Where(o => !TinasNotShowList.Contains(o.Num.Value)))
                                                            {
                                                                <section style="margin-top:2em">
                                                                    <div class="row uniform">

                                                                        <div class="12u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between;">

                                                                            <div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
                                                                                <div class="kpi2">
                                                                                    <div class="kpi2__inside">
                                                                                        <i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
                                                                                        <div class="kpi2__text">
                                                                                            <div class="kpi2__title">@t.Designacao</div>
                                                                                            <div class="kpi2__subtitle">Designação</div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <div class="kpi2">
                                                                                <div class="kpi2__inside">
                                                                                    <i style="background-color: white;" class="kpi2__icon fa text-light">TP</i>
                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
                                                                                        <div class="kpi2__subtitle">Tempo Permanência</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <div class="kpi2">
                                                                                <div class="kpi2__inside">
                                                                                    <i style="background-color: white;" class="kpi2__icon fa text-light">TE</i>
                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T2" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
                                                                                        <div class="kpi2__subtitle">Tempo Escorrimento</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                        </div>

                                                                    </div>
                                                                </section>
                                                            }

                                                        </ContentTemplate>
                                                    </TabItem>

                                                    <TabItem>
                                                        <ChildContent>
                                                            <TabHeader Text="Retificadores"></TabHeader>
                                                        </ChildContent>
                                                        <ContentTemplate>

                                                            @foreach (ReceitaStepsDTO t in listaTempos.Where(o => TinasRectificadorList.Contains(o.Num.Value)))
                                                            {
                                                                <section style="margin-top:2em">
                                                                    <div class="row uniform">
                                                                        <div class="12u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
                                                                            <div class="kpi2">
                                                                                <div class="kpi2__inside">

                                                                                    <i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title">@t.Designacao</div>
                                                                                        <div class="kpi2__subtitle">Designação</div>
                                                                                    </div>

                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
                                                                                        <div class="kpi2__subtitle">Tempo Aceleração</div>
                                                                                    </div>

                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1max" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
                                                                                        <div class="kpi2__subtitle">Tempo Desaceleração</div>
                                                                                    </div>


                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao5" Width="65%" Min="0" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
                                                                                        <div class="kpi2__subtitle">Corrente Amp/Kg</div>
                                                                                    </div>

                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao3" Width="65%" Min="0" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
                                                                                        <div class="kpi2__subtitle">% Final</div>
                                                                                    </div>

                                                                                    <div class="kpi2__text">
                                                                                        <div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
                                                                                        <div class="kpi2__subtitle">Tempo Pausa</div>
                                                                                    </div>

                                                                                    @if (t.Num == 34 || t.Num == 36)
                                                                                    {
                                                                                        <div class="kpi2__text">
                                                                                            <div class="kpi2__title"><SfNumericTextBox Mask='000:00' @bind-Value="@t.D1" Width="65%" ShowSpinButton=false Min="0" Max="25" style="Height: 30px;"></SfNumericTextBox></div>
                                                                                            <div class="kpi2__subtitle">Tensão Máxima</div>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </section>
                                                            }

                                                        </ContentTemplate>
                                                    </TabItem>
                                                </TabItems>
                                            </SfTab>

                                        </ContentTemplate>
                                    </TabItem>
                                }
                            </TabItems>
                        </SfTab>
                        <SfButton class="button special pull-right" Disabled="@Disabled" OnClick="@(()=> { Save_Artigo(idArtigo); })" style="margin:10px">Guardar</SfButton>

                    </div>
                </div>

                @*ELIMINAR ARTIGO*@
                <SfDialog Width="400px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopDelArtigo">
                    <DialogTemplates>
                        <Header>Eliminar Artigo</Header>
                        <Content>
                            <p>
                                A eliminação é permanente.<br />
                                Pretende realmente eliminar o Artigo?
                            </p>
                            <SfButton class="button special pull-right" Disabled="@Disabled" @onclick="@(() => { Remove_Artigo(idArtigo); })" style="margin:10px">Sim</SfButton>
                            <SfButton class="button pull-right" Disabled="@Disabled" @onclick="@(() => { PopDelArtigo = false; })" style="margin:10px">Não</SfButton>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ADICIONAR CARACTERISTICA*@
                <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupNewCaracteristica">
                    <DialogTemplates>
                        <Header>Adicionar Característica</Header>
                        <Content>
                            <div class="table-wrapper" style="margin:1em;">
                                <table>
                                    <tbody>
                                        <tr style="border:0px;background-color:#fff">
                                            <td>Caracteristica</td>
                                            <td>
                                                <SfDropDownList Value="@seleCaracteristica.Caracteristica" TValue="string" TItem="Recc" DataSource="categoriasCaracteristicas.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                                    <DropDownListEvents OnValueSelect="@SelCaracteristicas_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                                    <DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
                                                </SfDropDownList>
                                            </td>
                                        </tr>
                                        <tr style="border:0px;background-color:#fff">
                                            <td>Valor</td>
                                            <td><SfTextBox @bind-Value="@seleCaracteristica.Valor"></SfTextBox></td>
                                        </tr>
                                        <tr style="border:0px;background-color:#fff">
                                            <td>Unidade</td>
                                            <td><SfTextBox @bind-Value="@seleCaracteristica.Unidade" Enabled="false"></SfTextBox></td>
                                        </tr>
                                        <tr style="border:0px;background-color:#fff">
                                            <td>Observações</td>
                                            <td><SfTextBox @bind-Value="@seleCaracteristica.Obs"></SfTextBox></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <SfButton class="button special pull-right" @onclick="@(()=> { Add_Caracteristica(idArtigo);  })"
                                      style="margin:10px">Guardar</SfButton>
                            <SfButton class="button pull-right"
                            @onclick="@(()=> { PopupNewCaracteristica = false; idCaracteristica = 0; seleCaracteristica = new pulsar.sv.data.MaterialCaracteristica() { }; })"
                                      style="margin:10px">Cancelar</SfButton>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*EDITAR CARACTERISTICA*@
                <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true"
                @bind-Visible="PopupEditCaracteristica">
                    <DialogTemplates>
                        <Header>Editar Característica</Header>
                        <Content>
                            <div class="table-wrapper" style="margin:1em;">
                                <table>
                                    <tbody>
                                        <tr style="border:0px;background-color:#fff">
