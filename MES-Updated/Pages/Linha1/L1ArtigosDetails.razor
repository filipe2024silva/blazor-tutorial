        {
            var data = dl.db.Receitas.First(x => x.Id == seleArtigo.IdTratamento);
            var output = data.Nome.Substring(data.Nome.IndexOf("*_") + 2, data.Nome.IndexOf("_*") - data.Nome.IndexOf("*_") - 2);

