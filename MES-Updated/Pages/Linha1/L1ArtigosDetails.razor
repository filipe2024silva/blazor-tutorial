    private string toChange = "";
    List<pulsar.sv.data.ReceitasStep> list = new List<pulsar.sv.data.ReceitasStep>() { };

    private async void makeCopy()
    {
        Disabled = true;
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        await using var transaction = await dl.db.Database.BeginTransactionAsync();

        try
        {
            if (toChange.Contains("Tratamento"))
            {
                toChange = toChange.Replace("Tratamento", "");
                var getInfo = dl.db.Materiais.First(x => x.Id == int.Parse(id));

                if (seleArtigo.IdTratamento != 0)
                {
                    var Trat = dl.db.Receitas.First(x => x.Id == int.Parse(toChange));

                    var dlTrat = dl.db.Receitas.First(x => x.Id == getInfo.IdTratamento);
                    dlTrat.Nome = Trat.Nome + " (" + seleArtigo.Id + "*_" + toChange + "_*" + ")";
                    dlTrat.Dtcreated = DateTime.Now;
                    dlTrat.Whocreated = Trat.Whocreated;
                    dlTrat.IsDeleted = true;
                    dlTrat.IsActive = false;
                    await dl.db.SaveChangesAsync();
                    //RECEBE OS DADOS DO ID QUE ESCOLHEU E DE SEGUIDA INSERE
                    dl.db.ReceitasSteps.RemoveRange(dl.db.ReceitasSteps.Where(x => x.Receitaid == getInfo.IdTratamento && (x.Tina < 36 || x.Tina == 40)));
                    await dl.db.SaveChangesAsync();

                    var tT = from t in dl.db.ReceitasSteps
                             where t.Receitaid == int.Parse(toChange) && (t.Tina < 36 || t.Tina == 40)
                             select new pulsar.sv.data.ReceitasStep { Receitaid = dlTrat.Id, Tina = t.Tina, T1 = t.T1, T2 = t.T2, Opcao3 = t.Opcao3, T1min = t.T1min, T1max = t.T1max, T2min = t.T2min, Opcao4 = t.Opcao4, Opcao5 = t.Opcao5, Lm = t.Lm, Sm = t.Sm };
                    list = await tT.ToListAsync();

                    List<pulsar.sv.data.ReceitasStep> listTemp = new();

                    if (list != null && list.Count > 0)
                    {
                        foreach (pulsar.sv.data.ReceitasStep t in list)
                        {
                            if (t.Tina < 36 && t.Tina > 39 || t.Tina != 41 || t.Tina != 42)
                            {
                                var toAddArtCara = (new f10.pulsar.sv.data.ReceitasStep { Receitaid = dlTrat.Id, Tina = t.Tina, T1 = t.T1, T2 = t.T2, Opcao3 = t.Opcao3, T1min = t.T1min, T1max = t.T1max, T2min = t.T2min, Opcao4 = t.Opcao4, Opcao5 = t.Opcao5, Lm = t.Lm, Sm = t.Sm });

                                listTemp.Add(toAddArtCara);
                            }
                        }
                        await dl.db.ReceitasSteps.AddRangeAsync(listTemp);
                        await dl.db.SaveChangesAsync();
                    }

                    //VERIFICA TEMPOS PASSIVADORES
                    if (CalculaTemposPassivadoresZincos() == true)
                    {
                        bool res = AlteraOpcaoPassivador();
                    }

                    utils.UserLog($"Atualizou o tratamento '{getInfo.IdTratamento}' para '{Trat.Id}'", "DataLink_L1");
                    dl.db.Materiais.First(x => x.Id == getInfo.Id).Opcao4 = seleArtigo.Opcao4;
                    await dl.db.SaveChangesAsync();

                    ToastContent = "Tratamento alterado com sucesso!";
                    StateHasChanged();
                    await this.ToastObj.ShowAsync(new ToastModel { Title = "Sucesso", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-success" });
                }
                else
                {
                    var Trat = dl.db.Receitas.First(x => x.Id == int.Parse(toChange));

                    var toAdd = (new f10.pulsar.sv.data.Receita { Nome = Trat.Nome + " (" + seleArtigo.Id + "*_" + toChange + "_*" + ")", Dtcreated = DateTime.Now, Whocreated = Convert.ToInt16(who.id), IsDeleted = true, IsActive = false });
                    dl.db.Receitas.Add(toAdd);
                    await dl.db.SaveChangesAsync();
                    //RECEBE OS DADOS DO ID QUE ESCOLHEU E DE SEGUIDA INSERE
                    list = await dl.db.ReceitasSteps.Where(x => x.Receitaid == int.Parse(toChange)).ToListAsync();

                    List<pulsar.sv.data.ReceitasStep> listTemp = new();

					if (list != null && list.Count > 0)
					{
						foreach (pulsar.sv.data.ReceitasStep t in list)
						{
								var toAddArtCara = (new f10.pulsar.sv.data.ReceitasStep { Receitaid = toAdd.Id, Tina = t.Tina, T1 = t.T1, T2 = t.T2, Opcao3 = t.Opcao3, T1min = t.T1min, T1max = t.T1max, T2min = t.T2min, Opcao4 = t.Opcao4, Opcao5 = t.Opcao5, Lm = t.Lm, Sm = t.Sm });
								listTemp.Add(toAddArtCara);
						}
						await dl.db.ReceitasSteps.AddRangeAsync(listTemp);
						await dl.db.SaveChangesAsync();
					}

                    //VERIFICA TEMPOS PASSIVADORES
                    if (CalculaTemposPassivadoresZincos() == true)
                    {
                        bool res = AlteraOpcaoPassivador();
                    }

                    utils.UserLog($"Criou cópia do tratamento '{Trat.Nome}' no artigo '{seleArtigo.Referencia}'", "DataLink_L1");
                    dl.db.Materiais.First(x => x.Id == getInfo.Id).IdTratamento = toAdd.Id;
                    dl.db.Materiais.First(x => x.Id == getInfo.Id).Opcao4 = seleArtigo.Opcao4;
                    dl.db.Materiais.First(x => x.Id == getInfo.Id).Opcao2 = seleArtigo.Opcao2;
                    await dl.db.SaveChangesAsync();
                    list.Clear();
                }

                await transaction.CommitAsync();

                ToastContent = "Alteração no tratamento do artigo feita com sucesso.";
                await this.ToastObj.ShowAsync(new ToastModel { Title = "Sucesso", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-success" });

                SearchArtigo();
                SearchTempos();
                LoadTratamentos();
            }

        }
        catch (Exception)
        {
            ToastContent = "Erro na alteração no tratamento do artigo, por favor tente novamente.";
            await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
            //o rollback está dentro de um try para que a aplicação não "reinicie" se houver erro por falha de conexão
            try
            {
                await transaction.RollbackAsync();
            }
            catch (Exception)
            {
            }
        }
        finally
        {
            Disabled = false;
            PopUpChange = false;
            toChange = "";
            await SpinnerObj.HideAsync();
            StateHasChanged();
            dl.Dispose();
        }
    }

