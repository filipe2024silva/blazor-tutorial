                });
            }
        }
        catch (Exception)
        {
        }

        StateHasChanged();
        await SpinnerObj.HideAsync();
        dl.Dispose();
    }

    private async void SearchTempos()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        if (seleArtigo.IdTratamento != 0 && seleArtigo.IdTratamento != null)
        {
            var doc = dl.db.Receitas.First(x => x.Id == seleArtigo.IdTratamento);

            listaTempos.Clear();
            var rst = dl.db.ReceitasSteps.Where(x => x.Receitaid == seleArtigo.IdTratamento);
            foreach (pulsar.sv.data.ReceitasStep rs in rst)
            {
                var T1_sec = TimeSpan.FromSeconds(Convert.ToInt32(rs.T1.Value.TotalSeconds));
                var T2_sec = TimeSpan.FromSeconds(Convert.ToInt32(rs.T2.Value.TotalSeconds));
                var T1min_sec = TimeSpan.FromSeconds(Convert.ToInt32(rs.T1min.Value.TotalSeconds));
                var T1max_sec = TimeSpan.FromSeconds(Convert.ToInt32(rs.T1max.Value.TotalSeconds));
                var T2min_sec = TimeSpan.FromSeconds(Convert.ToInt32(rs.T2min.Value.TotalSeconds));

                try
                {
                    ReceitaStepsDTO s = new ReceitaStepsDTO()
                        {
                            Designacao = Ttinas.First(x => x.Num == rs.Tina).Designacao,
                            Num = Convert.ToInt32(rs.Tina),
                            T1 = string.Format("{0:D3}:{1:D2}", (int)T1_sec.TotalMinutes, T1_sec.Seconds),
                            T2 = string.Format("{0:D3}:{1:D2}", (int)T2_sec.TotalMinutes, T2_sec.Seconds),
                            T1min = string.Format("{0:D3}:{1:D2}", (int)T1min_sec.TotalMinutes, T1min_sec.Seconds),
                            T1max = string.Format("{0:D3}:{1:D2}", (int)T1max_sec.TotalMinutes, T1max_sec.Seconds),
                            T2min = string.Format("{0:D3}:{1:D2}", (int)T2min_sec.TotalMinutes, T2min_sec.Seconds),
                            //Opcao2 = rs.Opcao2,
                            Opcao3 = int.Parse(rs.Opcao3),
                            CorBanho = Ttinas.First(x => x.Num == rs.Tina).CorBanho,
                            D1 = float.Parse(rs.Opcao4),
                            Opcao5 = float.Parse(rs.Opcao5.Replace(".",",")),
                            LM = rs.Lm,
                            SM = rs.Sm
                        };
                    listaTempos.Add(s);
                }
                catch (Exception ex)
                {

                }
            }

            listaTempos = listaTempos.OrderBy(x => x.Num).ToList();

            if ((Convert.ToInt32(listaTempos[34].T1.Substring(listaTempos[34].T1.Length - 2, 2)) + Convert.ToInt32(listaTempos[34].T2.Substring(listaTempos[34].T2.Length - 2, 2)) + Convert.ToInt32(listaTempos[34].T1min.Substring(listaTempos[34].T1min.Length - 2, 2)) + Convert.ToInt32(listaTempos[34].T1max.Substring(listaTempos[34].T1max.Length - 2, 2)) + Convert.ToInt32(listaTempos[34].T2min.Substring(listaTempos[34].T2min.Length - 2, 2))) > 0)
            {
                stringChecked = "op1";
            }
            if ((Convert.ToInt32(listaTempos[36].T1.Substring(listaTempos[36].T1.Length - 2, 2)) + Convert.ToInt32(listaTempos[36].T2.Substring(listaTempos[36].T2.Length - 2, 2)) + Convert.ToInt32(listaTempos[36].T1min.Substring(listaTempos[36].T1min.Length - 2, 2)) + Convert.ToInt32(listaTempos[36].T1max.Substring(listaTempos[36].T1max.Length - 2, 2)) + Convert.ToInt32(listaTempos[36].T2min.Substring(listaTempos[36].T2min.Length - 2, 2))) > 0)
