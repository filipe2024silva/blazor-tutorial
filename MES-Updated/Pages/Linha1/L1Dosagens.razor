@page "/linha1/dosagens"
@using System.Globalization

@using f10.pulsar.sv.data
@inject NavigationManager NavigationManager
@inject Utils utils

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("DSL1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 1 - DOSAGENS</h1>
                        @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                    </div>
                    <div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
                        <button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    </div>
                </div>

                <div class="row uniform">
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfButton @onclick="SearchData"><i class='icon style1 fa-search' title="Pesquisar"></i></SfButton>
                        <SfButton @onclick="@(() => { PopupTask = true; seltask.Id = 0; seltask.Notas = ""; seltask.AllDay = false; Urgente = false; seltask.Inicio = DateTime.Now; seltask.Fim = DateTime.Now.AddMinutes(30); seltask.Recorrente = false; seltask.Recorrencia = "Diário"; seltask.Exceptions = ""; Eternal = true; })" CssClass="pull-right" title="Agendar Dosagem"><i class='icon style1 fa-calendar-plus-o'></i></SfButton>
                        <SfButton @onclick="@(() => { PopupDosagem = true; seldosagem.Id = 0; seldosagem.Notas = ""; seldosagem.DataRealizada = DateTime.Now; })" CssClass="pull-right" style="margin-right:1em;" title="Registar Dosagem"><i class='icon style1 fa-eyedropper'></i></SfButton>
                        <SfButton @onclick="@(() => { NavigationManager.NavigateTo("linha1/compostos"); })" CssClass="pull-right" style="margin-right:1em;" title="Gerir Compostos"><i class='icon style1 fa-list'></i></SfButton>
                    </div>
                </div>

                //ESTATISTICAS
                <div class="row uniform">
                    @if (Dosagens != null && Dosagens.Count() > 0)
                    {
                        <div class="4u 12u$(medium)" style="height:450px;">
                            @if (Dosagens != null && Dosagens.Count() > 0)
                            {
                                <SfChart Title="Top Tina" Width="100%" Height="400" Theme="@utils.ctheme">
                                    <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                    <ChartArea>
                                        <ChartAreaBorder Width="0"></ChartAreaBorder>
                                    </ChartArea>
                                    <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                    </ChartPrimaryXAxis>
                                    <ChartPrimaryYAxis Title="" LabelFormat="{value}" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                        <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                        <ChartAxisLabelStyle Color="transparent"></ChartAxisLabelStyle>
                                        <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                    </ChartPrimaryYAxis>
                                    <ChartSeriesCollection>
                                        <ChartSeries DataSource="@ChartData" Name="" XName="Dia" YName="Num" Type="ChartSeriesType.Bar">
                                            <ChartMarker>
                                                <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                            </ChartMarker>
                                        </ChartSeries>
                                    </ChartSeriesCollection>
                                </SfChart>
                            }
                        </div>
                        <div class="4u 12u$(medium)" style="height:450px;">
                            @if (Dosagens != null && Dosagens.Count() > 0)
                            {
                                <SfChart Title="Top Composto" Width="100%" Height="400" Theme="@utils.ctheme">
                                    <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                    <ChartArea>
                                        <ChartAreaBorder Width="0"></ChartAreaBorder>
                                    </ChartArea>
                                    <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                    </ChartPrimaryXAxis>
                                    <ChartPrimaryYAxis Title="" LabelFormat="{value}" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                        <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                        <ChartAxisLabelStyle Color="transparent"></ChartAxisLabelStyle>
                                        <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                        <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                    </ChartPrimaryYAxis>
                                    <ChartSeriesCollection>
                                        <ChartSeries DataSource="@ChartDataComposto" Name="" XName="Dia" YName="Num" Type="ChartSeriesType.Bar">
                                            <ChartMarker>
                                                <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                            </ChartMarker>
                                        </ChartSeries>
                                    </ChartSeriesCollection>
                                </SfChart>
                            }
                        </div>
                        <div class="4u 12u$(medium)" style="height:450px;">
                            <div style="display: flex; flex-direction:column; justify-content:center; height:450px;">
                                <ul class="alt">
                                    <li><i class="icon style1 fa-eyedropper"></i> <strong> @diassman</strong> Dias sem dosagens</li>
                                    <li><i class="icon style1 fa-list"></i> <strong> @opefetuadas</strong> Dosagens efetuadas</li>
                                    <li><i class="icon style1 fa-calendar"></i> <strong> @opagendadas</strong> Dosagens agendadas</li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="12u 12u$(medium)">
                            <div style="display: flex; flex-direction:row; justify-content:center;">
                                <p>
                                    <i class="icon style1 fa-eyedropper"></i> <strong> @diassman</strong> Dias sem dosagens |
                                    <i class="icon style1 fa-list"></i> <strong> @opefetuadas</strong> Dosagens efetuadas |
                                    <i class="icon style1 fa-calendar"></i> <strong> @opagendadas</strong> Dosagens agendadas
                                </p>
                            </div>
                        </div>
                    }
                </div>

                //TABELA
                <div class="row uniform">
                    @if (Dosagens != null && Dosagens.Count() > 0)
                    {
                        <div>
                            <SfGrid DataSource="@Dosagens" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowSelection="false" EnableHover="false">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                <GridEvents QueryCellInfo="CustomizeCell" TValue="Schedule"></GridEvents>
                                <GridSortSettings>
                                    <GridSortColumns>
                                        <GridSortColumn Field="Inicio" Direction="SortDirection.Ascending"></GridSortColumn>
                                        <GridSortColumn Field="DataRealizada" Direction="SortDirection.Ascending"></GridSortColumn>
                                    </GridSortColumns>
                                </GridSortSettings>
                                <GridTemplates>
                                    <DetailTemplate>
                                        @{
                                            var whois = (context as Schedule);
                                            <p>@((MarkupString)whois.Notas.Replace("\n", "<br />"))</p>
                                        }
                                    </DetailTemplate>
                                </GridTemplates>

                                <GridColumns>
                                    <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
                                        <Template>
                                            @{
                                                var whois = (context as Schedule);
                                                <div style="display: flex; justify-content: space-between;">
                                                    @if (whois.DataRealizada == null)
                                                    {
                                                        <p @onclick="@(() => { edittask(whois.Id, whois.Inicio, whois.Fim); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                    }
                                                    else
                                                    {
                                                        <p @onclick="@(() => { editdosagem(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                    }
                                                </div>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="U" Width="6">
                                        <Template>
                                            @{
                                                var whois = (context as Schedule);
                                                <div style="display: flex; justify-content: space-between;">
                                                    @if (whois.Inicio != null && whois.Inicio == whois.Fim.Value)
                                                    {
                                                        <p @onclick="@(() => { edittask(whois.Id, whois.Inicio, whois.Fim); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                    }
                                                    else
                                                    {
                                                        <p @onclick="@(() => { editdosagem(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label" title="Editar">Editar</span></p>
                                                    }
                                                </div>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="Tina" HeaderText="Tina"></GridColumn>
                                    <GridColumn Field="Composto" HeaderText="Composto"></GridColumn>
                                    <GridColumn Field="Valor" HeaderText="Valor"></GridColumn>
                                    <GridColumn Field="Unidade" HeaderText="Unidade"></GridColumn>
                                    <GridColumn Field="Inicio" HeaderText="Inicio" HideAtMedia="(min-width: 700px)"></GridColumn>
                                    <GridColumn Field="Fim" HeaderText="Fim" HideAtMedia="(min-width: 700px)"></GridColumn>
                                    <GridColumn Field="DataRealizada" HeaderText="Realizada em" HideAtMedia="(min-width: 700px)"></GridColumn>
                                    <GridColumn Field="OperadorRealizou" HeaderText="Realizada por" HideAtMedia="(min-width: 700px)"></GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </div>
                    }
                    else
                    {
                        <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                            <div class="card text-dark bg-light">
                                <div class="card-body">
                                    <p style="margin:0;">Sem operações de dosagem efetuadas/agendadas para o período selecionado.</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @*ADICIONAR DOSAGEM*@
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupDosagem">
                    <DialogTemplates>
                        <Header>Registar Dosagem</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Tina</p>
                                    <SfDropDownList Value="@seldosagem.Tina" TValue="string" TItem="Recc" DataSource="@Tinas.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelTina_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Composto</p>
                                    <SfDropDownList Value="@seldosagem.Composto" TValue="string" TItem="Recc" DataSource="@Compostos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelComposto_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Quantidade</p>
                                    <SfNumericTextBox @bind-Value="@seldosagem.Valor" style="margin-left:10px;padding:0"></SfNumericTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Unidade</p>
                                    <SfTextBox Multiline="false" @bind-Value="@seldosagem.Unidade" style="margin-left:10px;padding:0" Enabled="false"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Notas</p>
                                    <SfTextBox Multiline="true" @bind-Value="@seldosagem.Notas" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Inicio</p>
                                    <SfDateTimePicker @bind-Value="@seldosagem.DataRealizada" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                </div>
                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>
                            @if (seldosagem.Id != 0)
                            {
                                <button class="button special pull-left" @onclick="@(() => { PopupDelDosagem = true; })" style="margin:10px">Eliminar</button>
                            }
                            <button class="button special pull-right" @onclick="@(() => { Add_Dosagem(seldosagem.Id); })" style="margin:10px">Guardar</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDosagem = false; seldosagem = new DosagemRealizada() { }; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ELIMINAR DOSAGEM*@
                <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelDosagem">
                    <DialogTemplates>
                        <Header>Eliminar Dosagem</Header>
                        <Content>
                            <p>
                                A eliminação da informação de dosagem é permanente.<br />
                                Pretende realmente eliminar a informação de dosagem?
                            </p>
                            <button class="button special pull-right" @onclick="@(() => { Del_Dosagem(seldosagem.Id); })" style="margin:10px">Sim</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDelDosagem = false; })" style="margin:10px">Não</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ADICIONAR TASK*@
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupTask">
                    <DialogTemplates>
                        <Header>Agendar Dosagem</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Tina</p>
                                    <SfDropDownList Value="@seltask.Tina" TValue="string" TItem="Recc" DataSource="@Tinas.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelTina_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Composto</p>
                                    <SfDropDownList Value="@seltask.Composto" TValue="string" TItem="Recc" DataSource="@Compostos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelComposto_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Quantidade</p>
                                    <SfNumericTextBox @bind-Value="@seltask.Valor" style="margin-left:10px;padding:0"></SfNumericTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Unidade</p>
                                    <SfTextBox Multiline="false" @bind-Value="@seltask.Unidade" style="margin-left:10px;padding:0" Enabled="false"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Notas</p>
                                    <SfTextBox Multiline="true" @bind-Value="@seltask.Notas" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:6.5em;margin:0;margin-top:10px;color:red">Urgente</p>
                                    <div style="margin-left:10px;margin-top:10px;padding:0">
                                        <SfCheckBox @bind-Checked="@Urgente" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                    </div>
                                </div>
                                @if (Urgente == false)
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Inicio</p>
                                        <SfDateTimePicker @bind-Value="@seltask.Inicio" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                    </div>
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Fim</p>
                                        <SfDateTimePicker @bind-Value="@seltask.Fim" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                    </div>
                                }

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:6.5em;margin:0;margin-top:10px;">Recorrente</p>
                                    <div style="margin-left:10px;margin-top:10px;padding:0">
                                        <SfCheckBox @bind-Checked="@seltask.Recorrente" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                    </div>
                                </div>
                                @if (seltask.Recorrente == true)
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Recorrência</p>
                                        <SfDropDownList Value="@seltask.Recorrencia" TValue="string" TItem="Recc" DataSource="@Recs.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                            <DropDownListEvents OnValueSelect="@SelRecorrence_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                            <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    </div>
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:6.5em;margin:0;margin-top:10px;">Sem fim</p>
                                        <div style="margin-left:10px;margin-top:10px;padding:0">
                                            <SfCheckBox @bind-Checked="@Eternal" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                        </div>
                                    </div>
                                    if (Eternal == false)
                                    {
                                        <div style="display: flex; justify-content: left; margin:0.5em">
                                            <p style="width:8em;margin:0;margin-top:10px;">Até</p>
                                            <SfDatePicker @bind-Value="@seltask.RecorrenciaEnd" style="margin-left:10px;padding:0"></SfDatePicker>
                                        </div>
                                    }
                                }

                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>
                              @if (seltask.Id != 0)
                              {
                                  if (seltask.Recorrente == true)
                                  {
                                      <button class="button special pull-left" @onclick="@(() => { PopupDelTask_rec = true; })" style="margin:10px">Eliminar</button>
                                  }
                                  else
                                  {
                                      <button class="button special pull-left" @onclick="@(() => { PopupDelTask_norec = true; })" style="margin:10px">Eliminar</button>
                                  }
                              }
                              <button class="button special pull-right" @onclick="@(() => { Add_Task(seltask.Id); })" style="margin:10px">Guardar</button>
                              <button class="button pull-right" @onclick="@(() => { PopupTask = false; seltask = new DosagemAgendada() { }; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ELIMINAR TASK*@
                <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelTask_rec">
                    <DialogTemplates>
                        <Header>Eliminar Agendamento</Header>
                        <Content>
                            <p>
                                O presente agendamento de dosagem é uma operação recorrente.<br />
                                Pretende eliminar apenas o agendamento atual ou toda a recorrência?
                            </p>
                            <button class="button special pull-right" @onclick="@(() => { Del_all = false; Del_Task(seltask.Id); })" style="margin:10px">Agendamento Atual</button>
                            <button class="button special pull-right" @onclick="@(() => { Del_all = true; Del_Task(seltask.Id); })" style="margin:10px">Toda a Recorrência</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDelTask_rec = false; Del_all = false; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ELIMINAR AGENDAMENTO*@
                <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelTask_norec">
                    <DialogTemplates>
                        <Header>Eliminar Agendamento</Header>
                        <Content>
                            <p>
                                A eliminação do agendamento da dosagem é permanente.<br />
                                Pretende realmente eliminar o agendamento da dosagem?
                            </p>
                            <button class="button special pull-right" @onclick="@(() => { Del_Task(seltask.Id); })" style="margin:10px">Sim</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDelTask_norec = false; })" style="margin:10px">Não</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>



            }
            else
            {
                <div class="row uniform" style="margin-top:20px">
                    <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                        <div class="card text-dark bg-light">
                            <div class="card-body">
                                <p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
                                <a href="/">Voltar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @*LOADING*@
