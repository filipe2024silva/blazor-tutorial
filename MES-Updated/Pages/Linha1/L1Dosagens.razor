            Urgente = false;
        }

        if (seltask.RecorrenciaEnd != null)
        {
            Eternal = false;
        }
        else
        {
            Eternal = true;
        }

        PopupTask = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Add_Task(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (Urgente == true)
        {
            seltask.Inicio = DateTime.Now;
            seltask.Fim = seltask.Inicio;
        }
        else
        {
            if (seltask.Fim == seltask.Inicio)
            {
                seltask.Fim = seltask.Inicio.Value.AddMinutes(30);
            }
        }

        if (Eternal == true)
        {
            seltask.RecorrenciaEnd = null;
        }

        if (id == 0)
        {
            if (seltask.Tina != "" && seltask.Composto != "" && seltask.Valor != 0 && seltask.Unidade != "")
            {
                dl.db.DosagensAgenda.Add(new DosagemAgendada { Tina = seltask.Tina, Composto = seltask.Composto, Valor = seltask.Valor, Unidade = seltask.Unidade, Notas = seltask.Notas, AllDay = seltask.AllDay, Inicio = seltask.Inicio, Fim = seltask.Fim, Recorrente = seltask.Recorrente, Recorrencia = seltask.Recorrencia, Exceptions = seltask.Exceptions, RecorrenciaEnd = seltask.RecorrenciaEnd, Operador = "Qualquer Utilizador", Criador = who.name });
            }
            else
            {
                Erromsg = "Deve preencher corretamente os campos!";
            }

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Adicionou o agendamento de dosagem de {seltask.Valor} {seltask.Unidade} do composto '{seltask.Composto}', na tina '{seltask.Tina}'", "DataLink_L1");
        }
        else
        {
            dl.db.DosagensAgenda.First(x => x.Id == id).Tina = seltask.Tina;
            dl.db.DosagensAgenda.First(x => x.Id == id).Composto = seltask.Composto;
            dl.db.DosagensAgenda.First(x => x.Id == id).Valor = seltask.Valor;
            dl.db.DosagensAgenda.First(x => x.Id == id).Unidade = seltask.Unidade;
            dl.db.DosagensAgenda.First(x => x.Id == id).Notas = seltask.Notas;
            dl.db.DosagensAgenda.First(x => x.Id == id).AllDay = seltask.AllDay;
            dl.db.DosagensAgenda.First(x => x.Id == id).Inicio = seltask.Inicio;
            dl.db.DosagensAgenda.First(x => x.Id == id).Fim = seltask.Fim;
            dl.db.DosagensAgenda.First(x => x.Id == id).Recorrente = seltask.Recorrente;
            dl.db.DosagensAgenda.First(x => x.Id == id).Recorrencia = seltask.Recorrencia;
            dl.db.DosagensAgenda.First(x => x.Id == id).Exceptions = seltask.Exceptions;
            dl.db.DosagensAgenda.First(x => x.Id == id).RecorrenciaEnd = seltask.RecorrenciaEnd;
            dl.db.DosagensAgenda.First(x => x.Id == id).Criador = who.name;

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Alterou o agendamento de dosagem de {seltask.Valor} {seltask.Unidade} do composto '{seltask.Composto}', na tina '{seltask.Tina}'", "DataLink_L1");
        }

        PopupTask = false;
        seltask = new DosagemAgendada() { };
        Urgente = false;
        Eternal = true;

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Del_Task(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (seltask.Recorrente == true)
        {
            if (Del_all == true)
            {
                dl.db.DosagensAgenda.Remove(dl.db.DosagensAgenda.First(x => x.Id == id));
                await dl.db.Dosagens.Where(x => x.Idmarcar == id).ForEachAsync(x => x.Idmarcar = -1);
            }
            else
            {
                dl.db.DosagensAgenda.First(x => x.Id == id).Exceptions += seltask.Inicio + ";";
            }
        }
        else
        {
            dl.db.DosagensAgenda.Remove(dl.db.DosagensAgenda.First(x => x.Id == id));
            await dl.db.Dosagens.Where(x => x.Idmarcar == id).ForEachAsync(x => x.Idmarcar = -1);
        }
        await dl.db.SaveChangesAsync();
        utils.UserLog($"Eliminou o agendamento de dosagem de {seltask.Valor} {seltask.Unidade} do composto '{seltask.Composto}', na tina '{seltask.Tina}'", "DataLink_L1");

        PopupTask = false;
        PopupDelTask_rec = false;
        PopupDelTask_norec = false;
        seltask = new DosagemAgendada() { };
        Urgente = false;
        Eternal = true;
        Del_all = false;

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

    public void SelTina_SelectionChanged(@Syncfusion.Blazor.DropDowns.SelectEventArgs<Recc> args)
    {
        if (PopupTask == true)
        {
            seltask.Tina = args.ItemData.Rec;
        }
        if (PopupDosagem == true)
        {
            seldosagem.Tina = args.ItemData.Rec;
        }
    }

    public void SelComposto_SelectionChanged(@Syncfusion.Blazor.DropDowns.SelectEventArgs<Recc> args)
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.DosagemCompostos.First(x => x.Id == int.Parse(args.ItemData.Id));
        if (PopupTask == true)
        {
            seltask.Composto = doc.Nome;
            seltask.Unidade = doc.Unidade;
            seltask.Valor = doc.Valor;
        }
        if (PopupDosagem == true)
        {
            seldosagem.Composto = doc.Nome;
            seldosagem.Unidade = doc.Unidade;
            seldosagem.Valor = doc.Valor;
        }

        StateHasChanged();
        dl.Dispose();
    }

    public void CustomizeCell(QueryCellInfoEventArgs<Schedule> args)
    {
        if (args.Column.HeaderText == "U")
        {
            if (args.Data.Inicio != null && args.Data.Fim == args.Data.Inicio)
            {
                args.Cell.AddClass(new string[] { "above-0" });
            }
            if (args.Data.Valor == 0)
            {
                args.Cell.AddClass(new string[] { "below-0" });
            }
        }
    }

