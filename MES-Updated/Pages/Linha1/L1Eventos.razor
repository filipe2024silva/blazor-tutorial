@page "/linha1/eventos"

@inject NavigationManager NavigationManager
@inject Utils utils

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("EVL1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 1 - REGISTO DE EVENTOS</h1>
                        @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                    </div>
                    <div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
                        <button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    </div>
                </div>

                <div class="row uniform">
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfButton @onclick="SearchData">Pesquisar</SfButton>
                    </div>
                </div>

                <div class="row uniform">
                    <SfTab>
                        <TabItems>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="TIMELINE"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    @if (Comportamento != null && Comportamento.Count > 0)
                                    {
                                        <div class="row uniform" style="margin-top:20px">
                                            <div class="9u 12u$(medium)">
                                                @*TIMELINE*@
                                                <div class="timeline">
                                                    @foreach (var item in Comportamento)
                                                    {
                                                        if (item.Comportamento.ToUpper().Contains("LOGIN") || item.Comportamento.ToUpper().Contains("LOGOUT") || item.Comportamento.ToUpper().Contains("BACKUP"))
                                                        {
                                                            <div class="timeline_container timeline_left">
                                                                <div class="timeline_content">
                                                                    <p style="margin:0;"><i class="icon style1 fa-calendar"></i> @item.Tempo</p>
                                                                    <p style="margin:0; overflow-wrap: break-word;">@item.Comportamento</p>
                                                                    <hr style="margin:1em 0 0 0" />
                                                                    <p style="margin:0;"><i class="icon style1 fa-user"></i> @item.Username</p>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="timeline_container timeline_right">
                                                                <div class="timeline_content">
                                                                    <p style="margin:0;"><i class="icon style1 fa-calendar"></i> @item.Tempo</p>
                                                                    <p style="margin:0; overflow-wrap: break-word;">@item.Comportamento</p>
                                                                    <hr style="margin:1em 0 0 0" />
                                                                    <p style="margin:0;"><i class="icon style1 fa-user"></i> @item.Username</p>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <div class="3u 12u$(medium)">
                                                @*USER*@
                                                <div>
                                                    <ul class="alt">
                                                        <li>
                                                            <img src="@picture(user.pic)" style="width:64px;height:64px;object-fit:cover;border-radius: 50%;border: 1px solid black;">
                                                        </li>
                                                        <li>@user.name</li>
                                                        <li>Ações: @nactions</li>
                                                        <li>Operações de Backup: @nbackups</li>
                                                        <li>Inserções na Linha: @nline</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row uniform" style="margin-top:20px">
                                            <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                                <div class="card text-dark bg-light">
                                                    <div class="card-body">
                                                        <p style="margin:0;">Sem dados para apresentar relativamente ao período de tempo selecionado.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </ContentTemplate>
                            </TabItem>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="COMPORTAMENTO"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    @if (ComportamentoFull != null && ComportamentoFull.Count() > 0)
                                    {
                                        <div>
                                            @*TABELA*@
                                            <SfGrid DataSource="@ComportamentoFull" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowResizing="true">                                                
                                                <GridColumns>
                                                    <GridColumn Field="Tempo" HeaderText="Data" Width="200" Type="ColumnType.DateTime"></GridColumn>
                                                    <GridColumn Field="Username" HeaderText="Utilizador" Width="300" Type="ColumnType.String"></GridColumn>
                                                    <GridColumn Field="Comportamento" HeaderText="Comportamento" Type="ColumnType.String"></GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                            </div>
                                    }
                                    else
                                    {
                                        <div class="row uniform" style="margin-top:20px">
                                            <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                                <div class="card text-dark bg-light">
                                                    <div class="card-body">
                                                        <p style="margin:0;">Sem dados para apresentar relativamente ao período de tempo selecionado.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </ContentTemplate>
                            </TabItem>
                        </TabItems>
                    </SfTab>
                </div>


            }
            else
            {
                <div class="row uniform" style="margin-top:20px">
                    <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                        <div class="card text-dark bg-light">
                            <div class="card-body">
                                <p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
                                <a href="/">Voltar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @*LOADING*@
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>

    </div>
</div>




@code {
    SfSpinner SpinnerObj = new SfSpinner();
    User user = new User();

    bool dbchecked = false, dbcheckedoff = false;
    public DateTime? dti { get; set; } = DateTime.Today;
    public DateTime? dtf { get; set; } = DateTime.Today;

    public List<sv.data.User> Comportamento = new List<sv.data.User>() { };
    public List<sv.data.User> ComportamentoFull = new List<sv.data.User>() { };
    public string nactions = "";
    public string nbackups = "";
    public string nline = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == true)
        {
            user = (User)utils.f10session["user"];
            GetDB();
        }
        base.OnAfterRender(firstRender);
    }
    private async void GetDB()
    {
        DataLink_L1 DL1 = new DataLink_L1();

        if (await DL1.db.Database.CanConnectAsync())
        {
            utils.L1ON = true;
            dbchecked = true;
            dbcheckedoff = false;
            DL1.Dispose();
            StateHasChanged();
            SearchData();
        }
        else
        {
            utils.L1ON = false;
            dbchecked = false;
            dbcheckedoff = true;
            DL1.Dispose();
            StateHasChanged();
        }
    }
    private async void SearchData()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;
        try
        {
            if (user != null)
            {
                //TABELA
                var qhistory = dl.db.Users.OrderByDescending(x => x.Id).Where(x => x.Tempo >= dti && x.Tempo <= dtf.Value.AddDays(1));
                var dados = await qhistory.ToListAsync();
                ComportamentoFull = dados;
                Comportamento = dados;

                //STATS
                nactions = dados.Where(x => x.Username.ToUpper() == user.username.ToUpper()).Count().ToString();
                nbackups = dados.Where(x => x.Username.ToUpper() == user.username.ToUpper() && x.Comportamento.ToUpper().Contains("BACKUP")).Count().ToString();

                var qline = dl.db.ReferenciaTrabalhos.OrderByDescending(x => x.Id).Where(x => x.LoteData >= dti && x.LoteData <= dtf.Value.AddDays(1) && x.Operador.ToUpper() == user.username.ToUpper());
                var dadosline = await qline.ToListAsync();
                nline = dadosline.Count().ToString();
            }
        }
        finally
        {
            StateHasChanged();
            await SpinnerObj.HideAsync();
        }
    }

    private void BackStreetButton()
    {
        NavigationManager.NavigateTo("/linha1/");
    }

    private string picture(Byte[] pic)
    {
        if (pic != null)
        {
            return "data:image/png;base64," + Convert.ToBase64String(pic);
        }
        else
        {
            return "data:image/png;base64,";
        }
    }

}

