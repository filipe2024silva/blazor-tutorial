    private bool PopupDelManutencao = false;
    public Manutencao selmanutencao = new Manutencao() { };

    private async void editmanutencao(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.Manutencao.First(x => x.Id == id);
        selmanutencao = doc;

        PopupManutencao = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Add_Manutencao(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (id == 0)
        {
            if (selmanutencao.Equipamento != "" && selmanutencao.Operation != "" && selmanutencao.Tipo != "")
            {
                dl.db.Manutencao.Add(new pulsar.sv.data.Manutencao { Idmarcar = -1, Equipamento = selmanutencao.Equipamento, Operation = selmanutencao.Operation, Inicio = selmanutencao.Inicio, Notas = selmanutencao.Notas, Operador = who.name, Tipo = selmanutencao.Tipo });
            }
            else
            {
                Erromsg = "Deve preencher corretamente os campos!";
            }

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Inseriu a operação de manutenção '{selmanutencao.Operation}', no equipamento '{selmanutencao.Equipamento}'", "DataLink_L1");
        }
        else
        {
            dl.db.Manutencao.First(x => x.Id == id).Equipamento = selmanutencao.Equipamento;
            dl.db.Manutencao.First(x => x.Id == id).Operation = selmanutencao.Operation;
            dl.db.Manutencao.First(x => x.Id == id).Tipo = selmanutencao.Tipo;
            dl.db.Manutencao.First(x => x.Id == id).Notas = selmanutencao.Notas;
            dl.db.Manutencao.First(x => x.Id == id).Inicio = selmanutencao.Inicio;
            dl.db.Manutencao.First(x => x.Id == id).Operador = who.name;

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Alterou a operação de manutenção '{selmanutencao.Operation}', no equipamento '{selmanutencao.Equipamento}'", "DataLink_L1");
        }

        PopupManutencao = false;
        selmanutencao = new Manutencao() { };

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Del_Manutencao(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        dl.db.Manutencao.Remove(dl.db.Manutencao.First(x => x.Id == id));
        await dl.db.SaveChangesAsync();
        utils.UserLog($"Eliminou a operação de manutenção '{selmanutencao.Operation}', no equipamento '{selmanutencao.Equipamento}'", "DataLink_L1");

        PopupManutencao = false;
        PopupDelManutencao = false;
        selmanutencao = new Manutencao() { };

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

