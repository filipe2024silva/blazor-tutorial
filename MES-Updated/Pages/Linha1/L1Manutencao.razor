@page "/linha1/manutencao"
@using System.Globalization

@using pulsar.sv.data
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Utils utils

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("ML1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 1 - MANUTENÇÃO</h1>
                        @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                    </div>
                    <div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
                        <button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    </div>
                </div>

                if (PopupDocs == false)
                {
                    <div class="row uniform">
                        <div class="4u 12u$(medium)">
                            <SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
                        </div>
                        <div class="4u 12u$(medium)">
                            <SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
                        </div>
                        <div class="4u 12u$(medium)">
                            <SfButton @onclick="SearchData" Title="Pesquisar"><i class='icon style1 fa-search'></i></SfButton>
                            <SfButton @onclick="@(() => { PopupTask = true; seltask.Id = 0; seltask.Notas = ""; seltask.AllDay = false; Urgente = false; seltask.Inicio = DateTime.Now; seltask.Fim = DateTime.Now.AddMinutes(30); seltask.Recorrente = false; seltask.Recorrencia = "Diário"; seltask.Exceptions = ""; Eternal = true; })" CssClass="pull-right" Title="Agendar Manutenção"><i class='icon style1 fa-calendar-plus-o'></i></SfButton>
                            <SfButton @onclick="@(() => { PopupManutencao = true; selmanutencao.Id = 0; selmanutencao.Notas = ""; selmanutencao.Inicio = DateTime.Now; })" CssClass="pull-right" style="margin-right:1em;" Title="Registar Manutenção"><i class='icon style1 fa-industry'></i></SfButton>
                            <SfButton @onclick="@(() => { NavigationManager.NavigateTo("linha1/equipamentos"); })" CssClass="pull-right" style="margin-right:1em;" Title="Gerir Equipamentos"><i class='icon style1 fa-list'></i></SfButton>
                        </div>
                    </div>

                    //ESTATISTICAS
                    <div class="row uniform">
                        @if (Manutencoes != null && Manutencoes.Count() > 0)
                        {
                            <div class="3u 12u$(medium)" style="height:450px;">
                                @if (Manutencoes != null && Manutencoes.Count() > 0)
                                {
                                    <SfAccumulationChart Title="Tipo de Operação" Width="100%" Height="400" Theme="@utils.ctheme">
                                        <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                        </AccumulationChartLegendSettings>
                                        <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                        <AccumulationChartSeriesCollection>
                                            <AccumulationChartSeries DataSource="@RoundChartData" XName="Dia" YName="Num" Radius="70%" InnerRadius="40%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3" Palettes="@chartpalettes">
                                                <AccumulationDataLabelSettings Visible="true" Name="text">
                                                    <AccumulationChartDataLabelFont FontWeight="600" Color="white"></AccumulationChartDataLabelFont>
                                                </AccumulationDataLabelSettings>
                                            </AccumulationChartSeries>
                                        </AccumulationChartSeriesCollection>
                                    </SfAccumulationChart>
                                }
                            </div>
                            <div class="6u 12u$(medium)" style="height:450px;">
                                @if (Manutencoes != null && Manutencoes.Count() > 0)
                                {
                                    <SfChart Title="Top Equipamentos" Width="100%" Height="400" Theme="@utils.ctheme">
                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                        <ChartArea>
                                            <ChartAreaBorder Width="0"></ChartAreaBorder>
                                        </ChartArea>
                                        <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                            <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                        </ChartPrimaryXAxis>
                                        <ChartPrimaryYAxis Title="" LabelFormat="{value}" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                            <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                            <ChartAxisLabelStyle Color="transparent"></ChartAxisLabelStyle>
                                            <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                            <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                        </ChartPrimaryYAxis>
                                        <ChartSeriesCollection>
                                            <ChartSeries DataSource="@ChartData" Name="" XName="Dia" YName="Num" Type="ChartSeriesType.Bar">
                                                <ChartMarker>
                                                    <Char Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></Char ftDataLabel>
                                                </ChartMarker>
                                            </ChartSeries>
                                        </ChartSeriesCollection>
                                    </SfChart>
                                }
                            </div>
                            <div class="3u 12u$(medium)" style="height:450px;">
                                <div style="display: flex; flex-direction:column; justify-content:center; height:450px;">
                                    <ul class="alt">
                                        <li><i class="icon style1 fa-wrench"></i> <strong> @diassman</strong> Dias sem manutenção</li>
                                        <li><i class="icon style1 fa-list"></i> <strong> @opefetuadas</strong> Operações efetuadas</li>
                                        <li><i class="icon style1 fa-calendar"></i> <strong> @opagendadas</strong> Operações agendadas</li>
                                    </ul>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="12u 12u$(medium)">
                                <div style="display: flex; flex-direction:row; justify-content:center;">
                                    <p>
                                        <i class="icon style1 fa-wrench"></i> <strong> @diassman</strong> Dias sem manutenção |
                                        <i class="icon style1 fa-list"></i> <strong> @opefetuadas</strong> Operações efetuadas |
                                        <i class="icon style1 fa-calendar"></i> <strong> @opagendadas</strong> Operações agendadas
                                    </p>
                                </div>
                            </div>
                        }
                    </div>

                    //TABELA
                    <div class="row uniform">
                        @if (Manutencoes != null && Manutencoes.Count() > 0)
                        {
                            <div>
                                <SfGrid DataSource="@Manutencoes" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowSelection="false" EnableHover="false">
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                    <GridEvents QueryCellInfo="CustomizeCell" TValue="Schedule"></GridEvents>
                                    <GridSortSettings>
                                        <GridSortColumns>
                                            <GridSortColumn Field="Inicio" Direction="SortDirection.Ascending"></GridSortColumn>
                                            <GridSortColumn Field="DataRealizada" Direction="SortDirection.Ascending"></GridSortColumn>
                                        </GridSortColumns>
                                    </GridSortSettings>
                                    <GridTemplates>
                                        <DetailTemplate>
                                            @{
                                                var whois = (context as Schedule);
                                                <p>@((MarkupString)whois.Notas.Replace("\n", "<br />"))</p>
                                            }
                                        </DetailTemplate>
                                    </GridTemplates>

                                    <GridColumns>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
                                            <Template>
                                                @{
                                                    var whois = (context as Schedule);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        @if (whois.DataRealizada == null)
                                                        {
                                                            <p @onclick="@(() => { edittask(whois.Id, whois.Inicio, whois.Fim); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                        }
                                                        else
                                                        {
                                                            <p @onclick="@(() => { editmanutencao(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
                                            <Template>
                                                @{
                                                    var whois = (context as Schedule);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        @if (whois.DataRealizada != null)
                                                        {
                                                            <p @onclick="@(() => { docs(whois.Id); })" class="icon style1 fa-archive" style="margin:0.3em;cursor:pointer" title="Documentos"><span class="label">Documentos</span></p>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="U" Width="6">
                                            <Template>
                                                @{
                                                    var whois = (context as Schedule);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        @if (whois.Inicio != null && whois.Inicio == whois.Fim.Value)
                                                        {
                                                            <p @onclick="@(() => { edittask(whois.Id, whois.Inicio, whois.Fim); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                        }
                                                        else
                                                        {
                                                            <p @onclick="@(() => { editmanutencao(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer" title="Editar"><span class="label">Editar</span></p>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="Equipamento" HeaderText="Equipamento"></GridColumn>
                                        <GridColumn Field="Operation" HeaderText="Operação"></GridColumn>
                                        <GridColumn Field="Tipo" HeaderText="Tipo" HideAtMedia="(min-width: 700px)"></GridColumn>
                                        <GridColumn Field="Inicio" HeaderText="Inicio" HideAtMedia="(min-width: 700px)"></GridColumn>
                                        <GridColumn Field="Fim" HeaderText="Fim" HideAtMedia="(min-width: 700px)"></GridColumn>
                                        <GridColumn Field="DataRealizada" HeaderText="Realizada em" HideAtMedia="(min-width: 700px)"></GridColumn>
                                        <GridColumn Field="OperadorRealizou" HeaderText="Realizada por" HideAtMedia="(min-width: 700px)"></GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                        else
                        {
                            <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                <div class="card text-dark bg-light">
                                    <div class="card-body">
                                        <p style="margin:0;">Sem operações de manutenção efetuadas/agendadas para o período selecionado.</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    //DOCUMENTOS
                    <div class="row uniform">
                        <div class="6u 12u$(medium)" style="display: flex;justify-content:flex-start;">
                            <button @onclick="@(() => { PopupNewDoc = true; PopupSave = true; })"><i class="icon style1 fa-plus"></i> Adicionar Documento</button>
                        </div>
                        <div class="6u 12u$(medium)" style="display: flex;justify-content:flex-end;">
                            <button @onclick="@(() => { PopupDocs = false; selmanutencao = new Manutencao() { }; })"><i class="icon style1 fa-times"></i></button>
                        </div>
                    </div>

                    <div class="row uniform">
                        @if (Documentos != null && Documentos.Count() > 0)
                        {
                            <div>
                                <SfGrid DataSource="@Documentos" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowSelection="false" EnableHover="false">
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                    <GridColumns>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
                                            <Template>
                                                @{
                                                    var whois = (context as Dcs);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        <p @onclick="@(() => { deletedoc(whois.Id); })" class="icon style1 fa-times" style="margin:0.3em;cursor:pointer"><span class="label">Eliminar</span></p>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
                                            <Template>
                                                @{
                                                    var whois = (context as Dcs);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        <p @onclick="@(() => { downloaddoc(whois.Id); })" class="icon style1 fa-download" style="margin:0.3em;cursor:pointer"><span class="label">Descarregar</span></p>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="Nome" HeaderText="Nome"></GridColumn>
                                        <GridColumn Field="Descricao" HeaderText="Descricao" HideAtMedia="(min-width: 700px)"></GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                        else
                        {
                            <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                <div class="card text-dark bg-light">
                                    <div class="card-body">
                                        <p style="margin:0;">Sem documentos registados na operação selecionada.</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }



                @*ADICIONAR MANUTENÇÃO*@
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupManutencao">
                    <DialogTemplates>
                        <Header>Registar Manutenção</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Equipamento</p>
                                    <SfDropDownList Value="@selmanutencao.Equipamento" TValue="string" TItem="Recc" DataSource="@Equipamentos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelEquipamento_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Operação</p>
                                    <SfTextBox Multiline="false" @bind-Value="@selmanutencao.Operation" style="margin-left:10px;padding:0"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Tipo</p>
                                    <SfDropDownList Value="@selmanutencao.Tipo" TValue="string" TItem="Recc" DataSource="@Tipos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelTipo_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Notas</p>
                                    <SfTextBox Multiline="true" @bind-Value="@selmanutencao.Notas" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Data</p>
                                    <SfDateTimePicker @bind-Value="@selmanutencao.Inicio" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                </div>
                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>
                              @if (selmanutencao.Id != 0)
                              {
                                <button class="button special pull-left" @onclick="@(() => { PopupDelManutencao = true; })" style="margin:10px">Eliminar</button>
                              }
                                <button class="button special pull-right" @onclick="@(() => { Add_Manutencao(selmanutencao.Id); })" style="margin:10px">Guardar</button>
                                <button class="button pull-right" @onclick="@(() => { PopupManutencao = false; selmanutencao = new Manutencao() { }; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ELIMINAR MANUTENCAO*@
                <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelManutencao">
                    <DialogTemplates>
                        <Header>Eliminar Manutenção</Header>
                        <Content>
                            <p>
                                A eliminação da operação de manutenção é permanente.<br />
                                Pretende realmente eliminar a operação de manutenção?
                            </p>
                            <button class="button special pull-right" @onclick="@(() => { Del_Manutencao(selmanutencao.Id); })" style="margin:10px">Sim</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDelManutencao = false; })" style="margin:10px">Não</button>
                        </Content>
                    </DialogTemplates>    
                </SfDialog>

                @*ADICIONAR TASK*@
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupTask">
                    <DialogTemplates>
                        <Header>Agendar Manutenção</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Equipamento</p>
                                    <SfDropDownList Value="@seltask.Equipamento" TValue="string" TItem="Recc" DataSource="@Equipamentos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelEquipamento_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Operação</p>
                                    <SfTextBox Multiline="false" @bind-Value="@seltask.Operation" style="margin-left:10px;padding:0"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Tipo</p>
                                    <SfDropDownList Value="@seltask.Tipo" TValue="string" TItem="Recc" DataSource="@Tipos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                        <DropDownListEvents OnValueSelect="@SelTipo_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Rec" Text="Rec"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Notas</p>
                                    <SfTextBox Multiline="true" @bind-Value="@seltask.Notas" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>

                                @*<div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Data</p>
                                    <SfDatePicker TValue="DateTime?" Placeholder='Data' @bind-Value="@selmanutencao.Inicio" style="margin-left:10px;padding:0"></SfDatePicker>
                                </div>*@

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:6.5em;margin:0;margin-top:10px;color:red">Urgente</p>
                                    <div style="margin-left:10px;margin-top:10px;padding:0">
                                        <SfCheckBox @bind-Checked="@Urgente" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                    </div>
                                </div>
                                @if (Urgente == false)
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Inicio</p>
                                        <SfDateTimePicker @bind-Value="@seltask.Inicio" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                    </div>
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Fim</p>
                                        <SfDateTimePicker @bind-Value="@seltask.Fim" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                    </div>
                                }

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:6.5em;margin:0;margin-top:10px;">Recorrente</p>
                                    <div style="margin-left:10px;margin-top:10px;padding:0">
                                        <SfCheckBox @bind-Checked="@seltask.Recorrente" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                    </div>
                                </div>
                                @if (seltask.Recorrente == true)
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Recorrência</p>
                                        <SfDropDownList Value="@seltask.Recorrencia" TValue="string" TItem="Recc" DataSource="@Recs.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                            <DropDownListEvents OnValueSelect="@SelRecorrence_SelectionChanged" TValue="string" TItem="Recc"></DropDownListEvents>
                                            <DropDownListFieldSettings Value="Id" Text="Rec"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    </div>
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:6.5em;margin:0;margin-top:10px;">Sem fim</p>
                                        <div style="margin-left:10px;margin-top:10px;padding:0">
                                            <SfCheckBox @bind-Checked="@Eternal" @onchange="@(() => { StateHasChanged(); })"></SfCheckBox>
                                        </div>
                                    </div>
                                    if (Eternal == false)
                                    {
                                        <div style="display: flex; justify-content: left; margin:0.5em">
                                            <p style="width:8em;margin:0;margin-top:10px;">Até</p>
                                            <SfDatePicker @bind-Value="@seltask.RecorrenciaEnd" style="margin-left:10px;padding:0"></SfDatePicker>
                                        </div>
                                    }
                                }

                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>
                            @if (seltask.Id != 0)
                            {
                                if (seltask.Recorrente == true)
                                {
                                    <button class="button special pull-left" @onclick="@(() => { PopupDelTask_rec = true; })" style="margin:10px">Eliminar</button>
                                }
                                else
                                {
