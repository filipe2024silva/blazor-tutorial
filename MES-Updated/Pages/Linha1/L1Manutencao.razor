    private bool PopupTask = false;
    private bool PopupDelTask_rec = false;
    private bool PopupDelTask_norec = false;
    private bool Del_all = false;
    public bool Urgente = false;
    public bool Eternal = true;
    public ManutencaoMarcar seltask = new ManutencaoMarcar() { };

    public void SelRecorrence_SelectionChanged(@Syncfusion.Blazor.DropDowns.SelectEventArgs<Recc> args)
    {
        seltask.Recorrencia = args.ItemData.Rec;
