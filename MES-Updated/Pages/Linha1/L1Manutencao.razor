    private async void edittask(int id, DateTime? inicio, DateTime? fim)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.ManutencaoMarcar.First(x => x.Id == id);
        seltask = doc;
        seltask.Inicio = inicio.Value;
        seltask.Fim = fim.Value;

        if (seltask.Fim == seltask.Inicio)
        {
            Urgente = true;
        }
        else
        {
            Urgente = false;
        }

        if (seltask.RecorrenciaEnd != null)
        {
            Eternal = false;
        }
        else
        {
            Eternal = true;
        }

        PopupTask = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Add_Task(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (Urgente == true)
        {
            seltask.Inicio = DateTime.Now;
            seltask.Fim = seltask.Inicio;
        }
        else
        {
            if (seltask.Fim == seltask.Inicio)
            {
                seltask.Fim = seltask.Inicio.Value.AddMinutes(30);
            }
        }

        if (Eternal == true)
        {
            seltask.RecorrenciaEnd = null;
        }

        if (id == 0)
        {
            if (seltask.Equipamento != "" && seltask.Operation != "" && seltask.Tipo != "")
            {
                dl.db.ManutencaoMarcar.Add(new ManutencaoMarcar { Equipamento = seltask.Equipamento, Operation = seltask.Operation, Tipo = seltask.Tipo, Notas = seltask.Notas, AllDay = seltask.AllDay, Inicio = seltask.Inicio, Fim = seltask.Fim, Recorrente = seltask.Recorrente, Recorrencia = seltask.Recorrencia, Exceptions = seltask.Exceptions, RecorrenciaEnd = seltask.RecorrenciaEnd, Operador = "Qualquer Utilizador", Criador = who.name });
            }
            else
            {
                Erromsg = "Deve preencher corretamente os campos!";
            }

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Inseriu o agendamento de manutenção '{seltask.Operation}', no equipamento '{seltask.Equipamento}'", "DataLink_L1");
        }
        else
        {
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Equipamento = seltask.Equipamento;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Operation = seltask.Operation;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Tipo = seltask.Tipo;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Notas = seltask.Notas;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).AllDay = seltask.AllDay;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Inicio = seltask.Inicio;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Fim = seltask.Fim;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Recorrente = seltask.Recorrente;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Recorrencia = seltask.Recorrencia;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Exceptions = seltask.Exceptions;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).RecorrenciaEnd = seltask.RecorrenciaEnd;
            dl.db.ManutencaoMarcar.First(x => x.Id == id).Criador = who.name;

            await dl.db.SaveChangesAsync();
            utils.UserLog($"Alterou o agendamento de manutenção '{seltask.Operation}', no equipamento '{seltask.Equipamento}'", "DataLink_L1");
        }

        PopupTask = false;
        seltask = new ManutencaoMarcar() { };
        Urgente = false;
        Eternal = true;

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Del_Task(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (seltask.Recorrente == true)
        {
            if (Del_all == true)
            {
                dl.db.ManutencaoMarcar.Remove(dl.db.ManutencaoMarcar.First(x => x.Id == id));
                await dl.db.Manutencao.Where(x => x.Idmarcar == id).ForEachAsync(x => x.Idmarcar = -1);
            }
            else
            {
                dl.db.ManutencaoMarcar.First(x => x.Id == id).Exceptions += seltask.Inicio + ";";
            }
        }
        else
        {
            dl.db.ManutencaoMarcar.Remove(dl.db.ManutencaoMarcar.First(x => x.Id == id));
            await dl.db.Manutencao.Where(x => x.Idmarcar == id).ForEachAsync(x => x.Idmarcar = -1);
        }
        await dl.db.SaveChangesAsync();
        utils.UserLog($"Eliminou o agendamento de manutenção '{seltask.Operation}', no equipamento '{seltask.Equipamento}'", "DataLink_L1");

        PopupTask = false;
        PopupDelTask_rec = false;
        PopupDelTask_norec = false;
        seltask = new ManutencaoMarcar() { };
        Urgente = false;
        Eternal = true;
        Del_all = false;

        await SpinnerObj.HideAsync();
        SearchData();
        StateHasChanged();
        dl.Dispose();
    }

