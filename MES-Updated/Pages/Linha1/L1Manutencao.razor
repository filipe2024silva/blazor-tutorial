    //DOCUMENTOS
    private bool PopupDocs = false;
    private bool PopupDelDoc = false;
    private bool PopupNewDoc = false;
    private bool PopupEditDoc = false;
    private bool PopupSave = true;
    public Dcs seldoc = new Dcs() { };
    public byte[] indoc = new byte[1];
    public List<Dcs> Documentos = new List<Dcs>() { };

    private async void docs(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var man = dl.db.Manutencao.First(x => x.Id == id);
        selmanutencao = man;

        //TABELA
        var pdocs = from rt in dl.db.ManutencaoDocumentos
                    where rt.Idmanutencao == id
                    select new Dcs { Id = rt.Id, Nome = rt.Nome, Descricao = rt.Descricao };
        var dados = await pdocs.ToListAsync();
        Documentos = dados;

        PopupDocs = true;
        StateHasChanged();
        await SpinnerObj.HideAsync();
        dl.Dispose();
    }

    private void OnChange(UploadChangeEventArgs args)
    {
        indoc = args.Files[0].Stream.ToArray();
        args.Files[0].Stream.Close();

        seldoc.Nome = args.Files[0].FileInfo.Name;
        PopupSave = false;
    }

    private void onRemove(RemovingEventArgs args)
    {
        indoc = new byte[1];
        seldoc = new Dcs() { };
        PopupSave = true;
        PopupEditDoc = false;
    }

    private async void Add_Doc()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        if (indoc.Length > 1)
        {
            dl.db.ManutencaoDocumentos.Add(new sv.data.ManutencaoDocumento { Idmanutencao = selmanutencao.Id, Nome = seldoc.Nome, Descricao = seldoc.Descricao, Ficheiro = indoc });
            await dl.db.SaveChangesAsync();
            utils.UserLog($"Inseriu o documento '{seldoc.Nome}' na operação de manutenção '{selmanutencao.Operation}' no equipamento '{selmanutencao.Equipamento}'", "DataLink_L1");
        }
        PopupNewDoc = false;
        PopupEditDoc = false;
        indoc = new byte[1];
        seldoc = new Dcs() { };

        await SpinnerObj.HideAsync();
        docs(selmanutencao.Id);
        StateHasChanged();
        dl.Dispose();
    }

    private async void deletedoc(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.ManutencaoDocumentos.First(x => x.Id == id);
        Dcs n = new Dcs() { Descricao = doc.Descricao, Id = doc.Id, Nome = doc.Nome };
        seldoc = n;

        PopupDelDoc = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }

    private async void Del_Doc(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();

        dl.db.ManutencaoDocumentos.Remove(dl.db.ManutencaoDocumentos.First(x => x.Id == id));
        await dl.db.SaveChangesAsync();
        utils.UserLog($"Eliminou o documento '{seldoc.Nome}' da operação de manutenção '{selmanutencao.Operation}', no equipamento '{selmanutencao.Equipamento}'", "DataLink_L1");

        PopupDelDoc = false;
        indoc = new byte[1];
        seldoc = new Dcs() { };

        await SpinnerObj.HideAsync();
        docs(selmanutencao.Id);
        StateHasChanged();
        dl.Dispose();
    }

    private async void downloaddoc(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        byte[] file = dl.db.ManutencaoDocumentos.Where(x => x.Id == id).First().Ficheiro;
        MemoryStream ms = new MemoryStream(file);
        JS.SaveAs(dl.db.ManutencaoDocumentos.Where(x => x.Id == id).First().Nome, ms.ToArray());

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }

    public void CustomizeCell(QueryCellInfoEventArgs<Schedule> args)
    {
        if (args.Column.HeaderText == "U")
        {
            switch (args.Data.Tipo)
            {
                case "Manutenção Reativa":
                    args.Cell.AddClass(new string[] { "manutencao-reativa" });
                    break;
                case "Manutenção Preventiva":
                    args.Cell.AddClass(new string[] { "manutencao-preventiva" });
                    break;
                case "Manutenção Programada":
                    args.Cell.AddClass(new string[] { "manutencao-programada" });
                    break;
                default:
                    break;
            }
        }
    }

