    {
        SUser = args.ItemData.kuser;
        OEE();
    }
    private async void LoadDataUser()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        try
        {
            //CARGAS
            var phistory = from rt in dl.db.ReferenciaTrabalhos
                           join reg in dl.db.Registos on rt.Lote equals reg.Lote
                           group reg by new
                           {
                               rt.Lote,
                               rt.Referencia,
                               rt.Ordemfabrico,
                               rt.Suspensao,
                               rt.Operador,
                               rt.Unidades,
                               rt.UnidadesMas,
                               rt.UnidadesTeoricas,
                               rt.AreaTotal,
                               rt.Descarga,
                               rt.Opcao1,
                               rt.Opcao2,
                               rt.Opcao4,
                               rt.LoteData
                           } into gr
                           where gr.Key.LoteData >= dti & gr.Key.LoteData <= dtf.Value.AddDays(1) & string.Compare(gr.Key.Referencia.ToUpper(), "") != 0
                           orderby gr.Max(t => t.TempoFinal) descending
                           select new dadosrt
                           {
                               Id = gr.Key.Lote + "|" + gr.Key.Referencia,
                               Lote = gr.Key.Lote,
                               OF = gr.Key.Ordemfabrico,
                               Suspensao = gr.Key.Suspensao,
                               Referencia = gr.Key.Referencia,
                               Operador = gr.Key.Operador,
                               Inicio = gr.Min(t => t.TempoInicial),
                               Fim = gr.Max(t => t.TempoFinal),
                               Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                               Unidades = gr.Key.Unidades,
                               Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                               Mas = gr.Key.UnidadesMas,
                               Teoricas = gr.Key.UnidadesTeoricas,
                               Area = gr.Key.AreaTotal,
                               LoteData = gr.Key.LoteData
                           };
            var dados = await phistory.ToListAsync();

            //GRÁFICO DE CARGAS POR DIA/HORA
            if (dti.Value.Date == dtf.Value.Date)
            {
                var pdiaUserb = from rt in dados
                                where rt.Operador == SUser
                                group rt by new { rt.LoteData.Value.Hour } into gr
                                orderby gr.Min(t => t.LoteData.Value.Hour)
                                select new AreaChartData { Hora = gr.Key.Hour.ToString(), Num = gr.Count() };
                hsaUser = pdiaUserb.ToList();
                legenda = "Hora";
            }
            else
            {
                var pdiaUserb = from rt in dados
                                where rt.Operador == SUser
                                group rt by new { rt.LoteData.Value.Day } into gr
                                orderby gr.Min(t => t.LoteData.Value.Day)
                                select new AreaChartData { Hora = gr.Key.Day.ToString(), Num = gr.Count() };
                hsaUser = pdiaUserb.ToList();
                legenda = "Dia";
            }


            //GRÁFICO TOP USERS
            var pdiaTopUser = from rt in dados
                              group rt by new { rt.Operador } into gr
                              orderby gr.Count()
                              select new AreaChartData { Hora = gr.Key.Operador.ToString(), Num = gr.Count() };
            qTopChart = pdiaTopUser.ToList();
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Erro ao carregar LoadDataUser: {ex.Message} \n {ex.StackTrace}");
        }
        finally
        {
            isupdating = false;
            await SpinnerObj.HideAsync();
            StateHasChanged();
            dl.Dispose();
        }

    }


