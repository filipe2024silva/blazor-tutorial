        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        //geral
        uHI = DateTime.Parse(dl.db.Configs.First(x => x.Name == "HorarioInicio").Value);
        uHF = DateTime.Parse(dl.db.Configs.First(x => x.Name == "HorarioFim").Value);
        uHT = int.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEturno")).Value);
        uProdObj = int.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEcargas")).Value);
        uPercObj = int.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEobjetivo")).Value);

        //turno
        var setTurnos = dl.db.Configs.
                        Where(w => EF.Functions.Like(w.Name, "OEETurnoH%"));
        var SettingsTurno = await setTurnos.ToListAsync();

            Turno1Hi = DateTime.Parse(SettingsTurno[0].Value.Split("#")[0]);
            //Turno2Hi = DateTime.Parse(SettingsTurno[1].Value.Split("#")[0]);

            Turno1NH = int.Parse(SettingsTurno[0].Value.Split("#")[1]);
            // Turno2NH = int.Parse(SettingsTurno[1].Value.Split("#")[1]);
        

        PopupConfigs = true;
        StateHasChanged();
        dl.Dispose();
    }
    private async void SavePopupConfigs()
    {
        DataLink_L1 dl = new DataLink_L1();

        //geral
        dl.db.Configs.First(x => x.Name == "HorarioInicio").Value = uHI.ToShortTimeString();
        dl.db.Configs.First(x => x.Name == "HorarioFim").Value = uHF.ToShortTimeString();
        dl.db.Configs.First(x => x.Name == "OEEturno").Value = uHT.ToString();
        dl.db.Configs.First(x => x.Name == "OEEcargas").Value = uProdObj.ToString();
        dl.db.Configs.First(x => x.Name == "OEEobjetivo").Value = uPercObj.ToString();

        //turno
        var setTurnos = dl.db.Configs.
                        Where(w => EF.Functions.Like(w.Name, "OEETurnoH%"));
        var SettingsTurno = await setTurnos.ToListAsync();
        SettingsTurno[0].Value = Turno1Hi.ToShortTimeString() + "#" + Turno1NH.ToString();
       // SettingsTurno[1].Value = Turno2Hi.ToShortTimeString() + "#" + Turno2NH.ToString();

        await dl.db.SaveChangesAsync();
        PopupConfigs = false;
        utils.UserLog($"Alterou as configurações OEE/Turno na Base de Dados", "DataLink_L1");

        SearchData();

        StateHasChanged();
        dl.Dispose();
    }

