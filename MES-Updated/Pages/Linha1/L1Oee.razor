        {
            //TURNO
            var setTurnos = dl.db.Configs.Where(w => EF.Functions.Like(w.Name, "OEETurnoH%"));
            var SettingsTurno = await setTurnos.ToListAsync();

            var turnoselected = STurno;
            DateTime dt1Turno;
            DateTime dt2Turno;
            decimal horasturno = Decimal.Parse(turnoselected.Split("#")[1]);
            if (dti == DateTime.Today)
            {
                dt1Turno = DateTime.Parse(DateTime.Now.ToShortDateString() + " " + turnoselected.Split("#")[0]);
                dt2Turno = DateTime.Parse(DateTime.Now.ToShortDateString() + " " + turnoselected.Split("#")[0]).AddHours(double.Parse(turnoselected.Split("#")[1]));

            }
            else
            {
                dt1Turno = DateTime.Parse(dti.Value.Date.ToShortDateString() + " " + turnoselected.Split("#")[0]);
                dt2Turno = DateTime.Parse(dtf.Value.Date.ToShortDateString() + " " + turnoselected.Split("#")[0]).AddHours(double.Parse(turnoselected.Split("#")[1]));
            }

            //CARREGA PRODUÇÃO TOTAL
            var phistory = from rt in dl.db.ReferenciaTrabalhos
                           join reg in dl.db.Registos on rt.Lote equals reg.Lote
                           group reg by new
                           {
                               rt.Lote,
                               rt.Referencia,
                               rt.Ordemfabrico,
                               rt.Suspensao,
                               rt.Operador,
                               rt.Unidades,
                               rt.UnidadesMas,
                               rt.UnidadesTeoricas,
                               rt.AreaTotal,
                               rt.Descarga,
                               rt.LoteData
                           } into gr
                           where gr.Key.LoteData >= dt1Turno && gr.Key.LoteData <= dt2Turno
                           orderby gr.Max(t => t.TempoFinal) descending
                           select new dadosrt
                           {
                               Id = gr.Key.Lote + "|" + gr.Key.Referencia,
                               Lote = gr.Key.Lote,
                               OF = gr.Key.Ordemfabrico,
                               Suspensao = gr.Key.Suspensao,
                               Referencia = gr.Key.Referencia,
                               Operador = gr.Key.Operador,
                               Inicio = gr.Min(t => t.TempoInicial),
                               Fim = gr.Max(t => t.TempoFinal),
                               Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                               Unidades = gr.Key.Unidades,
                               Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                               Mas = gr.Key.UnidadesMas,
                               Teoricas = gr.Key.UnidadesTeoricas,
                               Area = gr.Key.AreaTotal,
                               LoteData = gr.Key.LoteData
                           };
            var dados = await phistory.ToListAsync();

            //CARREGA PRODUÇÃO TURNO
            var pQualTurno = from rt in dl.db.ReferenciaTrabalhos
                             join reg in dl.db.Registos on rt.Lote equals reg.Lote
                             group reg by new
                             {
                                 rt.Lote,
                                 rt.Referencia,
                                 rt.Ordemfabrico,
                                 rt.Suspensao,
                                 rt.Operador,
                                 rt.Unidades,
                                 rt.UnidadesMas,
                                 rt.UnidadesTeoricas,
                                 rt.AreaTotal,
                                 rt.Descarga,
                                 rt.LoteData
                             } into gr
                             where gr.Key.LoteData >= dt1Turno
                             & gr.Key.LoteData <= dt2Turno
                             && string.Compare(gr.Key.Referencia.ToUpper(), "") != 0
                             select new dadosrt
                             {
                                 Id = gr.Key.Lote + "|" + gr.Key.Referencia,
                                 Lote = gr.Key.Lote,
                                 OF = gr.Key.Ordemfabrico,
                                 Suspensao = gr.Key.Suspensao,
                                 Referencia = gr.Key.Referencia,
                                 Operador = gr.Key.Operador,
                                 Inicio = gr.Min(t => t.TempoInicial),
                                 Fim = gr.Max(t => t.TempoFinal),
                                 Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                                 Unidades = gr.Key.Unidades,
                                 Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                                 Mas = gr.Key.UnidadesMas,
                                 Teoricas = gr.Key.UnidadesTeoricas,
                                 Area = gr.Key.AreaTotal,
                                 LoteData = gr.Key.LoteData
                             };
            var dadosTurno = await pQualTurno.ToListAsync();

            //CARGAS POR DIA
            var pdiaT = from rt in dados
                        where string.Compare(rt.Referencia.ToUpper(), "") != 0
                        group rt by new { rt.Fim.Value.Date } into gr
                        orderby gr.Min(t => t.Fim.Value.Date)
                        select new { Dia = gr.Key.Date.ToShortDateString(), Num = gr.Count() };
            var CargasDia = pdiaT.ToList();

            //GRÁFICO DE CARGAS POR DIA/HORA
            int contaturno = 0;
            decimal horastotais = 0;
            foreach (var turno in SettingsTurno)
            {
                DateTime tit = DateTime.Parse(dti.Value.Date.ToShortDateString() + " " + turno.Value.Split("#")[0]);
                DateTime tft = DateTime.Parse(dtf.Value.Date.ToShortDateString() + " " + turno.Value.Split("#")[0]).AddHours(double.Parse(turno.Value.Split("#")[1]));

                int horah = int.Parse(turno.Value.Split("#")[0].Split(":")[0]);
                int horam = int.Parse(turno.Value.Split("#")[0].Split(":")[1]);
                double ht = double.Parse(turno.Value.Split("#")[1]);

                var pdiaTurnoDia = from rt in dados
                                   where rt.Fim >= tit & rt.Fim < tft & rt.Fim.Value >= DateTime.Parse(rt.Fim.Value.ToShortDateString() + " " + horah + ":" + horam) & rt.Fim.Value <= DateTime.Parse(rt.Fim.Value.ToShortDateString() + " " + horah + ":" + horam).AddHours(ht) & rt.Referencia.ToUpper() != ""
                                   group rt by new { rt.Fim.Value.Date } into gr
                                   orderby gr.Min(t => t.Fim.Value.Date)
                                   select new AreaChartData { Hora = gr.Key.Date.ToShortDateString(), Num = gr.Count() };
                var dadosdiaTurno = pdiaTurnoDia.ToList();
                horastotais += decimal.Parse(turno.Value.Split("#")[1]);
                contaturno += 1;
                switch (contaturno)
                {
                    case 1:
                        hsaTurnoDiaT1 = dadosdiaTurno;
                        break;
                    case 2:
                        hsaTurnoDiaT2 = dadosdiaTurno;
                        break;
                    case 3:
                        hsaTurnoDiaT3 = dadosdiaTurno;
                        break;
                    default:
                        break;
                }
            }

            //CARGAS
            var pdiaTurno = from rt in dadosTurno
                            where rt.LoteData >= dt1Turno & rt.LoteData < dt2Turno & rt.LoteData.Value >= DateTime.Parse(rt.LoteData.Value.ToShortDateString() + " " + dt1Turno.Hour + ":" + dt1Turno.Minute) & rt.LoteData.Value <= DateTime.Parse(rt.LoteData.Value.ToShortDateString() + " " + dt1Turno.Hour + ":" + dt1Turno.Minute).AddHours(double.Parse(horasturno.ToString())) && string.Compare(rt.Referencia.ToUpper(), "") != 0
                            group rt by new { rt.LoteData.Value.Day } into gr
                            select new { Num = gr.Count() };
            var CargasDiaTurno = pdiaTurno.ToList();


            //CARREGA PAUSAS
            var pPausasTurno = from rt in dl.db.OeeStops
                               where rt.TempoInicial >= dt1Turno & rt.TempoFinal <= dt2Turno
                               & rt.TempoFinal.Value.Hour >= dt1Turno.Hour & dt1Turno.Minute >= dt1Turno.Minute
                               & rt.TempoFinal.Value.Hour <= dt2Turno.Hour & dt2Turno.Minute <= dt2Turno.Minute
                               select new
                               {
                                   ti = rt.TempoInicial,
                                   tf = rt.TempoFinal,
                                   tt = rt.TempoFinal.Value.Subtract(rt.TempoInicial.Value),
                                   Ocorrencia = rt.Ocorrencia
                               };
            var PausasTurno = await pPausasTurno.ToListAsync();


            //#################
            //OEE
            //#################
            DateTime hinicioTurno;
            DateTime hfimTurno;
            decimal ndispTurno;
            decimal ndesempTurno;
            decimal nqualTurno;

            //DISPONIBILIDADE
            decimal uturnoTurno;
            hinicioTurno = dt1Turno;
            hfimTurno = dt2Turno;
            //verifica se é ou não tempo real
            if (dti.Value.Date == DateTime.Today.Date)
            {
                if (DateTime.Now >= hinicioTurno && DateTime.Now <= hfimTurno)
                {
                    hfimTurno = DateTime.Now;
                }
                uturnoTurno = (decimal)((hfimTurno - hinicioTurno).TotalHours);
            }
            else
            {
                if (dtf.Value.Date == DateTime.Today.Date)
                {
                    if (DateTime.Now >= DateTime.Parse(DateTime.Now.ToShortDateString() + " " + dt1Turno.ToShortTimeString()) && DateTime.Now <= DateTime.Parse(DateTime.Now.ToShortDateString() + " " + dt2Turno.ToShortTimeString()))
                    {
                        uturnoTurno = (CargasDia.Count * horasturno) - (DateTime.Parse(DateTime.Now.ToShortDateString() + " " + dt1Turno.ToShortTimeString()).AddHours(dt2Turno.Hour - DateTime.Now.Hour).Hour);
                    }
                    else
                    {
                        uturnoTurno = CargasDia.Count * horasturno;
                    }
                }
                else
                {
                    uturnoTurno = CargasDia.Count * horasturno;
                }
            }

            decimal upausaTurno = (decimal)PausasTurno.Sum(z => z.tt.TotalHours);
            var tprodTurno = uturnoTurno - upausaTurno;
            if (uturnoTurno > 0)
            {
                ndispTurno = Math.Round(tprodTurno / uturnoTurno * 100, 1);
            }
            else
            {
                ndispTurno = 100;
            }
            disppieChartTurno.Clear();
            //disppieChartTurno.Add("Disponibilidade", Math.Round(ndispTurno, 1));
            disppieChartTurno.Add(new KVPStringDecimal("Disponibilidade", Math.Round(ndispTurno, 1)));

            if (ndispTurno < 100)
            {
                //disppieChartTurno.Add("Perda", 100 - Math.Round(ndispTurno, 1));
                disppieChartTurno.Add(new KVPStringDecimal("Perda", 100 - Math.Round(ndispTurno, 1)));
            }
            else
            {
                //disppieChartTurno.Add("Perda", 0);
                disppieChartTurno.Add(new KVPStringDecimal("Perda", 0));
            }


            //DESEMPENHO
            decimal urealTurno = CargasDiaTurno.Sum(x => x.Num);
            decimal uteoricaTurno = decimal.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEcargas")).Value);
            if (urealTurno > 0 && uteoricaTurno > 0 && uturnoTurno > 0)
            {
                ndesempTurno = Math.Round((urealTurno / (uturnoTurno * uteoricaTurno)) * 100, 1);
            }
            else
            {
                ndesempTurno = 100;
            }
            desemppieChartTurno.Clear();
            //desemppieChartTurno.Add("Desempenho", Math.Round(ndesempTurno, 1));
            desemppieChartTurno.Add(new KVPStringDecimal("Desempenho", Math.Round(ndesempTurno, 1)));
            if (ndesempTurno < 100)
            {
                //desemppieChartTurno.Add("Perda", 100 - Math.Round(ndesempTurno, 1));
                desemppieChartTurno.Add(new KVPStringDecimal("Perda", 100 - Math.Round(ndesempTurno, 1)));
            }
            else
            {
                //desemppieChartTurno.Add("Perda", 0);
                desemppieChartTurno.Add(new KVPStringDecimal("Perda", 0));
            }


            //QUALIDADE
            decimal uboasTurno = (decimal)dadosTurno.Sum(x => x.Boas);
            decimal utodasTurno = (decimal)dadosTurno.Sum(x => x.Unidades);
            if (uboasTurno > 0 && utodasTurno > 0)
            {
                nqualTurno = Math.Round(uboasTurno / utodasTurno * 100, 1);
            }
            else
            {
                nqualTurno = 100;
            }
            qpieChartTurno.Clear();
            //qpieChartTurno.Add("Qualidade", Math.Round(nqualTurno, 1));
            qpieChartTurno.Add(new KVPStringDecimal("Qualidade", Math.Round(nqualTurno, 1)));
            if (nqualTurno < 100)
            {
                //qpieChartTurno.Add("Perda", 100 - Math.Round(nqualTurno, 1));
                qpieChartTurno.Add(new KVPStringDecimal("Perda", 100 - Math.Round(nqualTurno, 1)));
            }
            else
            {
                //qpieChartTurno.Add("Perda", 0);
                qpieChartTurno.Add(new KVPStringDecimal("Perda", 0));
            }


            //OEE
            decimal uoeeTurno = ((ndispTurno / 100) * (ndesempTurno / 100) * (nqualTurno / 100)) * 100;
            oeepieChartTurno.Clear();
            //oeepieChartTurno.Add("OEE", Math.Round(uoeeTurno, 1));
            oeepieChartTurno.Add(new KVPStringDecimal("OEE", Math.Round(uoeeTurno, 1)));
            if (uoeeTurno < 100)
            {
                //oeepieChartTurno.Add("Perda", 100 - Math.Round(uoeeTurno, 1));
                oeepieChartTurno.Add(new KVPStringDecimal("Perda", 100 - Math.Round(uoeeTurno, 1)));
            }
            else
            {
                //oeepieChartTurno.Add("Perda", 0);
                oeepieChartTurno.Add(new KVPStringDecimal("Perda", 0));
            }


            //DADOS
            nTurnoTurno = Math.Round(uturnoTurno, 2).ToString();
            nTOperacionalTurno = Math.Round((uturnoTurno * 60), 1).ToString();
            HnTOperacionalTurno = TimeSpan.FromMinutes((double)uturnoTurno * 60).ToString("dd\\.hh\\:mm\\:ss");
            nTProdTurno = Math.Round((tprodTurno * 60), 1).ToString();
            HnTProdTurno = TimeSpan.FromMinutes((double)tprodTurno * 60).ToString("dd\\.hh\\:mm\\:ss");
            nTStopTurno = Math.Round((upausaTurno * 60), 1).ToString();
            HnTStopTurno = TimeSpan.FromMinutes((double)upausaTurno * 60).ToString("dd\\.hh\\:mm\\:ss");
            nProdTurno = urealTurno.ToString();
            nProdTeoTurno = Math.Round((uturnoTurno * uteoricaTurno), 1).ToString();
            nPerdasTurno = Math.Round(((uturnoTurno * uteoricaTurno) - urealTurno), 1).ToString();
            nConfTurno = uboasTurno.ToString();
            nNConfTurno = (utodasTurno - uboasTurno).ToString();

            LoadDataUser();
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Erro ao carregar LoadDataTurno: {ex.Message} \n {ex.StackTrace}");
        }
        finally
        {
            dl.Dispose();
        }

    }


