    private async void LoadComboUser()
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var setUsers = dl.db.Users.Where(u=> u.Username.ToUpper() != "F10" && u.Username.ToUpper() != "FORMULA DECIMAL").Select(u => new { username = u.Username.ToUpper() }).Distinct().OrderBy(ord => ord.username);
        var SettingsUsers = await setUsers.ToListAsync();

        //user logado
        var puser = dl.db.Users.Where(u => u.Comportamento.ToUpper() == "LOGIN").OrderByDescending(l => l.Tempo).Take(1);
        var dadosuser = await puser.ToListAsync();
        if (dadosuser.Count > 0)
        {
            foreach (var duser in SettingsUsers)
            {
                userrt useritem = new userrt();
                useritem.kuser = duser.username;
                useritem.vuser = duser.username;
                SelUser.Add(useritem);

                if (dadosuser.First().Username.ToUpper() == duser.username.ToUpper())
                {
                    SUser = duser.username.ToUpper();
                }
            }
        }

        dl.Dispose();
    }
