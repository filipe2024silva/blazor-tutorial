@code {
    SfSpinner SpinnerObj = new SfSpinner();

    bool dbchecked = false, dbcheckedoff = false;
    public bool isupdating = false;
    public DateTime? dti { get; set; } = DateTime.Today;
    public DateTime? dtf { get; set; } = DateTime.Today;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == true)
        {
            GetDB();
        }
        base.OnAfterRender(firstRender);
    }

    private async void GetDB()
    {
        DataLink_L1 DL1 = new DataLink_L1();

        if (await DL1.db.Database.CanConnectAsync())
        {
            utils.L1ON = true;
            dbchecked = true;
            dbcheckedoff = false;
            DL1.Dispose();
            StateHasChanged();
            LoadComboTurno();
            LoadComboUser();
            SearchData();
        }
        else
        {
            utils.L1ON = false;
            dbchecked = false;
            dbcheckedoff = true;
            DL1.Dispose();
            StateHasChanged();
        }
    }
    private async void SearchData()
    {
        isupdating = true;
        await SpinnerObj.ShowAsync();
        OEE();

        isupdating = false;
    }

    //OEE
    public List<dadosrt> RefsTrabalho = new List<dadosrt>() { };
    public List<AreaChartData> ChartData = new List<AreaChartData> { };
    public string nTurno;
    public string nTOperacional;
    public string HnTOperacional;
    public string nTProd;
    public string HnTProd;
    public string nTStop;
    public string HnTStop;
    public string nProd;
    public string nProdTeo;
    public string nPerdas;
    public string nConf;
    public string nNConf;
    public List<KVPStringDecimal> disppieChart = new List<KVPStringDecimal> { };
    public List<KVPStringDecimal> desemppieChart = new List<KVPStringDecimal> { };
    public List<KVPStringDecimal> qpieChart = new List<KVPStringDecimal> { };
    public List<KVPStringDecimal> oeepieChart = new List<KVPStringDecimal> { };
    private async void OEE()
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        try
        {
            RefsTrabalho.Clear();
            ChartData.Clear();

            //CARREGA PRODUÇÃO
            var phistory = from rt in dl.db.ReferenciaTrabalhos
                           join reg in dl.db.Registos on rt.Lote equals reg.Lote
                           group reg by new
                           {
                               rt.Lote,
                               rt.Referencia,
                               rt.Ordemfabrico,
                               rt.Suspensao,
                               rt.Operador,
                               rt.Unidades,
                               rt.UnidadesMas,
                               rt.UnidadesTeoricas,
                               rt.AreaTotal,
                               rt.Descarga,
                               rt.LoteData
                           } into gr
                           where gr.Key.LoteData >= dti && gr.Key.LoteData <= dtf.Value.AddDays(1)
                           orderby gr.Max(t => t.TempoFinal) descending
                           select new dadosrt
                           {
                               Id = gr.Key.Lote + "|" + gr.Key.Referencia,
                               Lote = gr.Key.Lote,
                               OF = gr.Key.Ordemfabrico,
                               Suspensao = gr.Key.Suspensao,
                               Referencia = gr.Key.Referencia,
                               Operador = gr.Key.Operador,
                               Inicio = gr.Min(t => t.TempoInicial),
                               Fim = gr.Max(t => t.TempoFinal),
                               Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                               Unidades = gr.Key.Unidades,
                               Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                               Mas = gr.Key.UnidadesMas,
                               Teoricas = gr.Key.UnidadesTeoricas,
                               Area = gr.Key.AreaTotal,
                               LoteData = gr.Key.LoteData

                           };
            var dados = await phistory.ToListAsync();
            RefsTrabalho = dados;

            //GRÁFICO NUMERO DE BARRAS POR HORA
            List<AreaChartData> ac = new List<AreaChartData>() { };
            var dadosdia = dados.Where(ca => ca.Referencia != "").GroupBy(gr => gr.LoteData.Value.Hour).OrderBy(or => or.Key);
            foreach (var item in dadosdia)
            {
                AreaChartData aci = new AreaChartData()
                {
                    Hora = item.Key.ToString(),
                    Ordem = item.Key,
                    Num = item.Count(),
                };
                ac.Add(aci);
            }
            ChartData = ac;

            for (int i = 0; i < 23; i++)
            {
                if (ac.Where(z => z.Ordem == i).Count() == 0)
                {
                    ac.Add(new AreaChartData { Ordem = i, Hora = i.ToString("D2"), Num = 0 });
                }
            }
            ChartData = ac.OrderBy(bitch => bitch.Ordem).ToList();


            //CARGAS POR DIA
            var pdiaT = from rt in dados
                        where string.Compare(rt.Referencia.ToUpper(), "") != 0
                        group rt by new { rt.LoteData } into gr
                        orderby gr.Min(t => t.LoteData)
                        select new { Dia = gr.Key.ToString(), Num = gr.Count() };
            var CargasDia = pdiaT.ToList();


            //CARREGA PAUSAS
            var pPausasT = from rt in dl.db.OeeStops
                           where rt.TempoInicial >= dti & rt.TempoInicial <= dtf.Value.AddDays(1)
                           select new
                           {
                               ti = rt.TempoInicial,
                               tf = rt.TempoFinal,
                               tt = rt.TempoFinal.Value.Subtract(rt.TempoInicial.Value),
                               Ocorrencia = rt.Ocorrencia
                           };
            var PausasDia = await pPausasT.ToListAsync();


            //#################
            //OEE
            //#################
            string hinicio;
            string hfim;
            decimal ndisp;
            decimal ndesemp;
            decimal nqual;

            //DISPONIBILIDADE
            decimal uturno;
            //verifica se é ou não tempo real
            if (dti == DateTime.Today && dtf == DateTime.Today)
            {
                hinicio = (await dl.db.Configs.Where(x => x.Name == "HorarioInicio").FirstAsync()).Value;
                hfim = (await dl.db.Configs.Where(x => x.Name == "HorarioFim").FirstAsync()).Value;

                if (DateTime.Now.Hour >= DateTime.Parse(hinicio).Hour && DateTime.Now.Hour <= DateTime.Parse(hfim).Hour)
                {
                    hfim = DateTime.Now.ToShortTimeString();
                    uturno = (decimal)(TimeSpan.Parse(hfim) - TimeSpan.Parse(hinicio)).TotalHours;
                }
                else
                {
                    uturno = decimal.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEturno")).Value);
                }
            }
            else
            {
                uturno = decimal.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEturno")).Value) * CargasDia.Count;
            }

            decimal upausa = (decimal)PausasDia.Sum(z => z.tt.TotalHours);
            var tprod = uturno - upausa;
            if (uturno > 0)
            {
                ndisp = Math.Round(tprod / uturno * 100, 1);
            }
            else
            {
                ndisp = 100;
            }
            List<KVPStringDecimal> iidisp = new List<KVPStringDecimal>();
            //iidisp.Add("Disponibilidade", Math.Round(ndisp, 1));
            iidisp.Add(new KVPStringDecimal("Disponibilidade", Math.Round(ndisp, 1)));

            if (ndisp < 100)
            {
                //iidisp.Add("Perda", 100 - Math.Round(ndisp, 1));
                iidisp.Add(new KVPStringDecimal("Perda", 100 - Math.Round(ndisp, 1)));
            }
            else
            {
                //iidisp.Add("Perda", 0);
                iidisp.Add(new KVPStringDecimal("Perda", 0));
            }
