    private DateTime dHI;
    private DateTime dHF;
    private string dOcorrencia;
    private string selid = "";
    private async void OpenPopupParagens()
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var pausasQ = dl.db.OeeStops.Where(x => x.TempoInicial >= PausaDT.Value && x.TempoInicial < PausaDT.Value.AddDays(1)).
                            Select(q => new paragensrt { Id = q.Id.ToString(), Inicio = q.TempoInicial, Fim = q.TempoFinal, Tempo = (q.TempoFinal - q.TempoInicial).ToString(), Descrição = q.Ocorrencia });
        PausasDia = await pausasQ.ToListAsync();

        PopupParagens = true;
        StateHasChanged();
        dl.Dispose();
    }
    private void Pausas_Add()
    {
        selid = "";
        dHI = DateTime.Now;
        dHF = DateTime.Now;
        dOcorrencia = "";

        PopupParagensEditor = true;
        StateHasChanged();
    }
    private void Pausas_Edit(string id)
    {
        selid = id;

        dHI = PausasDia.First(x => x.Id == id).Inicio.Value;
        dHF = PausasDia.First(x => x.Id == id).Fim.Value;
        dOcorrencia = PausasDia.First(x => x.Id == id).Descrição;

        PopupParagensEditor = true;
        StateHasChanged();
    }
    private async void Pausas_Save()
    {
        DataLink_L1 dl = new DataLink_L1();

        if (selid == "")
        {
            dl.db.OeeStops.Add(new sv.data.OeeStop { TempoInicial = DateTime.Parse(PausaDT.Value.ToShortDateString() + " " + dHI.ToShortTimeString()), TempoFinal = DateTime.Parse(PausaDT.Value.ToShortDateString() + " " + dHF.ToShortTimeString()), Ocorrencia = dOcorrencia });
        }
        else
        {
            dl.db.OeeStops.First(x => x.Id == int.Parse(selid)).TempoInicial = DateTime.Parse(PausaDT.Value.ToShortDateString() + " " + dHI.ToShortTimeString());
            dl.db.OeeStops.First(x => x.Id == int.Parse(selid)).TempoFinal = DateTime.Parse(PausaDT.Value.ToShortDateString() + " " + dHF.ToShortTimeString());
            dl.db.OeeStops.First(x => x.Id == int.Parse(selid)).Ocorrencia = dOcorrencia;
        }

        await dl.db.SaveChangesAsync();
        PopupParagensEditor = false;
        utils.UserLog($"Inseriu uma paragem no OEE", "DataLink_L1");

        OpenPopupParagens();
        dl.Dispose();
    }
    private async void Pausas_Delete(string id)
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.OeeStops.Remove(dl.db.OeeStops.First(x => x.Id == int.Parse(id)));

        await dl.db.SaveChangesAsync();
        PopupParagensEditor = false;
        utils.UserLog($"Eliminou uma paragem no OEE", "DataLink_L1");

        OpenPopupParagens();
        dl.Dispose();
    }
    private void Pausas_Close()
    {
        PopupParagens = false;
        SearchData();
    }


