    private async void Historico()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        try
        {
            histdisp.Clear();
            histdesemp.Clear();
            histqual.Clear();
            histoee.Clear();

            //CARREGA PRODUÇÃO
            var phistory = from rt in dl.db.ReferenciaTrabalhos
                           join reg in dl.db.Registos on rt.Lote equals reg.Lote
                           group reg by new
                           {
                               rt.Lote,
                               rt.Referencia,
                               rt.Ordemfabrico,
                               rt.Suspensao,
                               rt.Operador,
                               rt.Unidades,
                               rt.UnidadesMas,
                               rt.UnidadesTeoricas,
                               rt.AreaTotal,
                               rt.Descarga,
                               rt.LoteData
                           } into gr
                           where gr.Key.LoteData >= dti && gr.Key.LoteData <= dtf.Value.AddDays(1)
                           orderby gr.Max(t => t.TempoFinal) descending
                           select new dadosrt
                           {
                               Id = gr.Key.Lote + "|" + gr.Key.Referencia,
                               Lote = gr.Key.Lote,
                               OF = gr.Key.Ordemfabrico,
                               Suspensao = gr.Key.Suspensao,
                               Referencia = gr.Key.Referencia,
                               Operador = gr.Key.Operador,
                               Inicio = gr.Min(t => t.TempoInicial),
                               Fim = gr.Max(t => t.TempoFinal),
                               Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                               Unidades = gr.Key.Unidades,
                               Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                               Mas = gr.Key.UnidadesMas,
                               Teoricas = gr.Key.UnidadesTeoricas,
                               Area = gr.Key.AreaTotal,
                               LoteData = gr.Key.LoteData
                           };
            var dados = await phistory.ToListAsync();


            //CARGAS POR DIA
            var pdiaT = from rt in dados
                        where string.Compare(rt.Referencia.ToUpper(), "") != 0
                        group rt by new { rt.Fim.Value.Date } into gr
                        orderby gr.Min(t => t.Fim.Value.Date)
                        select new
                        {
                            Dia = gr.Key.Date.ToShortDateString(),
                            Num = gr.Count()
                        };
            var CargasDia = pdiaT.ToList();


            //CARREGA PAUSAS
            var pPausasT = from rt in dl.db.OeeStops
                           where rt.TempoInicial >= dti & rt.TempoFinal <= dtf.Value.AddDays(1)
                           select new
                           {
                               ti = rt.TempoInicial,
                               tf = rt.TempoFinal,
                               tt = rt.TempoFinal.Value.Subtract(rt.TempoInicial.Value),
                               Ocorrencia = rt.Ocorrencia
                           };
            var PausasDia = await pPausasT.ToListAsync();


            string hinicio;
            string hfim;
            decimal uturno;
            decimal uteorica = decimal.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEcargas")).Value);
            hinicio = (await dl.db.Configs.Where(x => x.Name == "HorarioInicio").FirstAsync()).Value;
            hfim = (await dl.db.Configs.Where(x => x.Name == "HorarioFim").FirstAsync()).Value;
            uturno = decimal.Parse((await dl.db.Configs.FirstAsync(x => x.Name == "OEEturno")).Value);

            foreach (var row in CargasDia)
            {
                //disponibilidade
                decimal ndisp;
                decimal ndesemp;
                decimal nqual;
                decimal upausa = (decimal)PausasDia.Where(y => y.ti >= DateTime.Parse(row.Dia) && y.tf < DateTime.Parse(row.Dia).AddDays(1)).Sum(z => z.tt.TotalHours);
                decimal tprod = uturno - upausa;

                if (uturno > 0)
                {
                    ndisp = Math.Round(tprod / uturno * 100, 1);
                }
                else
                {
                    ndisp = 100;
                }
                histdisp.Add(new KVPStringDecimal(DateTime.Parse(row.Dia).ToShortDateString(), ndisp));

                //desempenho
                decimal ureal = row.Num;
                if (ureal > 0 && uteorica > 0 && uturno > 0)
                {
                    ndesemp = Math.Round((ureal / (uturno * uteorica) * 100), 1);
                }
                else
                {
                    ndesemp = 100;
                }
                histdesemp.Add(new KVPStringDecimal(DateTime.Parse(row.Dia).ToShortDateString(), ndesemp));

                //qualidade
                decimal uboas = (decimal)dados.Where(y => y.Fim >= DateTime.Parse(row.Dia) && y.Fim < DateTime.Parse(row.Dia).AddDays(1)).Sum(x => x.Boas);
                decimal utodas = (decimal)dados.Where(y => y.Fim >= DateTime.Parse(row.Dia) && y.Fim < DateTime.Parse(row.Dia).AddDays(1)).Sum(x => x.Unidades);
                if (uboas > 0 && utodas > 0)
                {
                    nqual = Math.Round(uboas / utodas * 100, 1);
                }
                else
                {
                    nqual = 100;
                }
                histqual.Add(new KVPStringDecimal(DateTime.Parse(row.Dia).ToShortDateString(), nqual));

                //oee
                decimal uoee = Math.Round(((ndisp / 100) * (ndesemp / 100) * (nqual / 100)) * 100, 1);
                histoee.Add(new KVPStringDecimal(DateTime.Parse(row.Dia).ToShortDateString(), uoee));
            }

            //estatísticas
            oldDispChart.Clear();
            oldDesempChart.Clear();
            oldQualChart.Clear();
            calcoeeChart.Clear();
            if (histoee.Count > 0)
            {
                //oee
                calcoeeChart.Add(new KVPStringDecimal("OEE", Math.Round(histoee.Average(h => h.Value), 1)));
                if (histoee.Average(h => h.Value) < 100)
                {
                    calcoeeChart.Add(new KVPStringDecimal("Perda", 100 - Math.Round(histoee.Average(h => h.Value), 1)));
                }
                else
                {
                    calcoeeChart.Add(new KVPStringDecimal("Perda", 0));
                }
                DifCalcOEE = Math.Round(Math.Abs(Math.Round(histoee.Average(h => h.Value), 1) - oldoee), 1);
                if (Math.Round(histoee.Average(h => h.Value), 1) - oldoee < 0)
                {
                    setaCalcoee = false;
                }
                else
                {
                    setaCalcoee = true;
                }
                DevCalcOEE = Math.Round((decimal)calcVariance(histoee.Select(x => x.Value).ToArray(), Math.Round(histoee.Average(h => h.Value), 1), histoee.Count), 1);

                //disponibilidade
                DifCalcIDISP = Math.Round(Math.Abs(Math.Round(histdisp.Average(h => h.Value), 1) - olddisp), 1);
                if (Math.Round(histdisp.Average(h => h.Value), 1) - olddisp < 0)
                {
                    setaCalcIDISP = false;
                }
                else
                {
                    setaCalcIDISP = true;
                }
                DevCalcIDISP = Math.Round((decimal)calcVariance(histdisp.Select(x => x.Value).ToArray(), Math.Round(histdisp.Average(h => h.Value), 1), histdisp.Count), 1);
                oldDispChart.Add(new KVPStringDecimal("Disponibilidade", Math.Round(histdisp.Average(h => h.Value), 1)));

                //desempenho
                DifCalcIDESEMP = Math.Round(Math.Abs(Math.Round(histdesemp.Average(h => h.Value), 1) - oldesemp), 1);
                if (Math.Round(histdesemp.Average(h => h.Value), 1) - oldesemp < 0)
                {
                    setaCalcIDESEMP = false;
                }
                else
                {
                    setaCalcIDESEMP = true;
                }
                DevCalcIDESEMP = Math.Round((decimal)calcVariance(histdesemp.Select(x => x.Value).ToArray(), Math.Round(histdesemp.Average(h => h.Value), 1), histdesemp.Count), 1);
                oldDesempChart.Add(new KVPStringDecimal("Desempenho", Math.Round(histdesemp.Average(h => h.Value), 1)));

                //qualidade
                DifCalcIQUAL = Math.Round(Math.Abs(Math.Round(histqual.Average(h => h.Value), 1) - oldqual), 1);
                if (Math.Round(histqual.Average(h => h.Value), 1) - oldqual < 0)
                {
                    setaCalcIQUAL = false;
                }
                else
                {
                    setaCalcIQUAL = true;
                }

                DevCalcIQUAL = Math.Round((decimal)calcVariance(histqual.Select(x => x.Value).ToArray(), Math.Round(histqual.Average(h => h.Value), 1), histqual.Count), 1);
                oldQualChart.Add(new KVPStringDecimal("Qualidade", Math.Round(histqual.Average(h => h.Value), 1)));
            }
            else
            {
                calcoeeChart.Add(new KVPStringDecimal("OEE", 100));
                calcoeeChart.Add(new KVPStringDecimal("Perda", 0));
                DifCalcOEE = 0;
                setaCalcoee = true;
                DevCalcOEE = 0;
                DifCalcIDISP = 0;
                setaCalcIDISP = true;
                DevCalcIDISP = 0;
                oldDispChart.Add(new KVPStringDecimal("Disponibilidade", 100));
                DifCalcIDESEMP = 0;
                setaCalcIDESEMP = true;
                DevCalcIDESEMP = 0;
                oldDesempChart.Add(new KVPStringDecimal("Desempenho", 100));
                DifCalcIQUAL = 0;
                setaCalcIQUAL = true;
                DevCalcIQUAL = 0;
                oldQualChart.Add(new KVPStringDecimal("Qualidade", 100));
            }

            LoadDataTurno();
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Erro ao carregar Historico: {ex.Message}\n {ex.StackTrace}");
        }
        finally
        {
            dl.Dispose();
            await SpinnerObj.HideAsync();
            StateHasChanged();
        }

    }
    public double calcVariance(decimal[] Values, decimal Mean, int Days)
    {
        decimal Variance = 0;
        decimal TVariance = 0;
        foreach (decimal i in Values)
        {
            Variance += (decimal)(Math.Pow(((double)i - (double)Mean), 2));
        }
        TVariance = Variance / (decimal)Days;
        return (Math.Abs(Math.Sqrt((double)TVariance)));
    }


