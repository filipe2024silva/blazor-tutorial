@page "/linha1/oee"
@using System.Diagnostics

@inject NavigationManager NavigationManager
@inject Utils utils

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="() => { dbcheckedoff = false; GetDB(); }" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("OL1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 1 - OEE</h1>
                        @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                    </div>
                    <div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
                        <button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    </div>
                </div>

                <div class="row uniform">
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
                    </div>
                    <div class="4u 12u$(medium)">
                        <SfButton @onclick="SearchData">Pesquisar</SfButton>
                        <SfButton @onclick="OpenPopupConfigs" CssClass="pull-right" title="Configurações"><i class='icon style1 fa-cog'></i></SfButton>
                    </div>
                </div>



                <div class="row uniform">
                    <SfTab>
                        <TabItems>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="GERAL"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    @if (isupdating == false)
                                    {
                                        @if (RefsTrabalho != null && RefsTrabalho.Count > 0)
                                        {
                                            <div class="row uniform" style="margin-top:20px">
                                                <div class="6u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
                                                    <div class="row">
                                                        <div class="table-wrapper" style="width:100%">
                                                            <table>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>Turno (h)</td>
                                                                        <td>@nTurno</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tempo Operacional (m)</td>
                                                                        <td>@nTOperacional (@HnTOperacional h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tempo de Produção (m)</td>
                                                                        <td>@nTProd (@HnTProd h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>
                                                                            Tempo parado (m) <button class="button small special" @onclick="OpenPopupParagens" title="Gerir Paragens"><i class='icon style1 fa-cog'></i></button>
                                                                        </td>
                                                                        <td>@nTStop (@HnTStop h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Produção (cargas)</td>
                                                                        <td>@nProd</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Perdas (cargas)</td>
                                                                        <td>@nPerdas</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Unidades conformes</td>
                                                                        <td>@nConf</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Unidades não conformes</td>
                                                                        <td>@nNConf</td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="6u 12u$(medium) align-self-end" style="display: flex;justify-content:space-between;flex-direction:column">
                                                    @if (oeepieChart != null && oeepieChart.Count > 0)
                                                    {
                                                        <div class="row">
                                                            <div class="6u">
                                                                <SfAccumulationChart Title="OEE" Width="100%" Height="450" Theme="@utils.ctheme">
                                                                    <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                                                    </AccumulationChartLegendSettings>
                                                                    <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                                                    <AccumulationChartSeriesCollection>
                                                                        <AccumulationChartSeries DataSource="@oeepieChart.AsEnumerable()" XName="Key" YName="Value" Radius="90%" InnerRadius="40%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
                                                                            <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                                <AccumulationChartDataLabelFont FontWeight="600" Color="white"></AccumulationChartDataLabelFont>
                                                                            </AccumulationDataLabelSettings>
                                                                        </AccumulationChartSeries>
                                                                    </AccumulationChartSeriesCollection>
                                                                </SfAccumulationChart>
                                                            </div>
                                                            <div class="6u">
                                                                <SfAccumulationChart Title="Disponibilidade" Width="100%" Height="150" Theme="@utils.ctheme">
                                                                    <AccumulationChartTooltipSettings Enable="true"></AccumulationChartTooltipSettings>
                                                                    <AccumulationChartLegendSettings Visible="false"></AccumulationChartLegendSettings>
                                                                    <AccumulationChartSeriesCollection>
                                                                        <AccumulationChartSeries DataSource="@disppieChart.AsEnumerable()" XName="Key" YName="Value" StartAngle="270" EndAngle="90" Radius="90%" InnerRadius="40%" Explode="true">
                                                                            <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                                <AccumulationChartDataLabelFont FontWeight="600"></AccumulationChartDataLabelFont>
                                                                            </AccumulationDataLabelSettings>
                                                                        </AccumulationChartSeries>
                                                                    </AccumulationChartSeriesCollection>
                                                                </SfAccumulationChart>

                                                                <SfAccumulationChart Title="Desempenho" Width="100%" Height="150" Theme="@utils.ctheme">
                                                                    <AccumulationChartTooltipSettings Enable="true"></AccumulationChartTooltipSettings>
                                                                    <AccumulationChartLegendSettings Visible="false"></AccumulationChartLegendSettings>
                                                                    <AccumulationChartSeriesCollection>
                                                                        <AccumulationChartSeries DataSource="@desemppieChart.AsEnumerable()" XName="Key" YName="Value" StartAngle="270" EndAngle="90" Radius="90%" InnerRadius="40%" Explode="true">
                                                                            <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                                <AccumulationChartDataLabelFont FontWeight="600"></AccumulationChartDataLabelFont>
                                                                            </AccumulationDataLabelSettings>
                                                                        </AccumulationChartSeries>
                                                                    </AccumulationChartSeriesCollection>
                                                                </SfAccumulationChart>

                                                                <SfAccumulationChart Title="Qualidade" Width="100%" Height="150" Theme="@utils.ctheme">
                                                                    <AccumulationChartTooltipSettings Enable="true"></AccumulationChartTooltipSettings>
                                                                    <AccumulationChartLegendSettings Visible="false"></AccumulationChartLegendSettings>
                                                                    <AccumulationChartSeriesCollection>
                                                                        <AccumulationChartSeries DataSource="@qpieChart" XName="Key" YName="Value" StartAngle="270" EndAngle="90" Radius="90%" InnerRadius="40%" Explode="true">
                                                                            <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                                <AccumulationChartDataLabelFont FontWeight="600"></AccumulationChartDataLabelFont>
                                                                            </AccumulationDataLabelSettings>
                                                                        </AccumulationChartSeries>
                                                                    </AccumulationChartSeriesCollection>
                                                                </SfAccumulationChart>
                                                            </div>
                                                        </div>
                                                        <div class="card text-dark bg-light">
                                                            <div class="card-body">
                                                                @if (oeepieChart != null && oeepieChart.Count > 0)
                                                                {
                                                                    @if (setaoee == true)
                                                                    {
                                                                        <p style="margin:0;">Índice OEE: @oeepieChart.First().Value% | <span style='color:#00bda4'><i class='icon style1 fa-arrow-up'></i>@setavalor%</span></p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p style="margin:0;">Índice OEE: @oeepieChart.First().Value% | <span style='color:#E23F3F'><i class='icon style1 fa-arrow-down'></i>@setavalor%</span></p>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            @*GRÁFICO CARGAS POR HORA*@
                                            <div class="row uniform">
                                                <div class="12u 12u$(medium)">
                                                    @if (ChartData != null && ChartData.Count > 0)
                                                    {
                                                        <SfChart Title="Número de Cargas por Hora" Width="100%" Height="400" Theme="@utils.ctheme">
                                                            <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                            <ChartTooltipSettings Enable="true" Shared="true" Header="Nº de Cargas" Format="<b>${point.x}H : ${point.y} cargas</b>"></ChartTooltipSettings>
                                                            <ChartPrimaryXAxis Title="Hora" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                                            </ChartPrimaryXAxis>
                                                            <ChartPrimaryYAxis Title="Número de Cargas" LabelFormat="{value}" Interval="5">
                                                            </ChartPrimaryYAxis>
                                                            <ChartSeriesCollection>
                                                                <ChartSeries DataSource="@ChartData" Name="Nº de Cargas" XName="Hora" YName="Num" Type="ChartSeriesType.Column"></ChartSeries>
                                                            </ChartSeriesCollection>
                                                        </SfChart>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row uniform" style="margin-top:20px">
                                                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                                    <div class="card text-dark bg-light">
                                                        <div class="card-body">
                                                            <p style="margin:0;">Sem dados para apresentar relativamente ao período de tempo selecionado.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </ContentTemplate>
                            </TabItem>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="HISTÓRICO"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>
                                    @if (isupdating == false)
                                    {
                                        @if (histoee != null && histoee.Count() > 0)
                                        {
                                            <div class="row uniform" style="margin-top:20px;height:1000px">
                                                <div class="12u 12u$(medium)">
                                                    <SfChart Title="" Width="100%" Theme="@utils.ctheme">
                                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                        <ChartTooltipSettings Enable="true" Shared="true" Header="Índice de Desempenho" Format="<b>${point.x} : ${point.y}%</b>"></ChartTooltipSettings>
                                                        <ChartPrimaryXAxis Title="Dia" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                                        </ChartPrimaryXAxis>
                                                        <ChartPrimaryYAxis StripLines="@StripLines" Title="Índices" LabelFormat="{value}" Minimum="0" Maximum="100" Interval="5">
                                                        </ChartPrimaryYAxis>
                                                        <ChartSeriesCollection>
                                                            <ChartSeries DataSource="@histoee" Name="OEE" XName="Key" YName="Value" Type="ChartSeriesType.Line" Width="3">
                                                                <ChartTrendlines>
                                                                    <ChartTrendline Type="TrendlineTypes.Linear" Width="1" Name="Tendência" Fill="#000000">
                                                                    </ChartTrendline>
                                                                </ChartTrendlines>
                                                            </ChartSeries>
                                                            <ChartSeries DataSource="@histdisp" Name="Disponibilidade" XName="Key" YName="Value" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
                                                            <ChartSeries DataSource="@histdesemp" Name="Desempenho" XName="Key" YName="Value" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
                                                            <ChartSeries DataSource="@histqual" Name="Qualidade" XName="Key" YName="Value" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
                                                        </ChartSeriesCollection>
                                                    </SfChart>
                                                </div>
                                                <div class="12u 12u$(medium)">
                                                    <div class="row">
                                                        <div class="6u 12u$(medium)">
                                                            <div class="row">
                                                                <div class="6u">
                                                                    <SfAccumulationChart Title="Média OEE" Width="100%" Height="400" Theme="@utils.ctheme">
                                                                        <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                                                        </AccumulationChartLegendSettings>
                                                                        <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                                                        <AccumulationChartSeriesCollection>
                                                                            <AccumulationChartSeries DataSource="@calcoeeChart" XName="Key" YName="Value" Radius="90%" InnerRadius="40%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
                                                                                <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                                    <AccumulationChartDataLabelFont FontWeight="600" Color="white"></AccumulationChartDataLabelFont>
                                                                                </AccumulationDataLabelSettings>
                                                                            </AccumulationChartSeries>
                                                                        </AccumulationChartSeriesCollection>
                                                                    </SfAccumulationChart>
                                                                </div>
                                                                <div class="6u" style="display:flex;justify-content:center;flex-direction:column;height:400px">
                                                                    @if (setaCalcoee == true)
                                                                    {
                                                                        <p style="margin:0;"><strong><i class='icon style1 fa-arrow-up'></i> @DifCalcOEE%</strong></p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p style="margin:0;"><strong><i class='icon style1 fa-arrow-down'></i> @DifCalcOEE%</strong></p>
                                                                    }
                                                                    <p>Comparativamente ao mesmo período anterior</p>
                                                                    <p style="margin:0"><strong>+/- @DevCalcOEE%</strong></p>
                                                                    <p>Variação durante o periodo selecionado</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="6u 12u$(medium)">
                                                            <p style="text-align:center">Comparativamente ao mesmo período anterior</p>
                                                            <div class="row">
                                                                <div class="4u">
                                                                    @if (setaCalcIDISP == true)
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-up'></i> @DifCalcIDISP%</strong></p>

                                                                    }
                                                                    else
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-down'></i> @DifCalcIDISP%</strong></p>
                                                                    }
                                                                    <SfChart Title="" Width="100%" Height="200" Theme="@utils.ctheme">
                                                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                        <ChartArea>
                                                                            <ChartAreaBorder Color="#FF0000" Width="0"></ChartAreaBorder>
                                                                        </ChartArea>
                                                                        <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category" Visible="false">
                                                                        </ChartPrimaryXAxis>
                                                                        <ChartPrimaryYAxis Title="" Visible="false" Minimum="0" Maximum="100">
                                                                        </ChartPrimaryYAxis>
                                                                        <ChartSeriesCollection>
                                                                            <ChartSeries DataSource="@oldDispChart" Name="" XName="Key" YName="Value" Type="ChartSeriesType.Column">
                                                                                <ChartMarker>
                                                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                                                                </ChartMarker>
                                                                            </ChartSeries>
                                                                        </ChartSeriesCollection>
                                                                    </SfChart>
                                                                    <p style="width:100%;text-align:center">Disponibilidade</p>
                                                                    <p style="width: 100%; text-align: center;margin:0"><strong>+/- @DevCalcIDISP%</strong></p>
                                                                </div>
                                                                <div class="4u">
                                                                    @if (setaCalcIDESEMP == true)
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-up'></i> @DifCalcIDESEMP%</strong></p>

                                                                    }
                                                                    else
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-down'></i> @DifCalcIDESEMP%</strong></p>
                                                                    }
                                                                    <SfChart Title="" Width="100%" Height="200" Theme="@utils.ctheme">
                                                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                        <ChartArea>
                                                                            <ChartAreaBorder Color="#FF0000" Width="0"></ChartAreaBorder>
                                                                        </ChartArea>
                                                                        <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category" Visible="false">
                                                                        </ChartPrimaryXAxis>
                                                                        <ChartPrimaryYAxis Title="" Visible="false" Minimum="0" Maximum="100">
                                                                        </ChartPrimaryYAxis>
                                                                        <ChartSeriesCollection>
                                                                            <ChartSeries DataSource="@oldDesempChart" Name="" XName="Key" YName="Value" Type="ChartSeriesType.Column">
                                                                                <ChartMarker>
                                                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                                                                </ChartMarker>
                                                                            </ChartSeries>
                                                                        </ChartSeriesCollection>
                                                                    </SfChart>
                                                                    <p style="width:100%;text-align:center">Desempenho</p>
                                                                    <p style="width: 100%; text-align: center;margin:0"><strong>+/- @DevCalcIDESEMP%</strong></p>
                                                                </div>
                                                                <div class="4u">
                                                                    @if (setaCalcIQUAL == true)
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-up'></i> @DifCalcIQUAL%</strong></p>

                                                                    }
                                                                    else
                                                                    {
                                                                        <p style="width: 100%; text-align: center;margin:0"><strong><i class='icon style1 fa-arrow-down'></i> @DifCalcIQUAL%</strong></p>
                                                                    }
                                                                    <SfChart Title="" Width="100%" Height="200" Theme="@utils.ctheme">
                                                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                        <ChartArea>
                                                                            <ChartAreaBorder Color="#FF0000" Width="0"></ChartAreaBorder>
                                                                        </ChartArea>
                                                                        <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category" Visible="false">
                                                                        </ChartPrimaryXAxis>
                                                                        <ChartPrimaryYAxis Title="" Visible="false" Minimum="0" Maximum="100">
                                                                        </ChartPrimaryYAxis>
                                                                        <ChartSeriesCollection>
                                                                            <ChartSeries DataSource="@oldQualChart" Name="" XName="Key" YName="Value" Type="ChartSeriesType.Column">
                                                                                <ChartMarker>
                                                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                                                                </ChartMarker>
                                                                            </ChartSeries>
                                                                        </ChartSeriesCollection>
                                                                    </SfChart>
                                                                    <p style="width:100%;text-align:center">Qualidade</p>
                                                                    <p style="width: 100%; text-align: center;margin:0"><strong>+/- @DevCalcIQUAL%</strong></p>
                                                                </div>
                                                            </div>
                                                            <p style="text-align:center">Variação durante o período selecionado</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row uniform" style="margin-top:20px">
                                                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                                    <div class="card text-dark bg-light">
                                                        <div class="card-body">
                                                            <p style="margin:0;">Sem dados para apresentar relativamente ao período de tempo selecionado.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </ContentTemplate>
                            </TabItem>
                            <TabItem>
                                <ChildContent>
                                    <TabHeader Text="TURNO"></TabHeader>
                                </ChildContent>
                                <ContentTemplate>

                                    @if (isupdating == false)
                                    {
                                        @if (RefsTrabalho != null && RefsTrabalho.Count > 0)
                                        {
                                            <div class="row uniform" style="margin-top:20px">
                                                <div class="6u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
                                                    <div class="row">
                                                        <div class="table-wrapper" style="width:100%">
                                                            <table>
                                                                <thead>
                                                                    <tr>
                                                                        <th>Turno Selecionado</th>
                                                                        <th style="overflow-x: auto;">
                                                                            @if (SelTurno.Count > 0)
                                                                            {
                                                                                <SfDropDownList Value="@STurno" TValue="string" TItem="turnort" Placeholder="Turno" DataSource="@SelTurno" Width="100%" Style="height:100%;display: inline-block">
                                                                                    <DropDownListEvents OnValueSelect="@SelTurno_SelectionChanged" TValue="string" TItem="turnort"></DropDownListEvents>
                                                                                    <DropDownListFieldSettings Value="kturno" Text="vturno"></DropDownListFieldSettings>
                                                                                </SfDropDownList>
                                                                            }
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>Turno (h)</td>
                                                                        <td>@nTurnoTurno</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tempo Operacional (m)</td>
                                                                        <td>@nTOperacionalTurno (@HnTOperacionalTurno h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tempo de Produção (m)</td>
                                                                        <td>@nTProdTurno (@HnTProdTurno h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tempo parado (m)</td>
                                                                        <td>@nTStopTurno (@HnTStopTurno h)</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Produção (cargas)</td>
                                                                        <td>@nProdTurno</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Perdas (cargas)</td>
                                                                        <td>@nPerdasTurno</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Unidades conformes</td>
                                                                        <td>@nConfTurno</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Unidades não conformes</td>
                                                                        <td>@nNConfTurno</td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="6u 12u$(medium) align-self-end" style="display: flex;justify-content:space-between;flex-direction:column">
                                                    <div class="row">
                                                        <div class="6u">
                                                            <SfAccumulationChart Title="OEE" Width="100%" Height="450" Theme="@utils.ctheme">
                                                                <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                                                </AccumulationChartLegendSettings>
                                                                <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                                                <AccumulationChartSeriesCollection>
                                                                    <AccumulationChartSeries DataSource="@oeepieChartTurno.AsEnumerable()" XName="Key" YName="Value" Radius="90%" InnerRadius="40%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
                                                                        <AccumulationDataLabelSettings Visible="true" Name="text">
                                                                            <AccumulationChartDataLabelFont FontWeight="600" Color="white"></AccumulationChartDataLabelFont>
                                                                        </AccumulationDataLabelSettings>
                                                                    </AccumulationChartSeries>
