    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == true)
        {
            if (utils.f10session.ContainsKey("reportPdateini") == true && utils.f10session.ContainsKey("reportPdatefin") == true)
            {
                dti = (DateTime)utils.f10session["reportPdateini"];
                dtf = (DateTime)utils.f10session["reportPdatefin"];
            }

            GetDB();
        }
        base.OnAfterRender(firstRender);
    }
    private async void GetDB()
    {
        DataLink_L1 DL1 = new DataLink_L1();

        if (await DL1.db.Database.CanConnectAsync())
        {
            utils.L1ON = true;
            dbchecked = true;
            dbcheckedoff = false;
            DL1.Dispose();
            StateHasChanged();
            await SearchData();
            await PopulateMateriais();
        }
        else
        {
            utils.L1ON = false;
            dbchecked = false;
            dbcheckedoff = true;
            DL1.Dispose();
            StateHasChanged();
        }
    }

    private async Task SearchData()
    {
        await SpinnerObj.ShowAsync();

        if (utils.f10session.ContainsKey("prodList") && !utils.Refresh)
        {
            if (utils.f10session["prodList"].GetType() == RefsTrabalho.GetType())
            {
                RefsTrabalho = (List<Dadosrt>)utils.f10session["prodList"];
                if (RefsTrabalho.Count != 0 && (DateTime)utils.f10session["reportPdateini"] == dti.Value && (DateTime)utils.f10session["reportPdatefin"] == dtf.Value.AddDays(1))
                {
                    GetChartsData(RefsTrabalho);
                    utils.Refresh = true;//obriga a voltar a pesquisar os dados se não vier dos report detalhes
                    await SpinnerObj.HideAsync();
                    StateHasChanged();
                    return;
                }
            }
        }

        DataLink_L1 dl = new DataLink_L1();

        try
        {
            //TABELA
            var phistory = from rt in dl.db.ReferenciaTrabalhos
                           join prg in dl.db.PlcProgramas on rt.Campo1 equals prg.Num.ToString()
                           join reg in dl.db.Registos on rt.Lote equals reg.Lote
                           group reg by new
                           {
                               rt.Id,
                               rt.Lote,
                               rt.Referencia,
                               rt.Ordemfabrico,
                               rt.Suspensao,
                               rt.Operador,
                               rt.Unidades,
                               rt.UnidadesMas,
                               rt.UnidadesTeoricas,
                               rt.AreaTotal,
                               rt.Descarga,
                               rt.Notas,
                               prg.Nome,
                               rt.Opcao1,
                               rt.Opcao2,
                               rt.Opcao4
                           } into gr
                           where gr.Max(t => t.TempoFinal) >= dti && gr.Max(t => t.TempoFinal) <= dtf.Value.AddDays(1)
                           orderby gr.Max(t => t.TempoFinal) descending
                           select new Dadosrt
                           {
                               Id = gr.Key.Id.ToString(),
                               Lote = gr.Key.Lote,
                               OF = gr.Key.Ordemfabrico,
                               Suspensao = gr.Key.Suspensao,
                               Referencia = gr.Key.Referencia,
                               Operador = gr.Key.Operador,
                               Inicio = gr.Min(t => t.TempoInicial),
                               Fim = gr.Max(t => t.TempoFinal),
                               Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
                               Unidades = gr.Key.Unidades,
                               Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
                               Mas = gr.Key.UnidadesMas,
                               Teoricas = gr.Key.UnidadesTeoricas,
                               Area = gr.Key.AreaTotal,
                               Programa = gr.Key.Nome,
                               Estado = (gr.Count(t => t.Estado == "Manual") > 0 ? "Manual" : "Automático"),
                               Notas = gr.Key.Notas,
                               Maintenance = gr.Key.Opcao1,
                               Reprocessed = gr.Key.Opcao2,
                               Vazia = gr.Key.Opcao4,
                               Descarga = gr.Key.Descarga
                           };

            var dados = await phistory.ToListAsync();

            RefsTrabalho = dados;

            if (utils.f10session.ContainsKey("prodList"))
            {
                utils.f10session["prodList"] = RefsTrabalho;
            }
            else
            {
                utils.f10session.Add("prodList", RefsTrabalho);
            }

            GetChartsData(dados);

        }
        catch (Exception ex)
        {
            Debug.WriteLine($"{DateTime.Now} - Erro ao carregar dados: {ex.Message} \n {ex.StackTrace}");
        }
        finally
        {
            StateHasChanged();
            await SpinnerObj.HideAsync();
            dl.Dispose();
        }


    }

