        var progs = dados.Where(w => w.Referencia != "" && w.Referencia != "60" && w.Programa != "Decapagem" && w.Descarga == true).Select(s => s.Programa).Distinct();
        foreach (var item in progs)
        {
            finalist.Add(new AreaChartData { Dia = item, Num = dados.Where(w => w.Referencia != "" && w.Referencia != "60" && w.Programa == item && w.Descarga == true).Count() });
        }
        //finalist.Add(new AreaChartData { Dia = "Vazias - Falta de Peças", Num = dados.Where(w => w.Referencia == "" && w.Vazia == "Falta de Peças").Count() });
        finalist.Add(new AreaChartData { Dia = "Vazias - Outro", Num = dados.Where(w => w.Referencia == "" && (w.Vazia == "Outro" || w.Vazia == "" || w.Vazia == null) && w.Descarga == true).Count() });
        RoundChartData = finalist;

        utils.f10session["reportPdateini"] = dti;
        utils.f10session["reportPdatefin"] = dtf.Value.AddDays(1);
    }



    private async Task PopulateMateriais()
    {
        await SpinnerObj.ShowAsync();
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var pMateriais = (from ta in dl.db.ReferenciaTrabalhos
                          select ta.Referencia.ToString()).Distinct();
        var dadosmat = await pMateriais.ToListAsync();

        Materiais = dadosmat;
        Materiais.Insert(0, "Todos");
        StateHasChanged();
        await SpinnerObj.HideAsync();
    }

    public void Filtro(@Syncfusion.Blazor.DropDowns.SelectEventArgs<string>
    args)
    {
        if (args.ItemData.ToString() == "Todos")
        {
            Grid.ClearFiltering();
        }
        else
        {
            Grid.FilterByColumn("Referencia", "contains", args.ItemData.ToString());
        }
    }

