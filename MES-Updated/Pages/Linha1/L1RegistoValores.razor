@* @page "/linha1/registovalores"
@using System.Globalization
@using pulsar.sv.data
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Utils utils
<!-- Main -->
<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 3100.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="()=> { dbcheckedoff = false; GetDB(); }" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("RV2") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 3100 - REGISTO DE VALORES</h1>
                    </div>
                    <div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
                        <button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                        <button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    </div>
                </div>


                <div class="row uniform">
                    <div class="2u 12u$(medium)">
                        <SfDropDownList Value="@selTipo.Nome" TValue="string" TItem="pulsar.sv.data.DC_Tipo" DataSource="@Tipos.AsEnumerable()">
                            <DropDownListEvents OnValueSelect="@SelTipo_SelectionChanged" TValue="string" TItem="pulsar.sv.data.DC_Tipo"></DropDownListEvents>
                            <DropDownListFieldSettings Value="Nome" Text="Nome"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    <div class="2.2u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
                    </div>
                    <div class="2.3u 12u$(medium)">
                        <SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
                    </div>
                    <div class="5.5u 12u$(medium)">
                        <SfButton @onclick="SearchData" Title="Pesquisar"><i class='icon style1 fa-search'></i></SfButton>
                        <SfButton @onclick="@(() => { NavigationManager.NavigateTo("linha2/tipos"); })" Title="Gestão Tipos"><i class='icon style1 fa-list'></i></SfButton>
                        <SfButton @onclick="@(() => { PopupValores = true; selTipo = new pulsar.sv.data.DC_Tipo(); selValor = new pulsar.sv.data.DC_Valor(); @selValor.Data = DateTime.Now;})" Title="Registar Valor">VALOR <i class='icon style1 fa-plus'></i></SfButton>
                        <SfButton @onclick="@(() => {  PopupTipos = true;  selTipo = new pulsar.sv.data.DC_Tipo(); selValor = new pulsar.sv.data.DC_Valor(); })" Title="Registar Tipo">TIPO <i class='icon style1 fa-plus'></i></SfButton>
                    </div>
                </div>
@*                <div class="row uniform">
                        <div class="3u 12u$(medium)" style="height:450px;">
                        <div style="display: flex; flex-direction:column; justify-content:center; height:450px;">
                        <ul class="alt">
                            <li><i class="icon style1 fa-list"></i> <strong> @Valores.Count().ToString() </strong> Nº Registos</li>
                            </ul>
        </div>
        </div>
        </div>
        

                //TABELA
                <div class="row uniform">
                    @if (Valores.Count > 0)
                    {
                        <div>
                            <SfGrid DataSource="@Valores" AllowFiltering="true" AllowSorting="true" AllowGrouping="true">
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
                                        <Template>
                                            @{
                                                var whois = (context as pulsar.sv.data.DC_Valor);
                                                <div style="display: flex; justify-content: space-between;">
                                                    <p @onclick="@(() => { Edit_Valor(whois.Id); })" class="icon style1 fa-remove" style="margin:0.3em;cursor:pointer"><span class="label">Editar</span></p>
                                                </div>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="Tipo">
                                        <Template>
                                            @{
                                                <div style="display: flex; justify-content: space-between;">
                                                    <p style="margin:0.3em;cursor:pointer"><span>@nomeTipo</span></p>
                                                </div>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="Data" HeaderText="Data"></GridColumn>
                                    <GridColumn Field="Opcao" HeaderText="Opção"></GridColumn>
                                    <GridColumn Field="Texto" HeaderText="Texto"></GridColumn>
                                    <GridColumn Field="Numero" HeaderText="Valor"></GridColumn>
                                    <GridColumn Field="Obs" HeaderText="Observações"></GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </div>

                    }
                    else
                    {
                        <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                            <div class="card text-dark bg-light">
                                <div class="card-body">
                                    <p style="margin:0;">Sem valores registados nas datas / formato selecionadas.</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>


                @*ADICIONAR TIPO
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupTipos">
                    <DialogTemplates>
                        <Header>Registar Tipo</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Nome</p>
                                    <SfTextBox Multiline="false" @bind-Value="@selTipo.Nome" style="margin-left:10px;padding:0"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Descrição</p>
                                    <SfTextBox Multiline="true" @bind-Value="@selTipo.Descricao" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Formato</p>
                                    <SfRadioButton Label="Texto" Name="options" Value="T" @bind-Checked="@selTipo.Formato"></SfRadioButton>
                                    <SfRadioButton Label="Número" Name="options" Value="D" @bind-Checked="@selTipo.Formato"></SfRadioButton>
                                    <SfRadioButton Label="Opcão" Name="options" Value="O" @bind-Checked="@selTipo.Formato"></SfRadioButton>
                                </div>
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Unidade</p>
                                    <SfTextBox @bind-Value="@selTipo.Unidade" style="margin-left:10px;padding:0"></SfTextBox>
                                </div>
                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>
                            <button class="button special pull-right" @onclick="@(() => { Add_Tipo(0); })" style="margin:10px">Guardar</button>
                            <button class="button pull-right" @onclick="@(() => { PopupTipos = false; selTipo = new pulsar.sv.data.DC_Tipo() { }; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ADICIONAR VALOR
                <SfDialog Target="#target" Width="500px" Height=auto ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupValores">
                    <DialogTemplates>
                        <Header>Registar Valor</Header>
                        <Content>
                            <div style="margin-top:1em;margin-bottom:1em;overflow:auto">
                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Tipo</p>
                                    <SfDropDownList Value="@selTipo.Nome" TValue="string" TItem="pulsar.sv.data.DC_Tipo" DataSource="@Tipos.AsEnumerable()">
                                        <DropDownListEvents OnValueSelect="@SelTipo1_SelectionChanged" TValue="string" TItem="pulsar.sv.data.DC_Tipo"></DropDownListEvents>
                                        <DropDownListFieldSettings Value="Nome" Text="Nome"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Unidade</p>
                                    <SfTextBox @bind-Value="@selTipo.Unidade" style="margin-left:10px;padding:0;" Enabled="false"></SfTextBox>
                                </div>

                                @if (selTipo.Formato == "O")
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:6.5em;margin:0;margin-top:10px;">Opcao</p>
                                        <div style="margin-left:10px;margin-top:10px;padding:0">
                                            <SfSwitch @bind-Checked="@selValor.Opcao"></SfSwitch>
                                        </div>
                                    </div>
                                }

                                @if (selTipo.Formato == "T")
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Texto</p>
                                        <SfTextBox Multiline="true" @bind-Value="@selValor.Texto" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                    </div>
                                }

                                @if (selTipo.Formato == "D")
                                {
                                    <div style="display: flex; justify-content: left; margin:0.5em">
                                        <p style="width:8em;margin:0;margin-top:10px;">Valor</p>
                                        <SfNumericTextBox @bind-Value="@selValor.Numero" style="margin-left:10px;padding:0"></SfNumericTextBox>
                                    </div>
                                }

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Observações</p>
                                    <SfTextBox Multiline="true" @bind-Value="@selValor.Obs" style="margin-left:10px;padding:0;height:80px"></SfTextBox>
                                </div>

                                <div style="display: flex; justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Data</p>
                                    <SfDateTimePicker @bind-Value="@selValor.Data" style="margin-left:10px;padding:0"></SfDateTimePicker>
                                </div>

                                <div style="display: flex; justify-content: center; margin:0.5em">
                                    <p style="margin-top:10px;color:red">@Erromsg</p>
                                </div>
                            </div>

                            <button class="button special pull-right" @onclick="@(() => { Add_Valor(0); })" style="margin:10px">Guardar</button>
                            <button class="button pull-right" @onclick="@(() => { PopupValores = false; selValor = new pulsar.sv.data.DC_Valor() { }; })" style="margin:10px">Cancelar</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

                @*ELIMINAR VALOR
                <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelValores">
                    <DialogTemplates>
                        <Header>Eliminar Registo</Header>
                        <Content>
                            <p>
                                A eliminação do Registo é permanente.<br />
                                Pretende realmente eliminar?
                            </p>
                            <button class="button special pull-right" @onclick="@(() => { Del_Valor(); })" style="margin:10px">Sim</button>
                            <button class="button pull-right" @onclick="@(() => { PopupDelValores = false; })" style="margin:10px">Não</button>
                        </Content>
                    </DialogTemplates>
                </SfDialog>

            }
            else
            {
                <div class="row uniform" style="margin-top:20px">
                    <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                        <div class="card text-dark bg-light">
                            <div class="card-body">
                                <p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
                                <a href="/">Voltar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @*LOADING
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>

    </div>
</div>*@

