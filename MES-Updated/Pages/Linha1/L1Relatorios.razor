@page "/linha1/relatorios"
@using System.Diagnostics

@inject NavigationManager NavigationManager
@inject Utils utils
@inject IJSRuntime JSRuntime

<div id="main">
	<div class="inner">

		@if (dbchecked == false)
		{
			<div class="row uniform" style="margin-top:20px">
				<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
					<div class="card text-dark bg-light">
						<div class="card-body">
							@if (dbcheckedoff == false)
							{
								<div>
									<div class="bounceball"></div>
									<div class="bounceballtext">A verificar ligação à base de dados</div>
								</div>
							}
							else
							{
								<h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
								<p style="margin:0;">Operações recomendadas:</p>
								<ul>
									<li>Verifique se a linha se encontra em funcionamento</li>
									<li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
									<li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
								</ul>
								<div class="row" style="margin-top:1em">
									<div class="12u$" style="display: flex;justify-content:flex-start;">
										<button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
										<a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			@if (utils.CanAccess("RPL1") == true)
			{
				<div class="row">
					<div class="8u 12u$(medium)">
						<h1>LINHA 1 - RELATÓRIOS</h1>
						@*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
					</div>
					<div class="4u 12u$(medium) noprint" style="display: flex;justify-content:flex-end;">
						<button @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
						<button @onclick="SearchData" title="Atualizar"><i class="icon style1 fa-refresh"></i></button>
						@* <button @onclick="@(()=> { dtini = dti; dtfim = dtf; errormsg = ""; ShowRelatorioIntegrado = true; })" title="Relatório Integrado"><i class="icon style1 fa-file-text"></i></button> *@
						<button onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
					</div>
				</div>


				<div class="row uniform">
					<div class="4u 12u$(medium)">
						<SfDatePicker TValue="DateTime?" Placeholder='Data de Inicio' @bind-Value="dti"></SfDatePicker>
					</div>
					<div class="4u 12u$(medium)">
						<SfDatePicker TValue="DateTime?" Placeholder='Data de Fim' @bind-Value="dtf"></SfDatePicker>
					</div>
					<div class="4u 12u$(medium)">
						<SfButton @onclick="SearchData">Pesquisar</SfButton>
					</div>
				</div>
				@*RefsTrabalho != null && RefsTrabalho.Count > 0*@
				@if (2 > 1)
				{
					@*GRÁFICO*@
					<div class="row uniform">
						<div class="8u 12u$(medium)">
							@*RefsTrabalho != null*@
							@if (2 > 1)
							{
								<SfChart Title="Número de Cargas por Hora" Width="100%" Height="400" Theme="@utils.ctheme">
									<ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
									<ChartTooltipSettings Enable="true" Shared="true" Header="Nº de Cargas" Format="<b>${point.x}H : ${point.y} cargas</b>"></ChartTooltipSettings>
									<ChartPrimaryXAxis Title="Hora" EdgeLabelPlacement="EdgeLabelPlacement.Shift" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
									</ChartPrimaryXAxis>
									<ChartPrimaryYAxis Title="Número de Cargas" LabelFormat="{value}">
									</ChartPrimaryYAxis>
									<ChartSeriesCollection>
										<ChartSeries DataSource="@ChartData" Name="Cargas" XName="Hora" YName="Num" Type="ChartSeriesType.Area"></ChartSeries>
										<ChartSeries DataSource="@ChartDataVazias" Name="Vazias" XName="Hora" YName="Num" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
										<ChartSeries DataSource="@ChartDataDecapagem" Name="Decapagem" XName="Hora" YName="Num" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
									</ChartSeriesCollection>
								</SfChart>
							}
						</div>
						<div class="4u 12u$(medium)">
							@*RefsTrabalho != null*@
							@if (2 > 1)
							{
								<SfAccumulationChart Title="Cargas" Width="100%" Height="400" Theme="@utils.ctheme">
									<AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
									</AccumulationChartLegendSettings>
									<AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
									<AccumulationChartSeriesCollection>
										<AccumulationChartSeries DataSource="@RoundChartData" XName="Hora" YName="Num" Radius="70%" InnerRadius="40%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
											<AccumulationDataLabelSettings Visible="true" Name="text">
												<AccumulationChartDataLabelFont FontWeight="600" Color="white"></AccumulationChartDataLabelFont>
											</AccumulationDataLabelSettings>
										</AccumulationChartSeries>
									</AccumulationChartSeriesCollection>
								</SfAccumulationChart>
							}
						</div>
					</div>

					@*TABELA*@
					<div>
						@*RefsTrabalho != null*@
						@if (2 > 1)
						{
							<SfGrid @ref="@Grid" DataSource="@RefsTrabalho" AllowFiltering="true" AllowSorting="true" AllowGrouping="true" AllowPaging="true">
								<GridPageSettings PageSize="20" />
								<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
								<GridEvents OnRecordDoubleClick="RecordDoubleClickHandler" TValue="Dadosrt"></GridEvents>
								<GridColumns>
									<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
										<Template>
											@{
												var whois = (context as Dadosrt);
												<a href="@($"/linha1/relatorio/{whois.Id}")" class="icon style1 fa-folder-open"><span class="label">Abrir Relatório</span></a>
											}
										</Template>
									</GridColumn>
									<GridColumn Field="Lote" HeaderText="Lote"></GridColumn>
									<GridColumn Field="Referencia" HeaderText="Código">
										<FilterTemplate>
											<SfDropDownList Placeholder="Código" ID="Referencia" @bind-Value="@((context as PredicateModel<string>).Value)" TItem="string" TValue="string" DataSource="@(Materiais)">
												<DropDownListFieldSettings Value="Referencia" Text="Referencia"></DropDownListFieldSettings>
											</SfDropDownList>
										</FilterTemplate>
										<Template>
											@{
												var whois = (context as Dadosrt);
												if (whois.Referencia == "" && whois.Vazia != "" && whois.Vazia != null)
												{
													@(whois.Referencia + " - " + whois.Vazia)
												}
												else
												{
													@(whois.Referencia)
												}
											}
										</Template>
									</GridColumn>
									<GridColumn Field="Inicio" HeaderText="Inicio" Format="G" Type="ColumnType.Date" HideAtMedia="(min-width: 700px)"></GridColumn>
									<GridColumn Field="Fim" HeaderText="Fim" Format="G" Type="ColumnType.Date" HideAtMedia="(min-width: 700px)"></GridColumn>
									<GridColumn Field="Tempo" HeaderText="Tempo" Format="t" HideAtMedia="(min-width: 700px)"></GridColumn>
									<GridColumn Field="Programa" HeaderText="Programa" HideAtMedia="(min-width: 700px)"></GridColumn>
									<GridColumn Field="Estado" HeaderText="Estado" HideAtMedia="(min-width: 700px)"></GridColumn>
								</GridColumns>
							</SfGrid>
						}
					</div>
					<div class="row uniform">
						@if (DocumentPath != "")
						{

						}
					</div>
				}
				else
				{
					<div class="row uniform" style="margin-top:20px">
						<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
							<div class="card text-dark bg-light">
								<div class="card-body">
									<p style="margin:0;">Sem dados para apresentar relativamente ao período de tempo selecionado.</p>
								</div>
							</div>
						</div>
					</div>
				}

			}
			else
			{
				<div class="row uniform" style="margin-top:20px">
					<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
						<div class="card text-dark bg-light">
							<div class="card-body">
								<p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
								<a href="/">Voltar</a>
							</div>
						</div>
					</div>
				</div>
			}
		}

		@*MENSAGEM*@
		<SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@ShowRelatorioIntegrado">
			<DialogTemplates>
				<Header>Relatório Integrado</Header>
				<Content>
					<div style="display: flex; justify-content: left; margin:0.5em">
						<p style="width:8em;margin:0;margin-top:10px;">Data Inicial</p>
						<SfDatePicker Placeholder="" @bind-Value="@dtini" style="margin-left:10px;padding:0"></SfDatePicker>
					</div>
					<div style="display: flex; justify-content: left; margin:0.5em">
						<p style="width:8em;margin:0;margin-top:10px;">Data Final</p>
						<SfDatePicker Placeholder="" @bind-Value="@dtfim" style="margin-left:10px;padding:0"></SfDatePicker>
					</div>
					<div style="margin:0.5em">
						<p style="margin:0;margin-top:10px;">Email (para enviar para vários endereços, separe-os por ;)</p>
						<SfTextBox Multiline="true" Placeholder="" @bind-Value="@Email" style="margin-top:10px;padding:0;height:80px"></SfTextBox>
					</div>
					<div style="display: flex; justify-content: center; margin:0.5em">
						<p style="margin-top:10px;color:red">@errormsg</p>
					</div>
					<button class="button special pull-right" @onclick="@(() => { ShowRelatorioIntegrado = false; })" style="margin:10px">Enviar</button>
					<button class="button pull-right" @onclick="@(() => { ShowRelatorioIntegrado=false; })" style="margin:10px">Cancelar</button>
				</Content>
			</DialogTemplates>
		</SfDialog>
		<SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupMessage">
			<DialogTemplates>
				<Header>Relatório Integrado</Header>
				<Content>
					<p>
						@popupText
					</p>
					<button class="button special pull-right" @onclick="@(()=> { PopupMessage=false; })" style="margin:10px">OK</button>
				</Content>
			</DialogTemplates>
		</SfDialog>


		@*LOADING*@
		<SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>

	</div>
</div>


@code {
	SfGrid<Dadosrt> Grid;
	SfSpinner SpinnerObj = new SfSpinner();
	User who = new User();

	bool dbchecked = false, dbcheckedoff = false;
	bool ShowRelatorioIntegrado = false;
	string Email = "";
	string errormsg = "";
	bool PopupMessage = false;
	string popupText = "";
	public DateTime? dti { get; set; } = DateTime.Today;
	public DateTime? dtf { get; set; } = DateTime.Today;
	public DateTime? dtini { get; set; } = DateTime.Today;
	public DateTime? dtfim { get; set; } = DateTime.Today;
	private string DocumentPath { get; set; } = "";
	public List<Dadosrt> RefsTrabalho = new List<Dadosrt>() { };
	public List<string> Materiais = new List<string>() { };
	public List<AreaChartData> ChartData = new List<AreaChartData> { };
	public List<AreaChartData> ChartDataVazias = new List<AreaChartData> { };
	public List<AreaChartData> ChartDataDecapagem = new List<AreaChartData> { };
	public List<AreaChartData> RoundChartData = new List<AreaChartData> { };

	protected override void OnInitialized()
	{
		who = (User)utils.f10session["user"];
		base.OnInitialized();
	}
	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender == true)
		{
			if (utils.f10session.ContainsKey("reportRdateini") == true && utils.f10session.ContainsKey("reportRdatefin") == true)
			{
				dti = (DateTime)utils.f10session["reportRdateini"];
				dtf = (DateTime)utils.f10session["reportRdatefin"];
			}

			GetDB();
		}
		base.OnAfterRender(firstRender);
	}
	private async void GetDB()
	{
		DataLink_L1 DL1 = new DataLink_L1();

		if (await DL1.db.Database.CanConnectAsync())
		{
			utils.L1ON = true;
			dbchecked = true;
			dbcheckedoff = false;
			DL1.Dispose();
			StateHasChanged();
			SearchData();
			PopulateMateriais();
		}
		else
		{
			utils.L1ON = false;
			dbchecked = false;
			dbcheckedoff = true;
			DL1.Dispose();
			StateHasChanged();
		}
	}
	private async void SearchData()
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		if (utils.f10session.ContainsKey("reltList") && !utils.Refresh)
		{
			if (utils.f10session["reltList"].GetType() == RefsTrabalho.GetType())
			{
				RefsTrabalho = (List<Dadosrt>)utils.f10session["reltList"];
				if (RefsTrabalho.Count != 0 && (DateTime)utils.f10session["reportRdateini"] == dti.Value && (DateTime)utils.f10session["reportRdatefin"] == dtf.Value.AddDays(1))
				{
					GetChartsData(RefsTrabalho);
					utils.Refresh = true;//obriga a voltar a pesquisar os dados se não vier dos report detalhes
					await SpinnerObj.HideAsync();
					StateHasChanged();
					return;
				}
			}
		}

		try
		{

			var phistory = from rt in dl.db.ReferenciaTrabalhos
									join prg in dl.db.PlcProgramas on rt.Campo1 equals prg.Num.ToString()
									join reg in dl.db.Registos on rt.Lote equals reg.Lote
									group reg by new
									{
										rt.Id,
										rt.Lote,
										rt.Referencia,
										rt.Ordemfabrico,
										rt.Suspensao,
										rt.Operador,
										rt.Unidades,
										rt.UnidadesMas,
										rt.UnidadesTeoricas,
										rt.AreaTotal,
										rt.Descarga,
										rt.Notas,
										prg.Nome,
										rt.Opcao1,
										rt.Opcao2,
										rt.Opcao4
									} into gr
						   where gr.Max(t => t.TempoFinal) >= dti & gr.Max(t => t.TempoFinal) <= dtf.Value.AddDays(1)
									orderby gr.Max(t => t.TempoFinal) descending
									select new Dadosrt
							   {
								   Id = gr.Key.Id.ToString(),
								   Lote = gr.Key.Lote,
								   OF = gr.Key.Ordemfabrico,
								   Suspensao = gr.Key.Suspensao,
								   Referencia = gr.Key.Referencia,
								   Operador = gr.Key.Operador,
								   Inicio = gr.Min(t => t.TempoInicial),
								   Fim = gr.Max(t => t.TempoFinal),
							   Tempo = (gr.Max(t => t.TempoFinal).Value.Subtract(gr.Min(t => t.TempoInicial).Value)).ToString(@"dd\:hh\:mm\:ss"),
								   Unidades = gr.Key.Unidades,
								   Boas = gr.Key.Unidades - gr.Key.UnidadesMas,
								   Mas = gr.Key.UnidadesMas,
								   Teoricas = gr.Key.UnidadesTeoricas,
								   Area = gr.Key.AreaTotal,
								   Programa = gr.Key.Nome,
								   Estado = (gr.Count(t => t.Estado == "Manual") > 0 ? "Manual" : "Automático"),
								   Notas = gr.Key.Notas,
								   Maintenance = gr.Key.Opcao1,
								   Reprocessed = gr.Key.Opcao2,
								   Vazia = gr.Key.Opcao4,
								   Descarga = gr.Key.Descarga
							   };

			var dados = await phistory.ToListAsync();

			// DateTime? x = DateTime.Parse("2025-09-02 10:12:23");
			// DateTime? y = DateTime.Parse("2025-09-01 10:00:23");

			// var w = y.Value.Subtract(x.Value).ToString(@"dd\:hh\:mm\:ss");

			// foreach (var item in dados)
			// {
			// 	item.Tempo = w;
			// }

			RefsTrabalho = dados;


			if (utils.f10session.ContainsKey("reltList"))
			{
				utils.f10session["reltList"] = RefsTrabalho;
			}
			else
			{
				utils.f10session.Add("reltList", RefsTrabalho);
			}

			GetChartsData(dados);

		}
		catch (Exception ex)
		{
			Debug.WriteLine($"{DateTime.Now} - Erro ao carregar dados: {ex.Message} \n {ex.StackTrace}");
		}
		finally
		{
			dl.Dispose();
			await SpinnerObj.HideAsync();
			StateHasChanged();
		}
	}

	void GetChartsData(List<Dadosrt> dados)
	{
		//GRÁFICO NUMERO DE BARRAS POR HORA
		List<AreaChartData> ac = new List<AreaChartData>() { };
		var dadosdia = dados.Where(ca => ca.Referencia != "" && ca.Referencia != "60" && ca.Programa != "Decapagem" && ca.Descarga == true).GroupBy(gr => gr.Fim.Value.Hour).OrderBy(or => or.Key);
		foreach (var item in dadosdia)
		{
			AreaChartData aci = new AreaChartData()
				{
					Hora = item.Key.ToString(),
					Ordem = item.Key,
					Num = item.Count(),
				};
			ac.Add(aci);
		}
		ChartData = ac;

		for (int i = 0; i < 23; i++)
		{
			if (ac.Where(z => z.Ordem == i).Count() == 0)
			{
				ac.Add(new AreaChartData { Ordem = i, Hora = i.ToString(), Num = 0 });
			}
		}
		ChartData = ac.OrderBy(bitch => bitch.Ordem).ToList();


		List<AreaChartData> acvazias = new List<AreaChartData>() { };
		var dadosdiavazias = dados.Where(ca => ca.Referencia == "" && ca.Descarga == true).GroupBy(gr => gr.Fim.Value.Hour).OrderBy(or => or.Key);
		foreach (var item in dadosdiavazias)
		{
			AreaChartData aci = new AreaChartData()
				{
					Hora = item.Key.ToString(),
					Ordem = item.Key,
					Num = item.Count(),
				};
			acvazias.Add(aci);
		}
		ChartDataVazias = acvazias;

		for (int i = 0; i < 23; i++)
		{
			if (acvazias.Where(z => z.Ordem == i).Count() == 0)
			{
				acvazias.Add(new AreaChartData { Ordem = i, Hora = i.ToString(), Num = 0 });
			}
		}
		ChartDataVazias = acvazias.OrderBy(bitch => bitch.Ordem).ToList();


		// List<AreaChartData> acdecapagem = new List<AreaChartData>() { };
		// var dadosdiadecapagem = dados.Where(ca => ca.Referencia == "60" || ca.Programa == "Decapagem").GroupBy(gr => gr.Fim.Value.Hour).OrderBy(or => or.Key);
		// foreach (var item in dadosdiadecapagem)
		// {
		// 	AreaChartData aci = new AreaChartData()
		// 		{
		// 			Hora = item.Key.ToString(),
		// 			Ordem = item.Key,
		// 			Num = item.Count(),
		// 		};
		// 	acdecapagem.Add(aci);
		// }
		// ChartDataDecapagem = acdecapagem;

		// for (int i = 0; i < 23; i++)
		// {
		// 	if (acdecapagem.Where(z => z.Ordem == i).Count() == 0)
		// 	{
		// 		acdecapagem.Add(new AreaChartData { Ordem = i, Hora = i.ToString(), Num = 0 });
		// 	}
		// }
		// ChartDataDecapagem = acdecapagem.OrderBy(bitch => bitch.Ordem).ToList();



		//GRÁFICO CARGAS VS VAZIAS VS DECAPAGEM
		List<AreaChartData> finalist = new List<AreaChartData>();
		var progs = dados.Where(w => w.Referencia != "" && w.Referencia != "60" && w.Programa != "Decapagem" && w.Descarga == true).Select(s => s.Programa).Distinct();
		foreach (var item in progs)
		{
			finalist.Add(new AreaChartData { Ordem = 1, Hora = item, Num = dados.Where(w => w.Referencia != "" && w.Referencia != "60" && w.Programa == item && w.Descarga == true).Count() });
		}

		
		finalist.Add(new AreaChartData { Ordem = 1, Hora = "Vazias - Outro", Num = dados.Where(w => w.Referencia == "" && (w.Vazia == "Outro" || w.Vazia == "" || w.Vazia == null) && w.Descarga == true ).Count() });
		
		RoundChartData = finalist;

		//guardar as datas
		utils.f10session["reportRdateini"] = dti;
		utils.f10session["reportRdatefin"] = dtf.Value.AddDays(1);

	}

	private async void PopulateMateriais()
	{
		DataLink_L1 dl = new DataLink_L1();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		//var pMateriais = (from ta in dl.db.Materials
		//                  select ta.Id.ToString()).Distinct();
		//var dadosmat = await pMateriais.ToListAsync();

		var pMateriais = (from ta in dl.db.ReferenciaTrabalhos
								select ta.Referencia.ToString()).Distinct();
		var dadosmat = await pMateriais.ToListAsync();

		Materiais = dadosmat;
		Materiais.Insert(0, "Todos");
		StateHasChanged();
	}

	public void Filtro(@Syncfusion.Blazor.DropDowns.SelectEventArgs<string> args)
	{
		if (args.ItemData.ToString() == "Todos")
		{
			Grid.ClearFiltering();
		}
		else
		{
			Grid.FilterByColumn("Referencia", "contains", args.ItemData.ToString());
		}
	}

	public void RecordDoubleClickHandler(RecordDoubleClickEventArgs<Dadosrt> args)
	{
		NavigationManager.NavigateTo("/linha1/relatorio/" + args.RowData.Id);
	}


	private void BackStreetButton()
	{
		NavigationManager.NavigateTo("/linha1/");
	}


	public class Dadosrt
	{
		public string Id { get; set; }
		public string Lote { get; set; }
		public string OF { get; set; }
		public string Suspensao { get; set; }
		public string Referencia { get; set; }
		public string Operador { get; set; }
		public DateTime? Inicio { get; set; }
		public DateTime? Fim { get; set; }
		public string Tempo { get; set; }
		public int? Unidades { get; set; }
		public int? Boas { get; set; }
		public int? Mas { get; set; }
		public int? Teoricas { get; set; }
