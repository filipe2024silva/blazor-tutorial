@page "/linha1/relatorio/{id}"
@using f10.pulsar.mes.Data
@inject NavigationManager NavigationManager
@inject Utils utils
@inject IJSRuntime JSRuntime

<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
                                <p style="margin:0;">Operações recomendadas:</p>
                                <ul>
                                    <li>Verifique se a linha se encontra em funcionamento</li>
                                    <li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
                                    <li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
                                </ul>
                                <div class="row" style="margin-top:1em">
                                    <div class="12u$" style="display: flex;justify-content:flex-start;">
                                        <button @onclick="() => { dbcheckedoff = false; GetDB(); }" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
                                        <a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (utils.CanAccess("RPL1") == true)
            {
                <div class="row">
                    <div class="8u 12u$(medium)">
                        <h1>LINHA 1 - Relatório de Produção</h1>
                        @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                    </div>
                    <div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
                        @* <button @onclick="@(() => { PopupEmail = true; })" title="Enviar Relatório por Email"><i class="icon style1 fa-envelope"></i></button> *@
                        <button style="margin-left:0.5em" @onclick="@(() => { PopupNotas = true; })" title="Adicionar Notas"><i class="icon style1 fa-sticky-note"></i></button>
                        <button style="margin-left:0.5em" @onclick="BackStreetButton" title="Voltar"><i class="icon style1 fa-arrow-left"></i></button>
                    </div>
                </div>


                @if (isupdating == false)
                {
                    <div class="row uniform">
                        <div class="12u">
                            <SfTab>
                                <TabEvents Selected="RenderReportViewer"></TabEvents>
                                <TabItems>
                                    <TabItem>
                                        <ChildContent>
                                            <TabHeader Text="HISTÓRICO DE TRATAMENTO"></TabHeader>
                                        </ChildContent>
                                        <ContentTemplate>
                                            @if (bigalarm == false)
                                            {
                                                @*CABEÇALHO*@
                                                <div class="row" style="margin-top:40px">
                                                    @if (bigrect == false)
                                                    {
                                                        <div class="3u 12u$(medium) align-self-end" style="height:550px;display: flex;justify-content:space-between;flex-direction:column;margin-bottom:40px;">
                                                            @if (Report != null)
                                                            {
                                                                <ul class="alt" style="margin-bottom:1em">
                                                                    <li style="padding:0;">Referência: @Report.Referencia</li>
                                                                    <li style="padding:0;">Lote: @Report.Lote</li>
                                                                    <li style="padding:0;">Operador: @Report.Operador</li>
                                                                    <li style="padding:0;">Ordem Tratamento: @Report.OF</li>
                                                                    <li style="padding:0;">Bastidor: @Report.Suspensao</li>
                                                                    <li style="padding:0; color: red; font-weight: bold; visibility: @IsVisible">Motivo: @Report.Motivo</li>
                                                                    <li style="padding:0;">Programa: @Report.Programa</li>
                                                                    <li style="padding:0;">Nº Peças: @(Report.Unidades) </li>
                                                                    <li style="padding:0;">Prioridade: @Report.Prioridade</li>
                                                                </ul>

                                                                <ul class="alt">
                                                                    <li style="padding:0;">Inicio: @dtini</li>
                                                                    <li style="padding:0;">Fim: @dtfin</li>
                                                                    <li style="padding:0;">Total: @dtt.Value.ToString("hh\\:mm\\:ss")</li>
                                                                </ul>
                                                            }
                                                            @if (Alarmes != null && Alarmes.Count > 0)
                                                            {
                                                                <div class="card text-white bg-danger" @onclick="@(e => AbraAlarm(e))" style="cursor:pointer">
                                                                    <div class="card-body">
                                                                        <p style="margin:0; font-size:16px;"><i class="icon style1 fa-exclamation-triangle"></i> @Alarmes.Count() alarmes durante o tratamento</p>
                                                                    </div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="card text-dark bg-light">
                                                                    <div class="card-body">
                                                                        <p style="margin:0; font-size:16px;">Sem alarmes durante o tratamento</p>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        @if (bigqual == false)
                                                        {
                                                            <div class="3u 12u$(medium)" style="height:500px;display: flex;justify-content:space-between;flex-direction:column;margin-bottom:40px;">
                                                                @if (Qualidade != null && Qualidade.Count > 0)
                                                                {
                                                                    <div style="display: flex; justify-content: space-evenly;">
                                                                        <p style="margin: 0.5em 0 0 0;">Qualidade</p>
                                                                        <button style="margin-left:0.5em" @onclick="@(e => AbracudabracomQualidade(e))" title="Gerir Qualidade"><i class="icon style1 fa-arrow-right"></i></button>
                                                                    </div>
                                                                    <SfAccumulationChart Title="" Width="100%" Height="300" Theme="@utils.ctheme">
                                                                        <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                                                        </AccumulationChartLegendSettings>
                                                                        <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                                                        <AccumulationChartSeriesCollection>
                                                                            <AccumulationChartSeries DataSource="@Qualidade" XName="Key" YName="Value" Radius="70%" InnerRadius="60%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
                                                                                <AccumulationDataLabelSettings Visible="true" Name="text" Position="AccumulationLabelPosition.Outside">
                                                                                    <AccumulationChartDataLabelFont FontWeight="600"></AccumulationChartDataLabelFont>
                                                                                </AccumulationDataLabelSettings>
                                                                            </AccumulationChartSeries>
                                                                        </AccumulationChartSeriesCollection>
                                                                    </SfAccumulationChart>
                                                                    <div class="card text-dark bg-light">
                                                                        <div class="card-body">
                                                                            <p style="margin:0; font-size:16px;">Qualidade: @Qualidade.First().Value % | Conf: @Report.Boas | NConf: @Report.Mas</p>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="6u 12u$(medium)" style="height:500px;display: flex;justify-content:space-between;flex-direction:column;margin-bottom:40px;">
                                                                @if (Rectificador != null && Rectificador.Count > 0)
                                                                {
                                                                    <SfChart Title="Rectificador" Width="100%" Height="400" Theme="@utils.ctheme">
                                                                        <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                        <ChartTooltipSettings Enable="true" Shared="true" Header="<b>${point.x}H</b>" Format="<b>${point.y} </b>"></ChartTooltipSettings>
                                                                        <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" IntervalType="Syncfusion.Blazor.Charts.IntervalType.Minutes" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                                                        </ChartPrimaryXAxis>
                                                                        <ChartPrimaryYAxis Title="Volts" LabelFormat="{value}" Minimum="0" Maximum="30" Interval="3">
                                                                        </ChartPrimaryYAxis>
                                                                        <ChartAxes>
                                                                            <ChartAxis Name="b" Title="Amps" LabelFormat="{value}" Minimum="0" Maximum="2000" Interval="400" OpposedPosition="true">
                                                                                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                                                                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                                                            </ChartAxis>
                                                                        </ChartAxes>
                                                                        <ChartSeriesCollection>
                                                                            <ChartSeries DataSource="@Rectificador" Name="Volts" XName="Data" YName="Tensao" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
                                                                            <ChartSeries DataSource="@Rectificador" Name="Amps" XName="Data" YName="Corrente" Type="ChartSeriesType.Line" Width="3" YAxisName="b"></ChartSeries>
                                                                        </ChartSeriesCollection>
                                                                    </SfChart>
                                                                }
                                                                <div style="display: flex; justify-content: space-between; margin-bottom:10px">
                                                                    <div style="margin-left:1em;">
                                                                        @foreach (var item in Tinas)
                                                                        {
                                                                            if (item.Value == SelectedRect)
                                                                            {
                                                                                <button @onclick="@(e => LoadRect(e, item.Key, item.Value))" class="special" style="margin-right:10px;">@item.Value</button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button @onclick="@(e => LoadRect(e, item.Key, item.Value))" style="margin-right:10px;">@item.Value</button>
                                                                            }
                                                                        }
                                                                    </div>
                                                                    <button @onclick="@(e => Abracudabra(e))" title="Aumentar Gráfico"><i class="icon style1 fa-expand"></i></button>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="3u 12u$(medium)" style="height:500px;display: flex;justify-content:space-between;flex-direction:column;margin-bottom:40px;">
                                                                @if (Qualidade != null && Qualidade.Count > 0)
                                                                {
                                                                    <div style="display: flex; justify-content: space-evenly;">
                                                                        <p style="margin: 0.5em 0 0 0;">Qualidade</p>
                                                                    </div>
                                                                    <SfAccumulationChart Title="" Width="100%" Height="300" Theme="@utils.ctheme">
                                                                        <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                                                        </AccumulationChartLegendSettings>
                                                                        <AccumulationChartTooltipSettings Enable="false"></AccumulationChartTooltipSettings>
                                                                        <AccumulationChartSeriesCollection>
                                                                            <AccumulationChartSeries DataSource="@Qualidade" XName="Key" YName="Value" Radius="70%" InnerRadius="80%" Explode="true" ExplodeOffset="10%" ExplodeIndex="3">
                                                                                <AccumulationDataLabelSettings Visible="true" Name="text" Position="AccumulationLabelPosition.Outside">
                                                                                    <AccumulationChartDataLabelFont FontWeight="600"></AccumulationChartDataLabelFont>
                                                                                </AccumulationDataLabelSettings>
                                                                            </AccumulationChartSeries>
                                                                        </AccumulationChartSeriesCollection>
                                                                    </SfAccumulationChart>
                                                                    <div class="card text-dark bg-light">
                                                                        <div class="card-body">
                                                                            <p style="margin:0; font-size:16px;">Qualidade: @Qualidade.First().Value % | Conf: @Report.Boas | NConf: @Report.Mas</p>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="6u 12u$(medium)" style="height:500px;display: flex;justify-content:space-between;flex-direction:column;margin-bottom:40px;">
                                                                <div style="display: flex; justify-content: flex-end;">
                                                                    <button @onclick="@(() => { PopupListaDefeitos = true; })" title="Lista de Defeitos"><i class="icon style1 fa-chain-broken"></i></button>
                                                                    <button style="margin-left:0.5em" @onclick="@(e => AbracudabracomQualidade(e))" title="Fechar"><i class="icon style1 fa-arrow-left"></i></button>
                                                                </div>
                                                                <div class="row" style="display: flex; justify-content: flex-end; margin:0">
                                                                    <div class="6u 12u$(medium)">
                                                                        @if (qTopChart != null && qTopChart.Count > 0)
                                                                        {
                                                                            //TOP DEFEITOS
                                                                            <SfChart Title="" Width="100%" Height="300" Theme="@utils.ctheme">
                                                                                <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                                <ChartArea>
                                                                                    <ChartAreaBorder Width="0"></ChartAreaBorder>
                                                                                </ChartArea>
                                                                                <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                                                                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                                                                </ChartPrimaryXAxis>
                                                                                <ChartPrimaryYAxis Title="" LabelFormat="{value}" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                                                                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                                                                    <ChartAxisLabelStyle Color="transparent"></ChartAxisLabelStyle>
                                                                                    <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                                                                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                                                                </ChartPrimaryYAxis>
                                                                                <ChartSeriesCollection>
                                                                                    <ChartSeries DataSource="@qTopChart" Name="" XName="Defeito" YName="Num" Type="ChartSeriesType.Bar">
                                                                                        <ChartMarker>
                                                                                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top"></ChartDataLabel>
                                                                                        </ChartMarker>
                                                                                    </ChartSeries>
                                                                                </ChartSeriesCollection>
                                                                            </SfChart>
                                                                        }
                                                                    </div>
                                                                    <div class="6u 12u$(medium)">
                                                                        <SfGrid DataSource="@TabelaListaNconf" AllowFiltering="false" AllowSorting="false" AllowGrouping="false" Width="100%" Height="250">
                                                                            <GridColumns>
                                                                                <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="70">
                                                                                    <Template>
                                                                                        @{
                                                                                            var whois = (context as Qld);
                                                                                            <div style="display: flex; justify-content: space-between;">
                                                                                                <p @onclick="@(() => { Edit_Nconf(whois.Id.ToString()); })" class="icon style1 fa-edit" style="cursor:pointer;margin:1em 0 1em 0;"><span class="label">Editar Não Conformidade</span></p>
                                                                                                <p @onclick="@(() => { Delete_Nconf(whois.Id.ToString()); })" class="icon style1 fa-times" style="cursor:pointer;margin:1em 0 1em 0;"><span class="label">Eliminar Não Conformidade</span></p>
                                                                                            </div>
                                                                                        }
                                                                                    </Template>
                                                                                </GridColumn>
                                                                                <GridColumn Field="Defeito" HeaderText="Defeito"></GridColumn>
                                                                                <GridColumn Field="Num" HeaderText="Unidades"></GridColumn>
                                                                            </GridColumns>
                                                                        </SfGrid>
                                                                    </div>
                                                                </div>
                                                                <div style="display: flex; justify-content: flex-end;">
                                                                    <button class="button special pull-right" @onclick="@(() => { PopupNewNconf = true; })" style="margin:10px">Adicionar</button>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="12u 12u$(medium)" style="height:700px;display: flex;justify-content:space-between;flex-direction:column">
                                                            @if (Rectificador != null && Rectificador.Count > 0)
                                                            {
                                                                <SfChart Title="Rectificador" Width="100%" Height="600" Theme="@utils.ctheme">
                                                                    <ChartTitleStyle Color="@utils.cthemetitle"></ChartTitleStyle>
                                                                    <ChartTooltipSettings Enable="true" Shared="true" Header="<b>${point.x}H</b>" Format="<b>${point.y} </b>"></ChartTooltipSettings>
                                                                    <ChartPrimaryXAxis Title="" ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" IntervalType="Syncfusion.Blazor.Charts.IntervalType.Minutes" EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                                                                    </ChartPrimaryXAxis>
                                                                    <ChartPrimaryYAxis Title="Volts" LabelFormat="{value}" Minimum="0" Maximum="15" Interval="3">
                                                                    </ChartPrimaryYAxis>
                                                                    <ChartAxes>
                                                                        <ChartAxis Name="b" Title="Amps" LabelFormat="{value}" Minimum="0" Maximum="2000" Interval="400" OpposedPosition="true">
                                                                            <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                                                                            <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                                                        </ChartAxis>
                                                                    </ChartAxes>
                                                                    <ChartSeriesCollection>
                                                                        <ChartSeries DataSource="@Rectificador" Name="Volts" XName="Data" YName="Tensao" Type="ChartSeriesType.Line" Width="3"></ChartSeries>
                                                                        <ChartSeries DataSource="@Rectificador" Name="Amps" XName="Data" YName="Corrente" Type="ChartSeriesType.Line" Width="3" YAxisName="b"></ChartSeries>
                                                                    </ChartSeriesCollection>
                                                                </SfChart>
                                                            }
                                                            <div style="display: flex; justify-content: space-between; margin-bottom:10px">
                                                                <div style="margin-left:1em;">
                                                                    @foreach (var item in Tinas)
                                                                    {
                                                                        if (item.Value == SelectedRect)
                                                                        {
                                                                            <button @onclick="@(e => LoadRect(e, item.Key, item.Value))" class="special" style="margin-right:10px;">@item.Value</button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button @onclick="@(e => LoadRect(e, item.Key, item.Value))" style="margin-right:10px;">@item.Value</button>
                                                                        }
                                                                    }
                                                                </div>
                                                                <button @onclick="@(e => Abracudabra(e))"><i class="icon style1 fa-compress"></i></button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                @*TABELA*@
                                                <div>
                                                    @if (THistory != null && THistory.Count > 0)
                                                    {
                                                        <SfGrid DataSource="@THistory" AllowExcelExport="true" AllowResizing="true">
                                                            <GridColumns>
                                                                <GridColumn Field="Tina" HeaderText="Tina" Width="70"></GridColumn>
                                                                <GridColumn Field="Designacao" HeaderText="Designação" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                                <GridColumn HeaderText="TEMPOS">
                                                                    <GridColumns>
                                                                        <GridColumn Field="Tini" HeaderText="Inicial" HideAtMedia="(min-width: 700px)" Width="160"></GridColumn>
                                                                        <GridColumn Field="Tfin" HeaderText="Final" HideAtMedia="(min-width: 700px)" Width="160"></GridColumn>
                                                                        <GridColumn Field="Ttotal" HeaderText="Total" Format="T" TextAlign="TextAlign.Center" Width="100"></GridColumn>
                                                                    </GridColumns>
                                                                </GridColumn>
                                                                <GridColumn HeaderText="TEMPERATURA">
                                                                    <GridColumns>
                                                                        <GridColumn Field="TempSP" HeaderText="SP" HideAtMedia="(min-width: 700px)" TextAlign="TextAlign.Center" Width="70"></GridColumn>
                                                                        <GridColumn Field="TempMed" HeaderText="Med" TextAlign="TextAlign.Center" Width="70"></GridColumn>
                                                                    </GridColumns>
                                                                </GridColumn>
                                                                <GridColumn HeaderText="RECTIFICADOR">
                                                                    <GridColumns>
                                                                        <GridColumn Field="Corrente" HeaderText="A" TextAlign="TextAlign.Center" Width="70"></GridColumn>
                                                                        <GridColumn Field="Tensao" HeaderText="V" TextAlign="TextAlign.Center" Width="70"></GridColumn>
                                                                    </GridColumns>
                                                                </GridColumn>
                                                                <GridColumn Field="Utilizador" HeaderText="Utilizador" HideAtMedia="(min-width: 700px)" Width="100"></GridColumn>
                                                                <GridColumn Field="Estado" HeaderText="Estado" HideAtMedia="(min-width: 700px)" Width="100"></GridColumn>
                                                            </GridColumns>
                                                        </SfGrid>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                @*ALARMES*@
                                                <div style="margin-top: 40px">
                                                    @if (Alarmes != null && Alarmes.Count > 0)
                                                    {
                                                        <div style="display: flex; justify-content: space-between; margin-bottom:10px">
                                                            <div style="display: flex; justify-content:center;">
                                                                <p style="margin-top:1em;margin-bottom:0">@Alarmes.Count() alarmes durante o tratamento</p>
                                                            </div>
                                                            <button @onclick="@(e => AbraAlarm(e))"><i class="icon style1 fa-times"></i></button>
                                                        </div>
                                                        <SfGrid DataSource="@Alarmes">
                                                            <GridColumns>
                                                                <GridColumn Field="DataInicio" HeaderText="Data Início" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                                <GridColumn Field="DataFim" HeaderText="Data Fim" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                                <GridColumn Field="Equip" HeaderText="Equipamento"></GridColumn>
                                                                <GridColumn Field="Ocorrencia" HeaderText="Ocorrência"></GridColumn>
                                                                <GridColumn Field="ReconhecidoPor" HeaderText="Reconhecido por" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                                <GridColumn Field="ReconhecidoEm" HeaderText="Reconhecido em" HideAtMedia="(min-width: 700px)"></GridColumn>
                                                            </GridColumns>
                                                        </SfGrid>
                                                    }
                                                </div>
                                            }
                                        </ContentTemplate>
                                    </TabItem>
                                    <TabItem>
                                        <ChildContent>
                                            <TabHeader Text="RELATÓRIO"></TabHeader>
                                        </ChildContent>
                                        <ContentTemplate>
                                            @*Tive de isolar num IFrame porque aplicava o Css do Report em toda a página*@
                                            <div style="margin-top:20px">
                                                <iframe id="reportFrame" style="width:100%; height:1200px; border:none;"></iframe>
                                            </div>
                                        </ContentTemplate>
                                    </TabItem>

                                </TabItems>
                            </SfTab>
                        </div>
                    </div>

                    @*NOVO NCONF*@
                    <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupNewNconf">
                        <DialogTemplates>
                            <Header>Inserir Não Conformidade</Header>
                            <Content>
                                <SfDropDownList TValue="string" TItem="Dft" Placeholder="Defeito" DataSource="@TabelaListaDefeitos.AsEnumerable()" Width="100%" Style="height:100%;margin-bottom: 10px">
                                    <DropDownListEvents OnValueSelect="@SelDefeito_SelectionChanged" TValue="string" TItem="Dft"></DropDownListEvents>
                                    <DropDownListFieldSettings Value="Defeito" Text="Defeito"></DropDownListFieldSettings>
                                </SfDropDownList>
                                <SfNumericTextBox Placeholder="Unidades" @bind-Value="@uNconf" style="margin-bottom: 10px"></SfNumericTextBox>
                                <SfButton class="button special pull-right" @onclick="@(() => { Add_Nconf(""); })" style="margin:10px">Inserir</SfButton>
                                <SfButton class="button pull-right" @onclick="@(() => { PopupNewNconf = false; idNconf = ""; uNconf = 0; })" style="margin:10px">Cancelar</SfButton>
                            </Content>
                        </DialogTemplates>
                    </SfDialog>
                    @*EDIT NCONF*@
                    <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupEditNconf">
                        <DialogTemplates>
                            <Header>Editar Não Conformidade '@idNconf'</Header>
                            <Content>
                                <SfNumericTextBox Placeholder="Unidades" @bind-Value="@uNconf" style="margin-bottom: 10px"></SfNumericTextBox>
                                <SfButton class="button special pull-right" @onclick="@(() => { Add_Nconf(idNconf); })" style="margin:10px">Guardar</SfButton>
                                <SfButton class="button pull-right" @onclick="@(() => { PopupEditNconf = false; idNconf = ""; uNconf = 0; })" style="margin:10px">Cancelar</SfButton>
                            </Content>
                        </DialogTemplates>
                    </SfDialog>


                    @*LISTA DEFEITOS*@
                    <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupListaDefeitos">
                        <DialogTemplates>
                            <Header>LISTA DE DEFEITOS</Header>
                            <Content>
                                <SfGrid DataSource="@TabelaListaDefeitos" AllowFiltering="false" AllowSorting="false" AllowGrouping="false">
                                    <GridColumns>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="70">
                                            <Template>
                                                @{
                                                    var whois = (context as Dft);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        <p @onclick="@(() => { Edit_Defeito(whois.Id.ToString()); })" class="icon style1 fa-edit" style="cursor:pointer;margin:1em 0 1em 0;"><span class="label">Editar Defeito</span></p>
                                                        <p @onclick="@(() => { Delete_defeito(whois.Id.ToString()); })" class="icon style1 fa-times" style="cursor:pointer;margin:1em 0 1em 0;"><span class="label">Eliminar Defeito</span></p>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="Defeito" HeaderText="Defeito"></GridColumn>
                                    </GridColumns>
                                </SfGrid>
