            DataLink_L1 dl = new DataLink_L1();

            if (tipo == "")
            {
                var checknconf = dl.db.Qualidade.FirstOrDefault(x => x.Lote == lote && x.Referencia == refer && x.Descricao == idNconf);
                if (checknconf == null)
                {
                    dl.db.Qualidade.Add(new sv.data.Qualidade { Lote = lote, Referencia = refer, Descricao = idNconf, Unidades = uNconf });
                    await dl.db.SaveChangesAsync();
                    dl.db.ReferenciaTrabalhos.First(x => x.Lote == lote && x.Referencia == refer).UnidadesMas = dl.db.Qualidade.Where(x => x.Lote == lote && x.Referencia == refer).Sum(h => h.Unidades);
                    await dl.db.SaveChangesAsync();
                    utils.UserLog($"Adicionou {uNconf} unidades não conformes do tipo '{idNconf}' à referência '{refer}' do lote '{lote}'", "DataLink_L1");
                }
                else
                {
                    dl.db.Qualidade.First(x => x.Lote == lote && x.Referencia == refer && x.Descricao == idNconf).Unidades += uNconf;
                    await dl.db.SaveChangesAsync();
                    dl.db.ReferenciaTrabalhos.First(x => x.Lote == lote && x.Referencia == refer).UnidadesMas = dl.db.Qualidade.Where(x => x.Lote == lote && x.Referencia == refer).Sum(h => h.Unidades);
                    await dl.db.SaveChangesAsync();
                    utils.UserLog($"Adicionou {uNconf} unidades não conformes do tipo '{idNconf}' à referência '{refer}' do lote '{lote}'", "DataLink_L1");
                }
            }
            else
            {
                dl.db.Qualidade.First(x => x.Lote == lote && x.Referencia == refer && x.Descricao == idNconf).Unidades = uNconf;
                await dl.db.SaveChangesAsync();
                dl.db.ReferenciaTrabalhos.First(x => x.Lote == lote && x.Referencia == refer).UnidadesMas = dl.db.Qualidade.Where(x => x.Lote == lote && x.Referencia == refer).Sum(h => h.Unidades);
                await dl.db.SaveChangesAsync();
                utils.UserLog($"Alterou as unidades não conformes do tipo '{idNconf}' à referência '{refer}' do lote '{lote}'", "DataLink_L1");
            }
            PopupNewNconf = false;
            PopupEditNconf = false;
            idNconf = "";
