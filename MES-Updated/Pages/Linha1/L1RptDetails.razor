    private async void GetReport()
    {
        DataLink_L1 dl = new DataLink_L1();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        try
        {
            isupdating = true;
            await SpinnerObj.ShowAsync();

            uMessage = "Segue em anexo o relatório de tratamento do lote " + lote + " com a referência " + refer;

            //INFORMAÇÃO
            int qid = Convert.ToInt32(id);
            var preport = from inf in dl.db.ReferenciaTrabalhos
                          join progs in dl.db.PlcProgramas on inf.Campo1 equals progs.Num.ToString()
                          where inf.Id == qid
                          select new rept
                          {
                              Lote = inf.Lote,
                              Referencia = inf.Referencia,
                              Operador = inf.Operador,
                              Notas = inf.Notas,
                              Unidades = inf.Unidades,
                              Boas = inf.Unidades - inf.UnidadesMas,
                              Mas = inf.UnidadesMas,
                              Teoricas = inf.UnidadesTeoricas,
                              OF = inf.Ordemfabrico,
                              Suspensao = inf.Suspensao,
                              Programa = progs.Nome,
                              Prioridade = inf.Prioridade,
                              Motivo = inf.Opcao4,
                              Opcao1 = inf.Opcao1,
                              Opcao4 = inf.Opcao4
                          };
            var dadosReport = await preport.ToListAsync();
            Report = dadosReport.First();
            if (Report.Notas != null)
            {
                Notas = Report.Notas;
            }

            if (Report.Referencia != "" && Report.Opcao1 == true)
            {
                Report.Suspensao = "Reprocessado";
                Report.Motivo = Report.Opcao4;
                IsVisible = "visible";
            }

            if (Report.Referencia == "" && Report.Opcao1 == false)
            {
                Report.Suspensao = "Vazio";
                Report.Motivo = Report.Opcao4;
                IsVisible = "visible";
            }

            if (dadosReport.Count > 0)
            {
                lote = dadosReport[0].Lote;
                refer = dadosReport[0].Referencia;
            }

            //TABELA
            var phistory = from rg in dl.db.Registos
                           where rg.Lote == lote
                           orderby rg.TempoInicial
                           select new regs
                           {
                               Tina = rg.Tina,
                               Designacao = rg.Posicao,
                               Tini = rg.TempoInicial,
                               Tfin = rg.TempoFinal,
                               Ttotal = rg.TempoTotal,
                               TempSP = rg.TemperaturaDesejada,
                               TempMin = rg.TemperaturaMin,
                               TempMax = rg.TemperaturaMax,
                               TempMed = rg.TemperaturaMed,
                               Ph = rg.Ph,
                               Corrente = rg.Corrente,
                               Tensao = rg.Tensao,
                               Utilizador = rg.Operador,
                               Estado = rg.Estado
                           };
            var dadosHist = await phistory.ToListAsync();
            THistory = dadosHist;


            //ALARMES
            dtini = dadosHist.First().Tini;
            dtfin = dadosHist.Last().Tfin;
            if (dtini != null && dtfin != null)
            {
                dtt = dtfin - dtini;
            }
            var pAlarmes = from al in dl.db.Alarmes
                           where (al.DataInicio >= dtini && al.DataInicio <= dtfin) || (al.DataFim >= dtini && al.DataFim <= dtfin) || (al.DataInicio <= dtini && al.DataFim >= dtfin) || (al.DataInicio <= dtini && al.DataFim == null)
                           orderby al.DataInicio
                           select new Alm { Id = al.Id, DataInicio = al.DataInicio, Ocorrencia = al.Ocorrencia, DataFim = al.DataFim, Prioridade = al.Prioridade, ReconhecidoPor = al.ReconhecidoPor, ReconhecidoEm = al.ReconhecidoData };
            var dadosAlarmes = await pAlarmes.ToListAsync();
            Alarmes = dadosAlarmes;


            //RECTIFICADORES
            Tinas.Clear();
            foreach (var rtina in dl.db.Tinas.Where(r => r.Rectificador == true).ToList())
            {
                var regt = dl.db.Registos.FirstOrDefault(l => l.Tina == rtina.Tina1.ToString() && l.Lote == lote);
                if (regt != null)
                {
                    Tinas.Add(rtina.Num.Value, rtina.Tina1);
                }
            }
            if (Tinas != null && Tinas.Count > 0)
            {
                LoadRect(null, Tinas.First().Key, Tinas.First().Value);
            }

            //QUALIDADE
            try
            {
                //QUALIDADE
                var pquality = from ql in dl.db.Qualidade
                               where ql.Lote == lote && ql.Referencia == refer
                               select new pulsar.sv.data.Qualidade { Id = ql.Id, Descricao = ql.Descricao, Unidades = ql.Unidades };
                var dadosQualidade = await pquality.ToListAsync();
                Qualidade.Clear();
                var rep = Report;
                if (rep.Unidades != null && rep.Unidades > 0)
                {
                    var t = (Convert.ToDecimal(rep.Boas) / Convert.ToDecimal(rep.Unidades)) * (decimal)100.0;
                    Qualidade.Add(new KVPStringDecimal("% Conforme", Math.Round(t, 1)));
                    Qualidade.Add(new KVPStringDecimal("% Não Conforme", 100 - Math.Round(t, 1)));
                }
                else
                {
                    Qualidade.Add(new KVPStringDecimal("% Conforme", 100));
                    Qualidade.Add(new KVPStringDecimal("% Não Conforme", 0));
                }
                TabelaListaNconf.Clear();
                foreach (pulsar.sv.data.Qualidade nconfor in dadosQualidade)
                {
                    Qld nitem = new Qld() { };
                    nitem.Id = nconfor.Id;
                    nitem.Defeito = nconfor.Descricao;
                    nitem.Num = (int)nconfor.Unidades;
                    TabelaListaNconf.Add(nitem);
                }
                qTopChart = TabelaListaNconf.OrderBy(x => x.Num).ToList();

                //DEFEITOS
                var pListDefeitos = from Qld in dl.db.QualidadeDefeitos
                                    select new Dft { Defeito = Qld.Defeito, Id = Qld.Id };
                TabelaListaDefeitos = await pListDefeitos.ToListAsync();

                dl.Dispose();
            }
            catch (Exception)
            {
            }

            await SpinnerObj.HideAsync();
            isupdating = false;
            StateHasChanged();
            dl.Dispose();
        }
        catch (Exception)
        {
            await SpinnerObj.HideAsync();
            isupdating = false;
            StateHasChanged();
            dl.Dispose();
        }
    }
    private async void LoadRect(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, int ntina, string tina)
    {
        DataLink_L1 dlrect = new DataLink_L1();
        dlrect.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var reg = dlrect.db.Registos.FirstOrDefault(l => l.Tina == tina && l.Lote == lote);
        DateTime? di = reg.TempoInicial;
        DateTime? df = reg.TempoFinal;
        if (df == null)
        {
            df = dlrect.db.Registos.Where(l => l.Lote == lote && l.TempoFinal != null).ToList().Last().TempoFinal;
        }
        var pRect = from rec in dlrect.db.Rectificadors
                    where rec.Data > di && rec.Data < df && rec.Tina == ntina.ToString()
                    orderby rec.Data
                    select new pulsar.sv.data.Rectificador { Tina = rec.Tina, Data = rec.Data, Tensao = rec.Tensao, Corrente = rec.Corrente };
        var dadosRectificador = await pRect.ToListAsync();
        Rectificador = new ObservableCollection<pulsar.sv.data.Rectificador>(dadosRectificador);
        await Task.Delay(100);

        SelectedRect = tina;
        StateHasChanged();
        dlrect.Dispose();
    }
    private async void LoadPdf(Syncfusion.Blazor.Navigations.SelectEventArgs args)
    {
        if (args.SelectedIndex == 1)
        {
            await SpinnerObj.ShowAsync();
            string base64String = "";
            await Task.Run(() =>
            {
                try
                {
                    f10.networking.tcp.basicTcpClient reportServer = new f10.networking.tcp.basicTcpClient();
                    reportServer.Connect(Utils.IP_RS_L1, Utils.PORTA_RS_L1); //no futuro o IP do reportServer deve vir das configs/local settings
                    reportServer.TcpClient.NoDelay = true;
                    byte[] Buffer = reportServer.WriteLineAndGetReply($"RelatorioTratamento|pdf|{lote + "|" + refer}|", TimeSpan.FromSeconds(20)).Data;
                    reportServer.Disconnect();
                    base64String = Convert.ToBase64String(Buffer);
                }
                catch (Exception)
                {
                    ErroTitle = "ERRO";
                    ErroMsg = "Sem ligação ao reportserver";
                    PopupErro = true;
                }
            });
            docPath = "data:application/pdf;base64," + base64String;

            await SpinnerObj.HideAsync();
            StateHasChanged();
        }
    }


