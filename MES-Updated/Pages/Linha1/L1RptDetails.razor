    private async void GetDB()
    {
        DataLink_L1 DL1 = new DataLink_L1();

        if (await DL1.db.Database.CanConnectAsync())
        {
            utils.L1ON = true;
            dbchecked = true;
            dbcheckedoff = false;
            DL1.Dispose();
            StateHasChanged();
            GetReport();
        }
        else
        {
            utils.L1ON = false;
            dbchecked = false;
            dbcheckedoff = true;
            DL1.Dispose();
            StateHasChanged();
        }
