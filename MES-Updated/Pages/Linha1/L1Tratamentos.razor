	private async void GetDB()
	{
		DataLink_L1 DL1 = new DataLink_L1();

		if (await DL1.db.Database.CanConnectAsync())
		{
			utils.L1ON = true;
			dbchecked = true;
			dbcheckedoff = false;
			DL1.Dispose();
			StateHasChanged();
			SearchData();

		}
		else
		{
			utils.L1ON = false;
			dbchecked = false;
			dbcheckedoff = true;
			DL1.Dispose();
			StateHasChanged();
		}
	}

	private async void SearchData()
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		Tempos_Ativos = dl.db.Receitas.Where(x => x.IsActive == true && x.IsDeleted == false).ToList();

		var tinasList = from dt in dl.db.Tinas
						select new pulsar.sv.data.Tina { Id = dt.Id, Num = dt.Num, Designacao = dt.Designacao, Tina1 = dt.Tina1, CorBanho = dt.CorBanho };

		Ttinas = tinasList.ToList();

		StateHasChanged();
		await SpinnerObj.HideAsync();
		dl.Dispose();
	}

