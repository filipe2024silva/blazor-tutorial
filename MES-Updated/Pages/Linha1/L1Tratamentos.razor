	private async void addTempo(int id)
	{
		await SpinnerObj.ShowAsync();
		DataLink_L1 dl = new DataLink_L1();
		StringBuilder b = new StringBuilder();

		ToastContent = "";
		Disabled = true;

		bool repetidoOUnao = dl.db.Receitas.Any(x => x.Nome.ToLower() == seleTempos.Nome.ToLower());

		if (repetidoOUnao)
		{
			Disabled = false;
			await SpinnerObj.HideAsync();
			await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = "Já existe um tratamento com este nome.", Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			return;
		}

		if (ValidaTempos() == true)
		{
			lenght = 1;
		}
		else
		{
			lenght = 0;
			b.Append("Campo inválido!");
			ToastContent = ToastContent + b;
			StateHasChanged();
			await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
		}

		if (CalculaTemposPassivadores() == true)
		{
			int p = RetornaNumeroPassivadores();

			if (p != 0 && p != 1)
			{
				lenght = 0;
				b.Append("O Tratamento só pode ter tempos num dos Passivadores!");
				ToastContent = ToastContent + b;
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			}
		}

		if (String.IsNullOrEmpty(seleTempos.Nome) == false && lenght == 1 && repetidoOUnao == false && id == 0)
		{
			if (AdicionaTempos() == true)
			{
				listaTempos.Clear();
				PopupNewTempo = false;
				PopupEditTempo = false;
				activeCopy = false;
				seleTempos = new pulsar.sv.data.Receita() { };
				idTempo = 0;
				ToastContent = "";
			}
			else
			{
				b.Append("Erro ao guardar Artigo!");
				ToastContent = ToastContent + b;
				StateHasChanged();
				await this.ToastObj.ShowAsync(new ToastModel { Title = "Erro", Content = ToastContent, Timeout = 15000, ShowCloseButton = true, Icon = "e-meeting", CssClass = "e-toast-danger" });
			}
		}


		SearchData();
		Disabled = false;
		await SpinnerObj.HideAsync();
		StateHasChanged();
		dl.Dispose();
	}

