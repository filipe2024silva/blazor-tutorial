@page "/linha1/tratamentos"
@using Microsoft.Data.SqlClient
@inject NavigationManager NavigationManager
@inject Utils utils

<div id="main">
	<div class="inner">

		@if (dbchecked == false)
		{
			<div class="row uniform" style="margin-top:20px">
				<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
					<div class="card text-dark bg-light">
						<div class="card-body">
							@if (dbcheckedoff == false)
							{
								<div>
									<div class="bounceball"></div>
									<div class="bounceballtext">A verificar ligação à base de dados</div>
								</div>
							}
							else
							{
								<h3 style="margin:0;">Sem ligação à base de dados da Linha 1.</h3>
								<p style="margin:0;">Operações recomendadas:</p>
								<ul>
									<li>Verifique se a linha se encontra em funcionamento</li>
									<li>Verifique o estado dos cabos no switch da linha, e se necessário reinicie o switch</li>
									<li>Verifique o estado dos cabos no switch do bastidor de rede, e se necessário reinicie o switch</li>
								</ul>
								<div class="row" style="margin-top:1em">
									<div class="12u$" style="display: flex;justify-content:flex-start;">
										<button @onclick="()=> { dbcheckedoff = false; GetDB();}" title="Voltar a testar a ligação"><i class="icon style1 fa-refresh"></i></button>
										<a href="/" class="special button" style="margin-left:0.5em">Voltar</a>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			@if (utils.CanAccess("TTL1") == true)
			{
				<div class="row">
					<div class="8u 12u$(medium)">
						<h1>LINHA 1 - Tratamentos</h1>
					</div>
					<div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
						<button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
						<button class="noprint" onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
						<button @onclick="@(() =>{ SearchData(); })" title="Atualizar"><i class="icon style1 fa-refresh"></i></button>
						<button @onclick="@(()=> { PopupNewTempo = true; LoadTinas(); })" title="Inserir Tratamentos"><i class="icon style1 fa-plus"></i></button>
					</div>
				</div>

				<div class="row uniform">

					@if (Tempos_Ativos != null && Tempos_Ativos.Count() > 0)
					{
						<div>
							<SfGrid @ref="@Grid" DataSource="@Tempos_Ativos" AllowFiltering="false" AllowSorting="false" AllowGrouping="false">
								<GridColumns>
									<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="20" MinWidth="20">
										<Template>
											@{
												var whois = (context as pulsar.sv.data.Receita);
												<div style="display: flex; justify-content: space-between;">
													<p @onclick="@(()=> { Edit_Tempo(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label">Editar</span></p>
													<p @onclick="@(()=> { makeCopy(whois.Id); })" class="icon style1 fa-copy" style="margin:0.3em;cursor:pointer"><span class="label">Copiar</span></p>
												</div>
											}
										</Template>
									</GridColumn>
									<GridColumn Field="Id" HeaderText="ID " Width="110"> </GridColumn>
									<GridColumn Field="Nome" HeaderText="Nome" Width="110"> </GridColumn>
									<GridColumn Field="Dtcreated" HeaderText="Data Criação" Type="ColumnType.Date" Width="110"> </GridColumn>
								</GridColumns>
							</SfGrid>
						</div>
					}
					else
					{
						<div class="row uniform" style="margin-top:20px">
							<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
								<div class="card text-dark bg-light">
									<div class="card-body">
										<p style="margin:0;">Sem tratamentos registados.</p>
									</div>
								</div>
							</div>
						</div>
					}

				</div>

				@*Adicionar*@
				<SfDialog Target="#target" Width="1275px" Height="auto" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="PopupNewTempo">
					<DialogTemplates>
						<Header>Adicionar Tratamento</Header>
						<Content>

							<SfTab @ref="newtab">
								<TabItems>
									<div class="table-wrapper" style="margin:1em;">
										<table>
											<tbody>
												<tr style="border:0px;background-color:#fff">
													<td>Nome</td>
													<td><SfTextBox Multiline="false" @bind-Value="@seleTempos.Nome" Width="100%" Style="height:40px"></SfTextBox></td>
												</tr>
											</tbody>
										</table>
									</div>

									<TabItem>
										<ChildContent>
											<TabHeader Text="TEMPOS"></TabHeader>
										</ChildContent>
										<ContentTemplate>

											@foreach (ReceitaStepsDTO t in listaTempos.Where(o=> !TinasNotShowList.Contains(o.Num.Value)))
											{
												
												<section style="margin:3em">
													<div class="row uniform">

														<div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title">@t.Designacao</div>
																		<div class="kpi2__subtitle">Designação</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TP</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Permanência</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TE</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T2" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Escorrimento</div>
																	</div>
																</div>
															</div>
														</div>

													</div>
												</section>
											}

										</ContentTemplate>
									</TabItem>

									<TabItem>
										<ChildContent>
											<TabHeader Text="RETIFICADORES"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											@foreach (ReceitaStepsDTO t in listaTempos.Where(o => TinasRectificadorList.Contains(o.Num.Value)))
											{

												<section style="margin:3em">
													<div class="row uniform">


														<div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title">@t.Designacao</div>
																		<div class="kpi2__subtitle">Designação</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TA</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Aceleração</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1max" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Desaceleração</div>
																	</div>
																</div>
															</div>
														</div>

													</div>

													<div class="row uniform">

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao5" Width="65%" Min="0" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
																		<div class="kpi2__subtitle">Corrente (Amp/dm2)</div>
																	</div>
																</div>
															</div>
														</div>


														<div class="2u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao3" Width="65%" Min="0" Max="100" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
																		<div class="kpi2__subtitle">% Final</div>
																	</div>
																</div>
															</div>
														</div>


														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Pausa</div>
																	</div>
																</div>
															</div>
														</div>

													</div>
												</section>

											}

										</ContentTemplate>
									</TabItem>
								</TabItems>
							</SfTab>
							<SfButton class="button special pull-right" Disabled="@Disabled" @onclick="@(()=> { addTempo(0); })" style="margin:10px">Guardar</SfButton>
							<SfButton class="button pull-right" Disabled="@Disabled" @onclick="@(()=> { PopupNewTempo = false; idTempo = 0; seleTempos = new pulsar.sv.data.Receita() { }; })" style="margin:10px">Cancelar</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>

				@*Editar*@
				<SfDialog Target="#target" Width="1275px" Height="auto" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="PopupEditTempo">
					<DialogTemplates>
						<Header>Gerir Tratamento</Header>
						<Content>
							<SfTab @ref="edittab">
								<TabItems>

									<div class="table-wrapper" style="margin:1em;">
										<table>
											<tbody>
												<tr style="border:0px;background-color:#fff">
													<td>Nome</td>
													<td><SfTextBox Multiline="false" @bind-Value="@seleTempos.Nome" Width="100%" Style="height:40px"></SfTextBox></td>
												</tr>
											</tbody>
										</table>
									</div>

									<TabItem>
										<ChildContent>
											<TabHeader Text="TEMPOS"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											@foreach (ReceitaStepsDTO t in listaTempos.Where(o => !TinasNotShowList.Contains(o.Num.Value)))
											{

												<section style="margin:2em">
													<div class="row uniform">

														<div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title">@t.Designacao</div>
																		<div class="kpi2__subtitle">Designação</div>
																	</div>
																</div>
															</div>

														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TP</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Permanência</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TE</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T2" Width="42%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Escorrimento</div>
																	</div>
																</div>
															</div>
														</div>

													</div>
												</section>

											}

										</ContentTemplate>
									</TabItem>

									<TabItem>
										<ChildContent>
											<TabHeader Text="RETIFICADORES"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											@foreach (ReceitaStepsDTO t in listaTempos.Where(o => TinasRectificadorList.Contains(o.Num.Value)))
											{

												<section style="margin:3em">
													<div class="row uniform">


														<div class="5u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title">@t.Designacao</div>
																		<div class="kpi2__subtitle">Designação</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TA</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' Placeholder="000:00" @bind-Value="@t.T1min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Aceleração</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T1max" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Desaceleração</div>
																	</div>
																</div>
															</div>
														</div>

													</div>

													<div class="row uniform">

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: @t.CorBanho;" class="kpi2__icon fa text-light">@t.Num</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao5" Width="65%" Min="0" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
																		<div class="kpi2__subtitle">Corrente Total (Amp)</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="2u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfNumericTextBox @bind-Value="@t.Opcao3" Width="65%" Min="0" Max="100" ShowSpinButton=false style="Height: 30px;"></SfNumericTextBox></div>
																		<div class="kpi2__subtitle">% Final</div>
																	</div>
																</div>
															</div>
														</div>

														<div class="3u 12u$(medium) align-self-end" style="display: flex; justify-content: space-between; flex-direction: column">
															<div class="kpi2">
																<div class="kpi2__inside">
																	<i style="background-color: white;" class="kpi2__icon fa text-light">TD</i>
																	<div class="kpi2__text">
																		<div class="kpi2__title"><SfMaskedTextBox Mask='000:00' @bind-Value="@t.T2min" Width="65%" style="Height: 30px;"></SfMaskedTextBox></div>
																		<div class="kpi2__subtitle">Tempo Pausa</div>
																	</div>
																</div>
															</div>
														</div>

													</div>
												</section>
											}

										</ContentTemplate>
									</TabItem>
								</TabItems>
							</SfTab>
							@if (activeCopy == false)
							{
								<SfButton class="button pull-left" @onclick="@(()=> { PopDelTempo = true; })" style="margin:10px">Eliminar</SfButton>
								<SfButton class="button special pull-right" @onclick="@(()=> { editTempo(idTempo); })" style="margin:10px">Guardar</SfButton>
								<SfButton class="button pull-right" @onclick="@(()=> { PopupEditTempo = false; idTempo = 0; seleTempos = new pulsar.sv.data.Receita() { }; listaTempos.Clear();  })" style="margin:10px">Cancelar</SfButton>
							}
							else
							{
								<SfButton class="button special pull-right" @onclick="@(()=> { addTempo(0); activeCopy = false; })" style="margin:10px">Copiar</SfButton>
								<SfButton class="button pull-right" @onclick="@(()=> { PopupEditTempo = false; idTempo = 0; seleTempos = new pulsar.sv.data.Receita() { }; listaTempos.Clear(); activeCopy = false; })" style="margin:10px">Cancelar</SfButton>
							}
						</Content>
					</DialogTemplates>
				</SfDialog>

				@*Eliminar*@
				<SfDialog Width="400px" ShowCloseIcon="false" IsModal="true" CloseOnEscape="false" @bind-Visible="@PopDelTempo">
					<DialogTemplates>
						<Header>Eliminar Tempo</Header>
						<Content>
							<p>
								A eliminação é permanente.<br />
								Pretende realmente eliminar os tempos?
							</p>
							<SfButton class="button special pull-right" @onclick="@(() => { Remove_Tempo(idTempo); })" style="margin:10px">Sim</SfButton>
							<SfButton class="button pull-right" @onclick="@(() => { PopDelTempo = false; })" style="margin:10px">Não</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>
			}
			else
			{
				<div class="row uniform" style="margin-top:20px">
					<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
						<div class="card text-dark bg-light">
							<div class="card-body">
								<p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
								<a href="/">Voltar</a>
							</div>
						</div>
					</div>
				</div>
			}

			<div class="col-lg-12 control-section toast-default-section">
				<SfToast ID="toast_default" @ref="ToastObj"></SfToast>
			</div>
		}
		<SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>
	</div>
</div>

<style>
	#toast_default .e-meeting::before {
	content: "\e705";
	font-size: 17px;
	}

	.bootstrap4 #toast_default .e-meeting::before {
	content: "\e763";
	font-size: 20px;
	}
</style>

@code {
	SfToast ToastObj = new SfToast();
	SfSpinner SpinnerObj = new SfSpinner();
	SfGrid<pulsar.sv.data.Receita>? Grid;
	SfTab newtab = new SfTab();
