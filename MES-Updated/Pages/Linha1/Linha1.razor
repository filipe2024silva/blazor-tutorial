@code {
    bool dbchecked = false, dbcheckedoff = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckDatabaseAsync();
    }

    private async Task CheckDatabaseAsync()
    {
        try
        {
            var canConnect = await Linha1Service.CanConnectAsync();

            Utils.L1ON = canConnect;
            dbchecked = canConnect;
            dbcheckedoff = !canConnect;
        }
        catch
        {
            Utils.L1ON = false;
            dbchecked = false;
            dbcheckedoff = true;
        }
    }


    private void BackStreetButton()
    {
        NavigationManager.NavigateTo("/linha1/");
    }

}
