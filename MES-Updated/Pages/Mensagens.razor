@page "/mensagens"
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Utils utils
<!-- Main -->
<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <p style="margin:0;">Sem ligação à base de dados Geral.</p>
                                <a href="/" class="special button" style="margin-top:1em">Voltar</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="8u 12u$(medium)">
                    <h1>Mensagens</h1>
                    @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                </div>
                <div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
                    <button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                    <button class="noprint" onclick="window.print()" title="Imprimir"><i class="icon style1 fa-print"></i></button>
                    <button @onclick="@(()=> { novomessage(); })" title="Nova Mensagem"><i class="icon style1 fa-plus"></i></button>
                </div>
            </div>

            <div class="row uniform">
                <SfTab>
                    <TabItems>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="RECEBIDAS"></TabHeader>
                            </ChildContent>
                            <ContentTemplate>
                                @if (GMessages != null && GMessages.Count > 0)
                                {
                                    @*TABELA*@
                                    <div>
                                        <SfGrid @ref="@Grid" DataSource="@GMessages" AllowFiltering="true" AllowSorting="true" AllowGrouping="true">
                                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                            <GridEvents OnRecordDoubleClick="RecordDoubleClickHandler" QueryCellInfo="CustomizeCell" TValue="msg"></GridEvents>
                                            <GridColumns>
                                                <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
                                                    <Template>
                                                        @{
                                                    var whois = (context as msg);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        <p @onclick="@(()=> { readmessage(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label">Ler</span></p>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" TextAlign="TextAlign.Right" Width="50">
                                            <Template>
                                                @{
                                                    var whois1 = (context as msg);
                                                    <div>
                                                        @if (whois1.pic != null)
                                                        {
                                                            <span><img src="@picture(whois1.pic)" style="width:32px;height:32px;object-fit:cover;border-radius: 50%;border: 1px solid black;" /></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="e-avatar e-avatar-circle e-color-@(whois1.Avatar)" style="width:32px;height:32px;object-fit:cover;border-radius: 50%;">@(whois1.Avatar)</span>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="From" HeaderText="Enviado por"></GridColumn>
                                        <GridColumn Field="Date" HeaderText="Data de envio" Type="ColumnType.DateTime"></GridColumn>
                                        <GridColumn Field="Lida" HeaderText="">
                                            <Template>
                                                @{
                                                    var whois1 = (context as msg);
                                                    <div>
                                                        @if (whois1.Lida == "")
                                                        {
                                                            <span class="e-badge e-badge-info">não lida</span>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                                }
                                else
                                {
                                    <div class="row uniform" style="margin-top:20px">
                                        <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                            <div class="card text-dark bg-light">
                                                <div class="card-body">
                                                    <p style="margin:0;">Sem mensagens recebidas.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="ENVIADAS"></TabHeader>
                            </ChildContent>
                            <ContentTemplate>
                                @if (SMessages != null && SMessages.Count > 0)
                                {
                                    @*TABELA*@
                                    <div>
                                        <SfGrid @ref="@Grid2" DataSource="@SMessages" AllowFiltering="true" AllowSorting="true" AllowGrouping="true">
                                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                            <GridEvents OnRecordDoubleClick="SendRecordDoubleClickHandler" QueryCellInfo="SendCustomizeCell" TValue="msg"></GridEvents>
                                            <GridColumns>
                                                <GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
                                                    <Template>
                                                        @{
                                                    var whois = (context as msg);
                                                    <div style="display: flex; justify-content: space-between;">
                                                        <p @onclick="@(()=> { editmessage(whois.Id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label">Editar</span></p>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="To" HeaderText="Enviada a">
                                            <Template>
                                                @{
                                                    var whois1 = (context as msg);
                                                    foreach (msgto item in whois1.ListaTo)
                                                    {
                                                        <div style="display: flex; justify-content: left;">
                                                            @if (item.pic != null)
                                                            {
                                                                <span><img src="@picture(item.pic)" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%; border: 1px solid black; margin: 0.1em;" /></span>
                                                            }
                                                            else
                                                            {
                                                                if (item.user == "All")
                                                                {
                                                                    <span class="e-avatar e-avatar-circle" style="width:32px;height:32px;object-fit:cover;border-radius: 50%; margin:0.1em;">TD</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="e-avatar e-avatar-circle e-color-@(item.nome.Substring(0,1))" style="width:32px;height:32px;object-fit:cover;border-radius: 50%; margin:0.1em;">@(item.nome.Substring(0, 1))</span>
                                                                }
                                                            }
                                                            <p style="margin:0; margin-left:0.2em; margin-top:0.5em">@item.nome</p>
                                                        </div>
                                                    }
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="Date" HeaderText="Data" Type="ColumnType.DateTime" HideAtMedia="(min-width: 700px)"></GridColumn>
                                        <GridColumn Field="Lida" HeaderText="">
                                            <Template>
                                                @{
                                                    var whois1 = (context as msg);
                                                    <div>
                                                        @if (whois1.Lida == "")
                                                        {
                                                            <span class="e-badge e-badge-info">não lida</span>
                                                        }
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                                }
                                else
                                {
                                    <div class="row uniform" style="margin-top:20px">
                                        <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                                            <div class="card text-dark bg-light">
                                                <div class="card-body">
                                                    <p style="margin:0;">Sem mensagens enviadas</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab>
            </div>


            @*ADICIONAR*@
            <SfDialog Target="#target" Width="800px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupNewMessage">
                <DialogTemplates>
                    <Header>Nova Mensagem</Header>
                    <Content>
                        <div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
                            <div class="6u 12u$(medium)">
                                <div style="justify-content: left; margin:0.5em">
                                    <p style="margin:0;margin-top:10px;">Enviar (utilize o botão ctrl para selecionar vários)</p>
                                    <SfListBox @ref="SfListBoxNew" DataSource="@ListContacts" TValue="string[]" TItem="DataModel" CssClass="e-list-template" Width="350" @bind-Value="@SelUsers">
                                        <ListBoxFieldSettings Value="Utilizador" Text="Text"></ListBoxFieldSettings>
                                        <ListBoxSelectionSettings Mode="Syncfusion.Blazor.DropDowns.SelectionMode.Multiple"></ListBoxSelectionSettings>
                                        <ListBoxTemplates TItem="DataModel">
                                            <ItemTemplate>
                                                <div class="e-list-wrapper e-list-multi-line e-list-avatar">
                                                    @if (((context as DataModel).Pic) == null)
                                                    {
                                                        if (((context as DataModel).Avatar) != "")
                                                        {
                                                            <span class="e-avatar e-avatar-circle e-color-@((context as DataModel).Avatar)">@((context as DataModel).Avatar)</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="e-avatar e-avatar-circle"><img src="@picture((context as DataModel).Pic)" /></span>
                                                    }
                                                    <span class="e-list-item-header">@((context as DataModel).Nome)</span>
                                                </div>
                                            </ItemTemplate>
                                        </ListBoxTemplates>
                                    </SfListBox>
                                </div>
                            </div>
                            <div class="6u 12u$(medium)">
                                <div style="justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Mensagem</p>
                                    <SfTextBox Multiline="true" Placeholder="" @bind-Value="@selmessage.Mensagem" style="height:250px;margin-left:10px;margin-top:10px;padding:0"></SfTextBox>
                                </div>
                            </div>
                        </div>
                        <SfButton class="button special pull-right" @onclick="@(()=> { Add_Message(0); })" style="margin:10px">Guardar</SfButton>
                        <SfButton class="button pull-right" @onclick="@(()=> { PopupNewMessage = false; idMessage = 0; selmessage = new msg() { }; })" style="margin:10px">Cancelar</SfButton>
                    </Content>
                </DialogTemplates>
            </SfDialog>
            @*EDITAR*@
            <SfDialog Target="#target" Width="800px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupEditMessage">
                <DialogTemplates>
                    <Header>Editar Mensagem</Header>
                    <Content>
                        <div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
                            <div class="6u 12u$(medium)">
                                <div style="justify-content: left; margin:0.5em">
                                    <p style=";margin:0;margin-top:10px;">Enviada (utilize o botão ctrl para selecionar vários)</p>
                                    <SfListBox @ref="SfListBoxEdit" DataSource="@ListContacts" TValue="string[]" TItem="DataModel" CssClass="e-list-template" Width="350" @bind-Value="@SelUsers">
                                        <ListBoxFieldSettings Value="Utilizador" Text="Text"></ListBoxFieldSettings>
                                        <ListBoxSelectionSettings Mode="Syncfusion.Blazor.DropDowns.SelectionMode.Multiple"></ListBoxSelectionSettings>
                                        <ListBoxTemplates TItem="DataModel">
                                            <ItemTemplate>
                                                <div class="e-list-wrapper e-list-multi-line e-list-avatar">
                                                    @if (((context as DataModel).Pic) == null)
                                                    {
                                                        if (((context as DataModel).Avatar) != "")
                                                        {
                                                            <span class="e-avatar e-avatar-circle e-color-@((context as DataModel).Avatar)">@((context as DataModel).Avatar)</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="e-avatar e-avatar-circle"><img src="@picture((context as DataModel).Pic)" /></span>
                                                    }
                                                    <span class="e-list-item-header">@((context as DataModel).Nome)</span>
                                                </div>
                                            </ItemTemplate>
                                        </ListBoxTemplates>
                                    </SfListBox>
                                </div>
                            </div>
                            <div class="6u 12u$(medium)">
                                <div style="justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Mensagem</p>
                                    <SfTextBox Multiline="true" Placeholder="" @bind-Value="@selmessage.Mensagem" style="height:100px;margin-left:10px;margin-top:10px;padding:0"></SfTextBox>
                                </div>
                                <div style="justify-content: left; margin:0.5em">
                                    <p style="width:8em;margin:0;margin-top:10px;">Lida por</p>
                                    @{
                                        if (selmessage.Lida != null && selmessage.Lida != "")
                                        {
                                            foreach (msgto item in selmessage.LidaPor)
                                            {
                                                <div style="display: flex; justify-content: left;">
                                                    @if (item.pic != null)
                                                    {
                                                        <span><img src="@picture(item.pic)" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%; border: 1px solid black; margin: 0.1em;" /></span>
                                                    }
                                                    else
                                                    {
                                                        if (item.user != "")
                                                        {
                                                            <span class="e-avatar e-avatar-circle e-color-@(item.nome.Substring(0,1))" style="width:32px;height:32px;object-fit:cover;border-radius: 50%; margin:0.1em;">@(item.nome.Substring(0, 1))</span>
                                                        }
                                                    }
                                                    <p style="margin:0; margin-left:0.2em; margin-top:0.5em">@item.nome</p>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p style="margin:0;margin-top:10px;">Ainda nenhum utilizador leu esta mensagem!</p>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        @if (selmessage.Id != 0)
                        {
                            <SfButton class="button special pull-left" @onclick="@(()=> { PopupDelMessage=true; })" style="margin:10px">Eliminar</SfButton>
                        }
                        <SfButton class="button special pull-right" @onclick="@(()=> { Add_Message(idMessage); })" style="margin:10px">Guardar</SfButton>
                        <SfButton class="button pull-right" @onclick="@(()=> { PopupEditMessage = false; idMessage = 0; selmessage = new msg() { }; })" style="margin:10px">Cancelar</SfButton>
                    </Content>
                </DialogTemplates>

            </SfDialog>

            <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelMessage">
                <DialogTemplates>
                    <Header>Eliminar Mensagem</Header>
                    <Content>
                        <p>
                            A eliminação da mensagem é permanente.<br />
                            Pretende realmente eliminar a mensagem?
                        </p>
                        <SfButton class="button special pull-right" @onclick="@(()=> { Del_Message(selmessage.Id); })" style="margin:10px">Sim</SfButton>
                        <SfButton class="button pull-right" @onclick="@(()=> { PopupDelMessage=false; })" style="margin:10px">Não</SfButton>
                    </Content>
                </DialogTemplates>
            </SfDialog>



            @*LER*@
            <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupReadMessage">
                <DialogTemplates>
                    <Header>Mensagem</Header>
                    <Content>
                        <div style="display: flex; justify-content: left; margin:0.5em">
                            <p style="width:8em;margin:0;margin-top:10px;">Enviada por</p>
                            @if (selmessage.pic != null)
                            {
                                <img src="@picture(selmessage.pic)" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%; border: 1px solid black; margin: 0; margin-left: 10px; margin-top: 5px; padding: 0" />
                            }
                            else
                            {
                                <span class="e-avatar e-avatar-circle e-color-@(selmessage.Avatar)" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%; margin: 0; margin-left: 10px; margin-top: 5px; padding: 0">@(selmessage.Avatar)</span>
                            }
                            <p style="margin: 0; margin-left: 10px; margin-top: 10px; padding: 0">@selmessage.From</p>
                        </div>
                        <div style="display: flex; justify-content: left; margin:0.5em">
                            <p style="width:8em;margin:0;margin-top:10px;">Data</p>
                            <p style="margin: 0; margin-left: 10px; margin-top: 10px; padding: 0">@selmessage.Date</p>
                        </div>
                        <div style="display: flex; justify-content: left; margin:0.5em">
                            <p style="width:8em;margin:0;margin-top:10px;">Mensagem</p>
                            <p style="min-height: 100px; margin: 0; margin-left: 10px; margin-top: 10px; padding: 0 ">@selmessage.Mensagem</p>
                        </div>
                        <SfButton class="button special pull-right" @onclick="@(()=> { Mensagem_Lida(idMessage); })" style="margin:10px">Fechar</SfButton>
                    </Content>
                </DialogTemplates>
            </SfDialog>

        }

        @*LOADING*@
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>


    </div>
</div>


@code {
    SfGrid<msg> Grid;
    SfGrid<msg> Grid2;
    SfSpinner SpinnerObj = new SfSpinner();

    bool dbchecked = false, dbcheckedoff = false;
    SfListBox<string[], DataModel> SfListBoxNew;
    SfListBox<string[], DataModel> SfListBoxEdit;
    User who = new User();
    public List<msg> GMessages = new List<msg>() { };
    public List<msg> SMessages = new List<msg>() { };
    public string[] SelUsers = new string[] { };

    List<DataModel> ListContacts = new List<DataModel>();


    protected override void OnInitialized()
    {
        who = (User)utils.f10session["user"];
        base.OnInitialized();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == true)
        {
            GetDB();
        }
        base.OnAfterRender(firstRender);
    }
    private async void GetDB()
    {
        DataLink_MES dlm = new DataLink_MES();

        if (await dlm.db.Database.CanConnectAsync())
        {
            utils.MESON = true;
            dbchecked = true;
            dbcheckedoff = false;
            dlm.Dispose();
            StateHasChanged();
            SearchMessages();
        }
        else
        {
            utils.MESON = false;
            dbchecked = false;
            dbcheckedoff = true;
            dlm.Dispose();
            StateHasChanged();
        }
    }
    private async void SearchMessages()
    {
        await SpinnerObj.ShowAsync();
        DataLink_MES dl = new DataLink_MES();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        //lista de contactos
        List<DataModel> NListContacts = new List<DataModel>();
        NListContacts.Add(new DataModel
            {
                Nome = "Todos",
                Utilizador = "All",
                Id = -1,
                Avatar = "TD",
                Pic = null
            });
        foreach (var item in dl.db.Users)
        {
            NListContacts.Add(new DataModel
                {
                    Nome = item.name,
                    Utilizador = item.username,
                    Id = item.id,
                    Avatar = item.name.Substring(0, 1),
                    Pic = item.pic
                });
        }
        ListContacts = NListContacts;


        //recebidas
        var pmessagesG = from rt in dl.db.Mensagens
                         where rt.To == "All" || rt.To.Contains(who.username + ";")
                         orderby rt.Date descending
                         select new msg { Id = rt.Id, Mensagem = rt.Mensagem, Date = rt.Date, From = rt.From, To = rt.To, Lida = rt.Lida, ListaTo = new List<msgto>(), LidaPor = new List<msgto>() };
        var dadosG = await pmessagesG.ToListAsync();
        GMessages = dadosG.ToList();
        foreach (var itemG in GMessages)
        {
            itemG.pic = dl.db.Users.FirstOrDefault(x => x.username == itemG.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemG.From).pic : null;
            itemG.From = dl.db.Users.FirstOrDefault(x => x.username == itemG.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemG.From).name : itemG.From;
            itemG.Avatar = itemG.From.Substring(0, 1);
            if (itemG.Lida.Contains(who.username + ";"))
            {
                itemG.Lida = "Lida";
            }
            else
            {
                itemG.Lida = "";
            }
        }

        //enviadas
        var pmessagesS = from rt in dl.db.Mensagens
                         where rt.From == who.username
                         orderby rt.Date descending
                         select new msg { Id = rt.Id, Mensagem = rt.Mensagem, Date = rt.Date, From = rt.From, To = rt.To, Lida = rt.Lida, ListaTo = new List<msgto>(), LidaPor = new List<msgto>() };
        var dadosS = await pmessagesS.ToListAsync();
        SMessages = dadosS.ToList();
        foreach (var item in SMessages)
        {
            if (item.To == "All")
            {
                item.pic = null;
                item.Avatar = "TD";
                msgto nnms = new msgto();
                nnms.nome = "Todos";
                nnms.pic = null;
                nnms.user = "All";

                item.ListaTo.Add(nnms);
            }
            else
            {
                foreach (string itemus in item.To.Split(";"))
                {
                    if (itemus != null && itemus != "")
                    {
                        msgto nnms = new msgto();
                        nnms.nome = dl.db.Users.FirstOrDefault(x => x.username == itemus) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemus).name : itemus;
                        nnms.pic = dl.db.Users.FirstOrDefault(x => x.username == itemus) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemus).pic : null;
                        nnms.user = itemus;
                        item.ListaTo.Add(nnms);
                    }
                }
            }


            if (item.Lida != "")
            {
                item.Lida = "Lida";
            }
        }

        StateHasChanged();
        await SpinnerObj.HideAsync();
        dl.Dispose();
    }


    //NEW + EDIT
    private bool PopupNewMessage = false;
    private bool PopupEditMessage = false;
    private int idMessage = 0;
    public msg selmessage = new msg() { };
    private async void novomessage()
    {
        //await SfListBoxNew.SelectItems(SfListBoxNew.Value, false);
        //await SfListBoxEdit.SelectItems(SfListBoxEdit.Value, false);
        SelUsers = new string[] { };
        PopupNewMessage = true;
    }
    private async void editmessage(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_MES dl = new DataLink_MES();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.Mensagens.First(x => x.Id == id);
        msg n = new msg() { Date = doc.Date, From = doc.From, Lida = doc.Lida, Mensagem = doc.Mensagem, To = doc.To, Id = doc.Id, LidaPor = new List<msgto>() };

        n.pic = dl.db.Users.FirstOrDefault(x => x.username == n.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == n.From).pic : null;
        n.From = dl.db.Users.FirstOrDefault(x => x.username == n.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == n.From).name : n.From;
        n.Avatar = n.From.Substring(0, 1);
        //await SfListBoxEdit.SelectItems(SfListBoxEdit.Value, false);
        //await SfListBoxNew.SelectItems(SfListBoxNew.Value, false);
        SelUsers = n.To.Split(";");

        if (n.Lida != "")
        {
            foreach (string itemus in n.Lida.Split(";"))
            {
                if (itemus != null && itemus != "")
                {
                    msgto nnms = new msgto();
                    nnms.nome = dl.db.Users.FirstOrDefault(x => x.username == itemus) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemus).name : itemus;
                    nnms.pic = dl.db.Users.FirstOrDefault(x => x.username == itemus) != null ? dl.db.Users.FirstOrDefault(x => x.username == itemus).pic : null;
                    nnms.user = itemus;
                    n.LidaPor.Add(nnms);
                }
            }
            n.Lida = "Lida";
        }
        else
        {
            n.Lida = "";
            msgto nnms = new msgto();
            nnms.nome = "";
            nnms.pic = null;
            nnms.user = "";
            n.LidaPor.Add(nnms);
        }

        selmessage = n;
        idMessage = selmessage.Id;

        PopupEditMessage = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }
    private async void Add_Message(int id)
    {
        if (selmessage.Mensagem != null && selmessage.Mensagem != "")
        {
            await SpinnerObj.ShowAsync();
            DataLink_MES dl = new DataLink_MES();

            selmessage.To = "";
            foreach (var item in SelUsers)
            {
                if (item != "All")
                {
                    if (item != "")
                    {
                        selmessage.To = selmessage.To + item + ";";
                    }
                }
                else
                {
                    selmessage.To = item;
                    break;
                }
            }

            if (id == 0)
            {
                dl.db.Mensagens.Add(new f10.pulsar.mes.data.Mensagens { From = who.username, Mensagem = selmessage.Mensagem, Date = DateTime.Now, Lida = "", To = selmessage.To });
                await dl.db.SaveChangesAsync();
                utils.UserLog($"Enviou uma mensagem ao(s) utilizador(es) '{selmessage.To}'", "DataLink_MES");
            }
            else
            {
                dl.db.Mensagens.First(x => x.Id == id).To = selmessage.To;
                if (dl.db.Mensagens.First(x => x.Id == id).Mensagem != selmessage.Mensagem)
                {
                    dl.db.Mensagens.First(x => x.Id == id).Mensagem = selmessage.Mensagem;
                    dl.db.Mensagens.First(x => x.Id == id).Lida = "";
                }
                dl.db.Mensagens.First(x => x.Id == id).Date = DateTime.Now;

                await dl.db.SaveChangesAsync();
                utils.UserLog($"Alterou a mensagem com o id '{selmessage.Id}'", "DataLink_MES");
            }

            PopupNewMessage = false;
            PopupEditMessage = false;
            PopupReadMessage = false;
            PopupDelMessage = false;
            selmessage = new msg() { };
            idMessage = 0;

            SearchMessages();
            await SpinnerObj.HideAsync();
            StateHasChanged();
            dl.Dispose();
        }
    }

    //READ
    private bool PopupReadMessage = false;
    private async void readmessage(int id)
    {
        await SpinnerObj.ShowAsync();
        DataLink_MES dl = new DataLink_MES();
        dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        var doc = dl.db.Mensagens.First(x => x.Id == id);
        msg n = new msg() { Date = doc.Date, From = doc.From, Lida = doc.Lida, Mensagem = doc.Mensagem, To = doc.To, Id = doc.Id, LidaPor = new List<msgto>() };

        n.pic = dl.db.Users.FirstOrDefault(x => x.username == n.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == n.From).pic : null;
        n.From = dl.db.Users.FirstOrDefault(x => x.username == n.From) != null ? dl.db.Users.FirstOrDefault(x => x.username == n.From).name : n.From;
        n.Avatar = n.From.Substring(0, 1);
        selmessage = n;
        idMessage = selmessage.Id;

        PopupReadMessage = true;

        await SpinnerObj.HideAsync();
        StateHasChanged();
        dl.Dispose();
    }
    private async void Mensagem_Lida(int id)
    {
        if (selmessage.Id != 0)
        {
            await SpinnerObj.ShowAsync();
            DataLink_MES dl = new DataLink_MES();

            if (selmessage.Lida.Contains(who.username) != true)
            {
                dl.db.Mensagens.First(x => x.Id == id).Lida = dl.db.Mensagens.First(x => x.Id == id).Lida + who.username + ";";

                await dl.db.SaveChangesAsync();
                utils.UserLog($"Leu a mensagem '{selmessage.Id}'", "DataLink_MES");
                SearchMessages();
            }
            PopupNewMessage = false;
            PopupEditMessage = false;
            PopupReadMessage = false;
            PopupDelMessage = false;
            selmessage = new msg() { };
            idMessage = 0;

            await SpinnerObj.HideAsync();
            StateHasChanged();
            dl.Dispose();
        }
    }

    //DELETE
    private bool PopupDelMessage = false;
    private async void Del_Message(int id)
    {
        if (id != null)
        {
            await SpinnerObj.ShowAsync();
            DataLink_MES dl = new DataLink_MES();

            dl.db.Mensagens.Remove(dl.db.Mensagens.First(x => x.Id == id));
            await dl.db.SaveChangesAsync();
            utils.UserLog($"Eliminou a mensagem {selmessage.Id}", "DataLink_MES");

            PopupDelMessage = false;
            PopupEditMessage = false;
            PopupNewMessage = false;
            PopupReadMessage = false;
            selmessage = new msg() { };
            idMessage = 0;

            await SpinnerObj.HideAsync();
            SearchMessages();
            StateHasChanged();
            dl.Dispose();
        }
    }



