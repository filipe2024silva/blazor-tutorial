@page "/settings"
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Spinner
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Utils utils
@inject ThemeState _themeState

<!-- Main -->
<div id="main">
    <div class="inner">

        @if (dbchecked == false)
        {
            <div class="row uniform" style="margin-top:20px">
                <div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
                    <div class="card text-dark bg-light">
                        <div class="card-body">
                            @if (dbcheckedoff == false)
                            {
                                <div>
                                    <div class="bounceball"></div>
                                    <div class="bounceballtext">A verificar ligação à base de dados</div>
                                </div>
                            }
                            else
                            {
                                <p style="margin:0;">Sem ligação à base de dados Geral.</p>
                                <a href="/" class="special button" style="margin-top:1em">Voltar</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="8u 12u$(medium)">
                    <h1>Configurações</h1>
                    @*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
                </div>
                <div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
                    <button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
                </div>
            </div>


            <div class="row">
                <div class="8u 12u$(medium)">
                    <div class="row" style="justify-content: left; margin:0.5em">
                        <img src="@picture(who.pic)" style="width:128px;height:128px;object-fit:cover;border-radius: 50%;border: 1px solid black;padding:0" />
                        <div>
                            <div style="display: flex; justify-content: left; margin:0.5em">
                                <p style="width:8em;margin:0;margin-top:10px;">Nome</p>
                                <SfTextBox Multiline="false" Placeholder="" @bind-Value="@who.name" style="margin-left:10px;padding:0"></SfTextBox>
                            </div>
                            <div style="display: flex; justify-content: left; margin:0.5em">
                                <p style="width:8em;margin:0;margin-top:10px;">Email</p>
                                <SfTextBox Multiline="false" Placeholder="" @bind-Value="@who.email" style="margin-left:10px;padding:0"></SfTextBox>
                            </div>
                            <button class="button small special pull-left" @onclick="@(()=> { Save(); })" style="margin:10px">Guardar</button>
                        </div>
                    </div>
                </div>
                <div class="4u 12u$(medium)">
                    <div class="row" style="justify-content: left; margin:0.5em">
                        <p style="width:11em;margin:0;padding:0">Notificações Sonoras</p>
                        <SfSwitch @bind-Checked="Sound" style="margin-top:0.5em" ValueChange="SoundChange" TChecked="bool"></SfSwitch>
                    </div>
                    <div class="row" style="justify-content: left; margin:0.5em">
                        <p style="width:11em;margin:0;padding:0">Notificações de Alarme</p>
                        <SfSwitch @bind-Checked="Alarmes" style="margin-top:0.5em" ValueChange="AlarmeChange" TChecked="bool"></SfSwitch>
                    </div>
                    <div class="row" style="justify-content: left; margin:0.5em">
                        <p style="width:11em;margin:0;padding:0">Tema Escuro</p>
                        <SfSwitch @bind-Checked="DarkTheme" style="margin-top:0.5em" ValueChange="TemaChange" TChecked="bool"></SfSwitch>
                    </div>
                </div>
            </div>
        }


        @*LOADING*@
        <SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>

    </div>
</div>


@code {
    SfSpinner SpinnerObj = new SfSpinner();
    User who = new User();

    bool dbchecked = false, dbcheckedoff = false;
    private bool Sound;
    private bool Alarmes;
    private bool DarkTheme;


    protected override void OnInitialized()
    {
        who = (User)utils.f10session["user"];
        base.OnInitialized();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == true)
        {
            GetDB();
        }
        base.OnAfterRender(firstRender);
    }
    private async void GetDB()
    {
        DataLink_MES dlm = new DataLink_MES();

        if (await dlm.db.Database.CanConnectAsync())
        {
            utils.MESON = true;
            dbchecked = true;
            dbcheckedoff = false;
            dlm.Dispose();
            StateHasChanged();
            SearchSettings();
        }
        else
        {
            utils.MESON = false;
            dbchecked = false;
            dbcheckedoff = true;
            dlm.Dispose();
            StateHasChanged();
        }
    }
    private async void SearchSettings()
    {
        await SpinnerObj.ShowAsync();
        DataLink_MES dl = new DataLink_MES();

        //SOM
        var qq = dl.db.Settings.FirstOrDefault(x => x.userid == who.id && x.setting == "sound");
        if (qq != null)
        {
            Sound = Convert.ToBoolean(qq.result);
        }
        else
        {
            Sound = true;
            dl.db.Settings.Add(new f10.pulsar.mes.data.Settings { userid = who.id, setting = "sound", result = Sound.ToString() });
            await dl.db.SaveChangesAsync();
        }

        //ALARMES
        var al = dl.db.Settings.FirstOrDefault(x => x.userid == who.id && x.setting == "alarmes");
        if (al != null)
        {
            Alarmes = Convert.ToBoolean(al.result);
        }
        else
        {
            Alarmes = true;
            dl.db.Settings.Add(new f10.pulsar.mes.data.Settings { userid = who.id, setting = "alarmes", result = Alarmes.ToString() });
            await dl.db.SaveChangesAsync();
        }

        //TEMA
        var th = dl.db.Settings.FirstOrDefault(x => x.userid == who.id && x.setting == "darktheme");
        if (th != null)
        {
            DarkTheme = Convert.ToBoolean(th.result);
        }
        else
        {
            DarkTheme = false;
            dl.db.Settings.Add(new f10.pulsar.mes.data.Settings { userid = who.id, setting = "darktheme", result = DarkTheme.ToString() });
            await dl.db.SaveChangesAsync();
        }

        StateHasChanged();
        await SpinnerObj.HideAsync();
        dl.Dispose();
    }

    //GUARDAR
    private async void Save()
    {
        await SpinnerObj.ShowAsync();
        DataLink_MES dl = new DataLink_MES();

        dl.db.Users.First(x => x.id == who.id).name = who.name;
        dl.db.Users.First(x => x.id == who.id).email = who.email;
        await dl.db.SaveChangesAsync();

        dl.Dispose();
        StateHasChanged();
        await SpinnerObj.HideAsync();
        SearchSettings();
    }
    private async void SoundChange(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        DataLink_MES dl = new DataLink_MES();

        dl.db.Settings.First(x => x.userid == who.id && x.setting == "sound").result = Sound.ToString();
        await dl.db.SaveChangesAsync();

        dl.Dispose();
    }
    private async void AlarmeChange(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        DataLink_MES dl = new DataLink_MES();

        dl.db.Settings.First(x => x.userid == who.id && x.setting == "alarmes").result = Alarmes.ToString();
        await dl.db.SaveChangesAsync();

        dl.Dispose();
    }
    private async void TemaChange(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        DataLink_MES dl = new DataLink_MES();

        dl.db.Settings.First(x => x.userid == who.id && x.setting == "darktheme").result = DarkTheme.ToString();
        await dl.db.SaveChangesAsync();

        dl.Dispose();

        utils.DarkTheme = DarkTheme;
        _themeState.TriggerThemeChange();//atualizar tema no mainLayout
        StateHasChanged();
    }


    private string picture(Byte[] pic)
    {
        if (pic != null)
        {
            return "data:image/png;base64," + Convert.ToBase64String(pic);
        }
        else
        {
            return "data:image/png;base64,";
        }
    }


    private void BackStreetButton()
    {
        NavigationManager.NavigateTo("/");
    }

}


