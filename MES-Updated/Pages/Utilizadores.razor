@page "/utilizadores"
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Navigations
@using Microsoft.EntityFrameworkCore
@using System.Diagnostics
@using f10.pulsar.mes.data
@inject NavigationManager NavigationManager
@inject Utils utils
@inject IJSRuntime JS
<!-- Main -->
<div id="main">
	<div class="inner">

		@if (dbchecked == false)
		{
			<div class="row uniform" style="margin-top:20px">
				<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
					<div class="card text-dark bg-light">
						<div class="card-body">
							@if (dbcheckedoff == false)
							{
								<div>
									<div class="bounceball"></div>
									<div class="bounceballtext">A verificar ligação à base de dados</div>
								</div>
							}
							else
							{
								<p style="margin:0;">Sem ligação à base de dados Geral.</p>
								<a href="/" class="special button" style="margin-top:1em">Voltar</a>
							}
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			@if (utils.CanAccess("U") == true)
			{
				<div class="row">
					<div class="8u 12u$(medium)">
						<h1>Gestão de Utilizadores</h1>
						@*<span class="image main"><img src="images/pic13.jpg" alt="" /></span>*@
					</div>
					<div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;">
						<button class="noprint" @onclick="BackStreetButton" title="Voltar atrás"><i class="icon style1 fa-arrow-left"></i></button>
						<button @onclick="@(() => { PopupNewUser = true;  access_all = true; Load_Permissions(0); })" title="Adicionar Utilizador"><i class="icon style1 fa-plus"></i></button>
					</div>
				</div>

				@if (Users != null && Users.Count > 0)
				{
					@*TABELA*@
					<div>
						<SfGrid @ref="@Grid" DataSource="@Users" AllowFiltering="true" AllowSorting="true" AllowGrouping="true">
							<GridColumns>
								<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="50">
									<Template>
										@{
											var whois = (context as User);
											<div style="display: flex; justify-content: space-between;">
												<p @onclick="@(() => { edituser(whois.id); })" class="icon style1 fa-edit" style="margin:0.3em;cursor:pointer"><span class="label">Editar</span></p>
											</div>
										}
									</Template>
								</GridColumn>
								<GridColumn HeaderText="" TextAlign="TextAlign.Left" Width="100">
									<Template>
										@{
											var whois = (context as User);
											<div style="display: flex; justify-content: space-between;">
												<img src="@picture(whois.pic)" style="width:64px;height:64px;object-fit:cover;border-radius: 50%;border: 1px solid black;" />
											</div>
										}
									</Template>
								</GridColumn>
								<GridColumn Field="name" HeaderText="Nome"></GridColumn>
								<GridColumn Field="email" HeaderText="Email" HideAtMedia="(min-width: 700px)"></GridColumn>
							</GridColumns>
						</SfGrid>
					</div>
				}
				else
				{
					<div class="row uniform" style="margin-top:20px">
						<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
							<div class="card text-dark bg-light">
								<div class="card-body">
									<p style="margin:0;">Sem utilizadores registados.</p>
								</div>
							</div>
						</div>
					</div>
				}


				@*ADICIONAR*@
				<SfDialog Target="#target" Width="800px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupNewUser">
					<DialogTemplates>
						<Header>Gerir Utilizador</Header>
						<Content>
							<SfTab>
								<TabItems>
									<TabItem>
										<ChildContent>
											<TabHeader Text="Utilizador"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
												<div class="6u 12u$(medium)">
													<div class="centercontent">
														<img src="@picture(seluser.pic)" style="width:128px; height:128px;object-fit:cover;border-radius: 50%;border: 1px solid black;" />
													</div>
													<div class="centercontent" style="margin-top:1em;margin-bottom:1em">
														<SfUploader AllowMultiple="false" AllowedExtensions=".png, .gif, .jpeg, .jpg">
															<UploaderEvents ValueChange="OnChange" OnRemove="onRemove"></UploaderEvents>
														</SfUploader>
													</div>
												</div>
												<div class="6u 12u$(medium)">
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Nome</p>
														<SfTextBox Multiline="false" Placeholder="" @bind-Value="@seluser.name" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Email</p>
														<SfTextBox Multiline="false" Type=InputType.Email @bind-Value="@seluser.email" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Username</p>
														<SfTextBox Multiline="false" Placeholder="" @bind-Value="@seluser.username" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:6em;margin:0;margin-top:10px;">Password</p>
														<SfTextBox Multiline="false" Width="60%" Type=InputType.Password @bind-Value="@seluser.password" style="margin-left:10px;padding:0"></SfTextBox>
														<button style="width:10em;margin-left:10px;padding:0;letter-spacing:unset" @onclick="@(() => { seluser.password = Utils.GeneratePass(); })">Gerar Pass</button>
													</div>
													<div style="display: flex; justify-content: center; margin:0.5em">
														<p style="margin-top:10px;color:red">@Erromsg</p>
													</div>
												</div>
											</div>
										</ContentTemplate>
									</TabItem>
									<TabItem>
										<ChildContent>
											<TabHeader Text="Acessos"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
												<SfTreeView TValue="Paccess" ShowCheckBox="true" AutoCheck="true">
													<TreeViewEvents TValue="Paccess" NodeClicked="NodeClick"></TreeViewEvents>
													<TreeViewFieldsSettings TValue="Paccess" Id="id" DataSource="@permissions" Text="name" ParentID="parent" HasChildren="haschildren" Expanded="expanded" IsChecked="ischecked"></TreeViewFieldsSettings>
												</SfTreeView>
											</div>
										</ContentTemplate>
									</TabItem>
								</TabItems>
							</SfTab>
							<button class="button special pull-right" @onclick="@(() => { Add_User(0); })" style="margin:10px">Guardar</button>
							<button class="button pull-right" @onclick="@(() => { PopupNewUser = false; idUser = 0; inuser = new byte[1]; seluser = new User() { }; })" style="margin:10px">Cancelar</button>
						</Content>
					</DialogTemplates>

				</SfDialog>
				@*EDITAR*@
				<SfDialog Target="#target" Width="800px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupEditUser">
					<DialogTemplates>
						<Header>Gerir Utilizadores</Header>
						<Content>
							<SfTab>
								<TabItems>
									<TabItem>
										<ChildContent>
											<TabHeader Text="Utilizador"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
												<div class="6u 12u$(medium)">
													<div class="centercontent">
														<img src="@picture(seluser.pic)" style="width:128px; height:128px;object-fit:cover;border-radius: 50%;border: 1px solid black;" />
														<i @onclick="@(() => { seluser.pic = null; })" class="icon style1 fa-remove smallbot" style="flex-direction: unset;"></i>
													</div>
													<div class="centercontent" style="margin-top:1em;margin-bottom:1em">
														<SfUploader AllowMultiple="false" AllowedExtensions=".png, .gif, .jpeg, .jpg">
															<UploaderEvents ValueChange="OnChange" OnRemove="onRemove"></UploaderEvents>
														</SfUploader>
													</div>
												</div>

												<div class="6u 12u$(medium)">
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em; margin-top:10px;">Nome</p>
														<SfTextBox Multiline="false" @bind-Value="@seluser.name" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Email</p>
														<SfTextBox Multiline="false" Type=InputType.Email @bind-Value="@seluser.email" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Username</p>
														<SfTextBox Multiline="false" @bind-Value="@seluser.username" style="margin-left:10px;padding:0"></SfTextBox>
													</div>
													<div style="display: flex; justify-content: left; margin:0.5em">
														<p style="width:8em;margin:0;margin-top:10px;">Password</p>
														@*<p style="width:10em;margin:0;margin-top:10px;margin-left:10px">@seluser.password</p> *@
														<SfTextBox Multiline="false" Width="60%" Type=InputType.Password @bind-Value="@seluser.password" style="margin-left:10px;padding:0"></SfTextBox>
														<button style="width:10em;margin-left:10px;padding:0;letter-spacing:unset" @onclick="@(() => { seluser.password = Utils.GeneratePass(); })">Gerar Pass</button>
													</div>
													<div style="display: flex; justify-content: center; margin:0.5em">
														<p style="margin-top:10px;color:red">@Erromsg</p>
													</div>
												</div>
											</div>
										</ContentTemplate>
									</TabItem>

									<TabItem>
										<ChildContent>
											<TabHeader Text="Acessos"></TabHeader>
										</ChildContent>
										<ContentTemplate>
											<div class="row" style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
												<SfTreeView TValue="Paccess" ShowCheckBox="true" AutoCheck="false">
													<TreeViewEvents TValue="Paccess" NodeClicked="NodeClick"></TreeViewEvents>
													<TreeViewFieldsSettings TValue="Paccess" Id="id" DataSource="@permissions" Text="name" ParentID="parent" HasChildren="haschildren" Expanded="expanded" IsChecked="ischecked"></TreeViewFieldsSettings>
												</SfTreeView>
											</div>



										</ContentTemplate>
									</TabItem>
								</TabItems>
							</SfTab>
							<SfButton class="button special pull-left" @onclick="@(() => { PopupDelUser = true; })" style="margin:10px">Eliminar</SfButton>
							<SfButton class="button special pull-right" @onclick="@(() => { Add_User(idUser); })" style="margin:10px">Guardar</SfButton>
							<SfButton class="button pull-right" @onclick="@(() => { PopupEditUser = false; idUser = 0; inuser = new byte[1]; seluser = new User() { }; })" style="margin:10px">Cancelar</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>
				<SfDialog Width="400px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupDelUser">
					<DialogTemplates>
						<Header>Eliminar Utilizador</Header>
						<Content>
							<p>
								A eliminação do utilizador é permanente.<br />
								Pretende realmente eliminar o utilizador?
							</p>
							<SfButton class="button special pull-right" @onclick="@(() => { Del_User(idUser); })" style="margin:10px">Sim</SfButton>
							<SfButton class="button pull-right" @onclick="@(() => { PopupDelUser = false; })" style="margin:10px">Não</SfButton>
						</Content>
					</DialogTemplates>
				</SfDialog>

			}
			else
			{
				<div class="row uniform" style="margin-top:20px">
					<div class="12u 12u$(medium)" style="display: flex;justify-content:space-between;flex-direction:column">
						<div class="card text-dark bg-light">
							<div class="card-body">
								<p style="margin:0;">Não tem permissões para aceder a esta funcionalidade.</p>
								<a href="/">Voltar</a>
							</div>
						</div>
					</div>
				</div>
			}
		}

		@*LOADING*@
		<SfSpinner @ref="SpinnerObj" Type="SpinnerType.Material"></SfSpinner>

	</div>
</div>


@code {

	SfGrid<User>? Grid;
	SfSpinner SpinnerObj = new SfSpinner();

	bool dbchecked = false, dbcheckedoff = false;
	public string Erromsg = "";
	public List<User> Users = new List<User>() { };
	private bool access_all = true;
	public List<Paccess> permissions = new List<Paccess>() { };


	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender == true)
		{
			GetDB();
		}
		base.OnAfterRender(firstRender);
	}
	private async void GetDB()
	{
		DataLink_MES dlm = new DataLink_MES();

		if (await dlm.db.Database.CanConnectAsync())
		{
			utils.MESON = true;
			dbchecked = true;
			dbcheckedoff = false;
			dlm.Dispose();
			StateHasChanged();
			SearchUsers();
		}
		else
		{
			utils.MESON = false;
			dbchecked = false;
			dbcheckedoff = true;
			dlm.Dispose();
			StateHasChanged();
		}
	}
	private async void SearchUsers()
	{
		await SpinnerObj.ShowAsync();
		DataLink_MES dl = new DataLink_MES();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		//TABELA
		var pusers = from rt in dl.db.Users select rt;
		var dados = await pusers.ToListAsync();
		Users = dados;

		StateHasChanged();
		await SpinnerObj.HideAsync();
		dl.Dispose();
	}

	private bool PopupNewUser = false;
	private bool PopupEditUser = false;
	private bool PopupDelUser = false;
	private int idUser = 0;
	public User seluser = new User() { };
	public byte[] inuser = new byte[1];
	private async void edituser(int id)
	{
		await SpinnerObj.ShowAsync();
		DataLink_MES dl = new DataLink_MES();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		var doc = dl.db.Users.First(x => x.id == id);
		User n = new User() { id = doc.id, name = doc.name, username = doc.username, pic = doc.pic, email = doc.email, password = "" };
		seluser = n;
		idUser = seluser.id;

		Load_Permissions(id);

		PopupEditUser = true;

		await SpinnerObj.HideAsync();
		StateHasChanged();
		dl.Dispose();
	}
	private async void Add_User(int id)
	{
		await SpinnerObj.ShowAsync();
		DataLink_MES dl = new DataLink_MES();

		string newpass = utils.Hash(seluser.password);
		//user
		if (id == 0)
		{
			if (seluser.password != "")
			{
				dl.db.Users.Add(new User { name = seluser.name, username = seluser.username, password = newpass, pic = inuser.Length == 1 ? null : inuser, email = seluser.email });
				await dl.db.SaveChangesAsync();
				utils.UserLog($"Inseriu o utilizador '{seluser.name}'", "DataLink_MES");
			}
			else
			{
				Erromsg = "Deve gerar uma Password!";
			}
		}
		else
		{
			dl.db.Users.First(x => x.id == id).name = seluser.name;
			dl.db.Users.First(x => x.id == id).username = seluser.username;
			dl.db.Users.First(x => x.id == id).email = seluser.email;
			if (seluser.password != "")
			{
				dl.db.Users.First(x => x.id == id).password = newpass;
			}
			dl.db.Users.First(x => x.id == id).pic = seluser.pic;

			await dl.db.SaveChangesAsync();
			utils.UserLog($"Editou o utilizador '{seluser.name}'", "DataLink_MES");
		}
		StateHasChanged();
		//permissões
		if (id == 0)
		{
			id = dl.db.Users.OrderBy(x => x.id).Last().id;
		}
		else
		{
			dl.db.Permissions.RemoveRange(dl.db.Permissions.Where(x => x.userid == id));
		}


		if (permissions.First(x => x.id == "All").ischecked == true)
		{
			dl.db.Permissions.Add(new Access { userid = id, accessto = "All", allowed = true });
		}
		else
		{
			foreach (Paccess item in permissions)
			{
				if (item.ischecked == true)
				{
					dl.db.Permissions.Add(new Access { userid = id, accessto = item.id, allowed = true });
				}
			}
		}
		await dl.db.SaveChangesAsync();


		PopupNewUser = false;
		PopupEditUser = false;
		seluser = new User() { };
		inuser = new byte[1];
		idUser = 0;

		await SpinnerObj.HideAsync();
		SearchUsers();
		StateHasChanged();
		dl.Dispose();
	}

	async void NodeClick(NodeClickEventArgs args)
	{
		foreach (Paccess p in permissions)
		{
			permissions.First(p => p.id == args.NodeData.Id).ischecked = bool.Parse(args.NodeData.IsChecked);
		}
	}

	private async Task OnChange(UploadChangeEventArgs args)
	{
		try
		{
			byte[] tempimg = new byte[Convert.ToInt32(args.Files[0].FileInfo.Size)];
			await args.Files[0].File.OpenReadStream(long.MaxValue).ReadAsync(tempimg, 0, Convert.ToInt32(args.Files[0].FileInfo.Size));
			inuser = tempimg;
			seluser.pic = inuser;
			StateHasChanged();
		}
		catch (Exception ex)
		{
			Debug.WriteLine($"Erro ao carregar foto de utilizador: {ex.Message}");
		}
	}

	private void onRemove(RemovingEventArgs args)
	{
		inuser = new byte[1];
		seluser.pic = null;
	}

	private async void Del_User(int id)
	{
		await SpinnerObj.ShowAsync();
		DataLink_MES dl = new DataLink_MES();

		dl.db.Users.Remove(dl.db.Users.First(x => x.id == id));
		dl.db.Permissions.RemoveRange(dl.db.Permissions.Where(x => x.userid == id));
		await dl.db.SaveChangesAsync();
		utils.UserLog($"Eliminou o utilizador '{seluser.name}'", "DataLink_MES");

		PopupNewUser = false;
		PopupEditUser = false;
		PopupDelUser = false;
		inuser = new byte[1];
		seluser = new User() { };
		idUser = 0;

		await SpinnerObj.HideAsync();
		SearchUsers();
		StateHasChanged();
		dl.Dispose();
	}

	private async void Load_Permissions(int id)
	{
		DataLink_MES dl = new DataLink_MES();
		dl.db.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

		permissions.Clear();

		//GERAL
		permissions.Add(new Paccess { id = "All", name = "Acesso Total", expanded = true, haschildren = true, ischecked = false });
		permissions.Add(new Paccess { id = "L1", name = "Linha 4", expanded = true, haschildren = true, ischecked = false, parent = "All" });
		permissions.Add(new Paccess { id = "G", name = "Geral", expanded = false, haschildren = false, ischecked = false, parent = "All" });
		permissions.Add(new Paccess { id = "U", name = "Gestão de Utilizadores", expanded = false, haschildren = false, ischecked = false, parent = "All" });
		permissions.Add(new Paccess { id = "E", name = "Gestão de Equipamentos", expanded = false, haschildren = false, ischecked = false, parent = "All" });
		permissions.Add(new Paccess { id = "C", name = "Gestão de Características", expanded = false, haschildren = false, ischecked = false, parent = "All" });
		permissions.Add(new Paccess { id = "B", name = "Gestão de Banhos", expanded = false, haschildren = false, ischecked = false, parent = "All" });

		//L1
		permissions.Add(new Paccess { id = "TTL1", name = "Tratamentos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "ATL1", name = "Artigos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "ATLA4", name = "Artigos - Avançada", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "TL1", name = "Temperaturas", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "RL1", name = "Rectificadores", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "RPL1", name = "Relatórios de Tratamento", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "OL1", name = "OEE", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "QL1", name = "Qualidade", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "PL1", name = "Produção", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "DL1", name = "Desempenho", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "DCL1", name = "Documentos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "EL1", name = "Registo de Eventos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "ML1", name = "Manutenção", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "AL1", name = "Alarmes", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "EQL1", name = "Gestão de Equipamentos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "DSL1", name = "Dosagens", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "GCDSL1", name = "Gestão de Compostos", expanded = false, haschildren = false, ischecked = false, parent = "DSL1" });
		//permissions.Add(new Paccess { id = "PEL1", name = "Gestão de Peças", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "RV4", name = "Registos de Valores", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "EVL1", name = "Registo de Eventos", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "UTL1", name = "Gestão de Utilizadores", expanded = false, haschildren = false, ischecked = false, parent = "L1" });
		permissions.Add(new Paccess { id = "BDL1", name = "Gestão da Base de Dados", expanded = false, haschildren = false, ischecked = false, parent = "L1" });


		if (id != 0)
		{
			var perms = await dl.db.Permissions.Where(x => x.userid == id).ToListAsync();
			foreach (Paccess item in permissions)
			{
				var p = perms.FirstOrDefault(x => x.accessto == item.id);
				if (p == null)
				{
					item.ischecked = false;
				}
				else
				{
					item.ischecked = p.allowed;
				}
			}
		}

		//newtab.SelectedItem = 0;
		//edittab.SelectedItem = 0;
		StateHasChanged();
		dl.Dispose();
	}

	private string picture(Byte[] pic)
	{
		if (pic != null)
		{
			return "data:image/png;base64," + Convert.ToBase64String(pic);
		}
		else
		{
			return "data:image/png;base64,";
		}
	}

