@using Syncfusion.Blazor.Popups
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Utils utils
@inject IJSRuntime JSRuntime
@inject ThemeState _themeState

<div id="wrapper" style="@btheme">

    <!-- Header -->
    <header id="header">
        <div class="inner">
            <div class="row">
                <div class="8u 12u$(medium) ">
                    <!-- LOGO -->
                    <a href="/" class="logo">
                        <span class="symbol"><img src="images/mesicon.jpg" alt="" /></span><span class="title">F10 - GESTÃO DA FÁBRICA</span>
                    </a>
                </div>
                <div class="4u 12u$(medium)" style="display: flex;justify-content:flex-end;height:32px;margin-bottom:2em;">
                    <!--USER -->
                    @if (who != null)
                    {
                        <img src="@picture(who.pic)" style="width:32px;height:32px;object-fit:cover;border-radius: 50%;border: 1px solid white;background-color:white;" />
                        <div style="display:flex;justify-content:center;flex-direction:column;margin-left:20px;margin-right:20px">
                            <h5 style="margin:0;letter-spacing:0.2em">@who.name</h5>
                        </div>
                        <div style="display:flex;justify-content:center;flex-direction:column;width:30px">
                            <i @onclick="@(()=> { NavigationManager.NavigateTo("settings"); })" class="icon style1 fa-cog smallbot"></i>
                        </div>
                        <div style="display:flex;justify-content:center;flex-direction:column;width:30px">
                            <i @onclick="@(()=> { logout(); })" class="icon style1 fa-sign-out smallbot"></i>
                        </div>
                    }
                </div>
            </div>


            <!-- Nav -->
            <nav>
                <ul>
                    <li><a href="#menu">Menu</a></li>
                </ul>
            </nav>

        </div>
    </header>
    <!-- Menu -->
    <nav id="menu">
        <h2>Menu</h2>
        <ul>
            <li><a href="/">HOME</a></li>
            <li><a href="">GERAL</a></li>
            <li><a href="linha4">LINHA 4</a></li>
            <li><a href="equipamentos">EQUIPAMENTOS</a></li>
            <li><a href="404">STOCKS</a></li>
        </ul>
    </nav>


    @if (utils.f10session.ContainsKey("user") == true)
    {
        @Body
    }

    <!-- Footer -->
    <footer id="footer" class="noprint" style="@ftheme">
        <div class="inner">
            <section>
                <h2>Pedido de suporte</h2>
                <form onsubmit="event.preventDefault(); validateMyForm();">
                    <div class="field half first">
                        <input type="text" name="name" id="name" placeholder="Nome" @bind-value="@nome" />
                    </div>
                    <div class="field half">
                        <input type="email" name="email" id="email" placeholder="Email" @bind-value="@email" />
                    </div>
                    <div class="field">
                        <textarea name="message" id="message" placeholder="Mensagem" @bind="@mensagem"></textarea>
                    </div>
                    <ul class="actions">
                        <li><input type="submit" value="Enviar" class="special" @onclick="sendmail" /></li>
                    </ul>
                </form>
            </section>
            <section>
                <h2>Atalhos</h2>
                <ul class="icons">
                    <li><a href="geral" class="button special"><span class="label">Geral</span></a></li>
                    <li><a href="equipamentos" class="button special" style="cursor:pointer;"><span class="label">Equips</span></a></li>
                    <li>
                        <a href="linha4" class="button special" style="cursor:pointer;">
                            @if (utils.L1ON == false)
                            {
                                <span style="color:red" class="label icon fa-warning"> L1</span>
                            }
                            else
                            {
                                <span class="label">L4</span>
                            }
                        </a>
                    </li>
                    <li><a href="utilizadores" class="button special" style="cursor:pointer;"><span class="label">Users</span></a></li>
                </ul>

            </section>
            <ul class="copyright">
                <li>Powered by <a href="http://www.fdecimal.com" target="_blank"> Formula Decimal</a></li>
            </ul>
        </div>
    </footer>

    @*POPUP*@
    <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupMailSend">
        <DialogTemplates>
            <Header>A enviar pedido...</Header>
        </DialogTemplates>
    </SfDialog>
    <SfDialog Target="#target" Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="PopupMail">
        <DialogTemplates>
            <Header>Pedido de Suporte</Header>
            <Content>
                <div style="margin-top:1em;margin-bottom:1em;max-height:300px;overflow:auto">
                    <div style="display: flex; justify-content: center; margin:0.5em">
                        <p style="margin-top:10px;">@PopupMessage</p>
                    </div>
                </div>
                <SfButton class="button pull-right" @onclick="@(()=> { PopupMail = false;})" style="margin:10px">OK</SfButton>
            </Content>
        </DialogTemplates>
    </SfDialog>

    @*MENSAGEM DE ERRO*@
    <SfDialog Width="500px" ShowCloseIcon="false" IsModal="true" @bind-Visible="@PopupError">
        <DialogTemplates>
            <Header>Erro de Ligação</Header>
            <Content>
                <p>
                    @errormsg
                </p>
                <SfButton class="button special pull-right" @onclick="@(()=> { PopupError=false; })" style="margin:10px">Ok</SfButton>
            </Content>
        </DialogTemplates>
    </SfDialog>

</div>

@code {
    User who = null;
    string btheme = "";
    string ftheme = "";
    string nome = "";
    string email = "";
    string mensagem = "";
    bool PopupMailSend = false;
    bool PopupMail = false;
    string PopupMessage = "";
    bool PopupError = false;
    string errormsg = "";

    protected override void OnInitialized()
    {
        _themeState.OnThemeChanged += ApplyTheme;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (utils.f10session.ContainsKey("user") != true)
        {
            NavigationManager.NavigateTo("login");
        }
        else
        {
            if (firstRender == true)
            {
                who = (User)utils.f10session["user"];

                ApplyTheme();
            }

        }
        base.OnAfterRender(firstRender);
    }


    private void logout()
    {
        utils.UserLog($"LOGOUT", "DataLink_MES");
        NavigationManager.NavigateTo("login");
    }

    private string picture(Byte[] pic)
    {
        if (pic != null)
        {
            return "data:image/png;base64," + Convert.ToBase64String(pic);
        }
        else
        {
            return "data:image/png;base64,";
        }
    }

    private async void sendmail()
    {
        PopupMailSend = true;
        Dictionary<string, string> from = new Dictionary<string, string>();
        from.Add("Pulsar MES", "pulsar@fdecimal.com");
        Dictionary<string, string> parato = new Dictionary<string, string>();
        parato.Add("Apoio F10", "apoio@fdecimal.com");

        if (nome != "" && email != "" && mensagem != "")
        {
            parato.Add(nome, email);

            #region EMAIL
            string body = @"
    <!DOCTYPE html PUBLIC '-//W3C//DTD XHTML 1.0 Transitional//EN' 'http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd'>
    <html xmlns='http://www.w3.org/1999/xhtml' xmlns:v='urn:schemas-microsoft-com:vml' xmlns:o='urn:schemas-microsoft-com:office:office'>
    <head>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Relatório de Tratamento</title>
    <style type='text/css'>
    /* ----- Custom Font Import ----- */
    @import url(https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic&subset=latin,latin-ext);

    /* ----- Text Styles ----- */
    table{
    font-family: 'Lato', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    font-smoothing: antialiased;
    -moz-font-smoothing: antialiased;
    }

