<h1 style="@EstiloRecebido">Componente Filho com estilo do pai</h1>
<h2>Data recebida do pai: @DataAtualRecebida.ToShortDateString()</h2>
<p style="@FonteRecebida">Texto com fonte recebida do pai</p>

@code {
	[CascadingParameter(Name ="Estilo")]
	public string? EstiloRecebido { get; set; }
	[CascadingParameter]
	public DateTime DataAtualRecebida { get; set; }
	[CascadingParameter(Name = "Fonte")]
	public string? FonteRecebida { get; set; }
}
